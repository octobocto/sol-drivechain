index 0000000..aa0b90d
--- /dev/null
+++ b/sol-drivechain-bmm/src/pairs.rs
@@ -0,0 +1,718 @@
+//! The published pairs. A bidder sends the Solana block hash and the payee of
+//! its bid to the validators, outside any transaction. A commitment h* counts
+//! only when a pair with SHA-256(block hash ‖ payee) = h* is known.
+
+use {
+    crate::{BmmView, Commitment},
+    std::{
+        collections::{BTreeMap, HashMap, HashSet},
+        fs,
+        io::{self, Write},
+        path::{Path, PathBuf},
+        sync::{Mutex, OnceLock},
+    },
+};
+
+/// The file in the ledger directory that keeps the pairs.
+pub const PAIRS_FILE: &str = "bmm-pairs";
+
+/// A store drops the pairs this many eCash blocks below the tip, the same
+/// window that the view reads at start.
+pub const PAIR_WINDOW: u64 = 4032;
+
+/// The pairs that the view cannot check yet, per eCash height.
+pub const MAX_UNCHECKED_PER_HEIGHT: usize = 16;
+
+/// The bank hash of a Solana block and the payee of its bid.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct Pair {
+    pub block: [u8; 32],
+    pub payee: [u8; 32],
+}
+
+impl Pair {
+    /// h* = SHA-256(block ‖ payee).
+    pub fn commitment(&self) -> Commitment {
+        solana_sha256_hasher::hashv(&[&self.block, &self.payee]).to_bytes()
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Publish {
+    New,
+    Known,
+    Refused(&'static str),
+}
+
+/// The pairs at each height, and the pairs that once matched a block of the
+/// active chain. An eCash reorg keeps such a pair, because the chain can come
+/// back to its block.
+#[derive(Default)]
+struct State {
+    by_height: BTreeMap<u64, Vec<Pair>>,
+    checked: HashSet<(u64, Pair)>,
+    generation: u64,
+    /// The view generation of the last `maintain`.
+    maintained: Option<u64>,
+}
+
+#[derive(Default)]
+struct Log {
+    path: Option<PathBuf>,
+    file: crate::Sink,
+    /// The lines in the file.
+    lines: usize,
+}
+
+/// The pairs that this validator received, per eCash height.
+#[derive(Default)]
+pub struct PairStore {
+    state: Mutex<State>,
+    /// The file. Only the RPC and the peer sync write it, and never under
+    /// the lock of `state`, which the replay thread takes.
+    log: Mutex<Log>,
+}
+
+/// The store that the RPC fills and the fork choice reads.
+pub fn pairs() -> &'static PairStore {
+    static PAIRS: OnceLock<PairStore> = OnceLock::new();
+    PAIRS.get_or_init(PairStore::default)
+}
+
+impl PairStore {
+    /// Reads the pairs file in `ledger`, and adds each new pair to it from
+    /// now on. A crash in a write can leave a part of the last line, and the
+    /// open drops that part.
+    pub fn open(&self, ledger: &Path) -> io::Result<()> {
+        let path = ledger.join(PAIRS_FILE);
+        let (by_height, checked) = match fs::read_to_string(&path) {
+            Ok(text) => parse(complete_lines(&text)),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                (BTreeMap::new(), HashSet::new())
+            }
+            Err(error) => return Err(error),
+        };
+        let mut log = self.log.lock().unwrap();
+        let (text, lines) = render(&by_height, &checked);
+        log.file = crate::Sink::File(crate::replace_file(&path, &text)?);
+        log.lines = lines;
+        log.path = Some(path);
+        let mut state = self.state.lock().unwrap();
+        state.by_height = by_height;
+        state.checked = checked;
+        state.generation = state.generation.wrapping_add(1);
+        Ok(())
+    }
+
+    /// Adds a pair for eCash height `height`. A pair for a block that the
+    /// view holds must match its commitment. A pair for the next block waits,
+    /// up to `MAX_UNCHECKED_PER_HEIGHT` per height.
+    pub fn publish(&self, height: u64, pair: Pair, view: &BmmView) -> io::Result<Publish> {
+        let Some((tip_height, _)) = view.tip() else {
+            return Ok(Publish::Refused("the eCash view is empty"));
+        };
+        if height > tip_height.saturating_add(1) {
+            return Ok(Publish::Refused("the height is above the next eCash block"));
+        }
+        if height.saturating_add(PAIR_WINDOW) < tip_height {
+            return Ok(Publish::Refused("the height is too old"));
+        }
+        let checked = match view.block_at(height) {
+            Some(block) if block.commitment == Some(pair.commitment()) => true,
+            Some(_) => return Ok(Publish::Refused("the pair does not match the commitment")),
+            None => false,
+        };
+        {
+            let mut state = self.state.lock().unwrap();
+            let State {
+                by_height,
+                checked: validated,
+                ..
+            } = &mut *state;
+            let at_height = by_height.entry(height).or_default();
+            if at_height.contains(&pair) && (!checked || validated.contains(&(height, pair))) {
+                return Ok(Publish::Known);
+            }
+            if checked {
+                at_height.retain(|other| {
+                    other.commitment() == pair.commitment() || validated.contains(&(height, *other))
+                });
+                validated.insert((height, pair));
+            } else if at_height
+                .iter()
+                .filter(|other| !validated.contains(&(height, **other)))
+                .count()
+                >= MAX_UNCHECKED_PER_HEIGHT
+            {
+                return Ok(Publish::Refused("too many pairs wait at this height"));
+            }
+            if !at_height.contains(&pair) {
+                at_height.push(pair);
+                at_height.sort();
+            }
+            let floor = tip_height.saturating_sub(PAIR_WINDOW);
+            state.by_height = state.by_height.split_off(&floor);
+            state.checked.retain(|(at, _)| *at >= floor);
+            state.generation = state.generation.wrapping_add(1);
+        }
+        self.append(&[(height, pair, checked)])?;
+        Ok(Publish::New)
+    }
+
+    fn append(&self, entries: &[(u64, Pair, bool)]) -> io::Result<()> {
+        if entries.is_empty() {
+            return Ok(());
+        }
+        let text: String = entries
+            .iter()
+            .map(|(height, pair, checked)| line(*height, pair, *checked))
+            .collect();
+        let mut log = self.log.lock().unwrap();
+        crate::append_or_roll_back(&mut log.file, text.as_bytes(), |file, bytes| {
+            file.write_all(bytes)
+        })?;
+        log.lines = log.lines.saturating_add(entries.len());
+        Ok(())
+    }
+
+    /// Drops the pairs that wait at a height whose block does not match
+    /// them, and the pairs below the window. A pair that once matched stays
+    /// through an eCash reorg. Writes the file again when it holds many
+    /// dropped pairs.
+    pub fn maintain(&self, view: &BmmView) -> io::Result<()> {
+        let generation = view.generation();
+        let Some((tip_height, _)) = view.tip() else {
+            return Ok(());
+        };
+        let heights: Vec<u64> = {
+            let state = self.state.lock().unwrap();
+            if state.maintained == Some(generation) {
+                return Ok(());
+            }
+            state.by_height.keys().copied().collect()
+        };
+        let held: HashMap<u64, Option<Commitment>> = heights
+            .into_iter()
+            .filter_map(|height| Some((height, view.block_at(height)?.commitment)))
+            .collect();
+        let newly_checked = {
+            let mut state = self.state.lock().unwrap();
+            state.maintained = Some(generation);
+            let floor = tip_height.saturating_sub(PAIR_WINDOW);
+            state.by_height = state.by_height.split_off(&floor);
+            state.checked.retain(|(at, _)| *at >= floor);
+            let State {
+                by_height, checked, ..
+            } = &mut *state;
+            let mut changed = false;
+            let mut newly_checked = Vec::new();
+            for (height, at_height) in by_height.iter_mut() {
+                let Some(commitment) = held.get(height) else {
+                    continue;
+                };
+                let before = at_height.len();
+                at_height.retain(|pair| {
+                    if *commitment == Some(pair.commitment()) {
+                        if checked.insert((*height, *pair)) {
+                            newly_checked.push((*height, *pair, true));
+                        }
+                        true
+                    } else {
+                        checked.contains(&(*height, *pair))
+                    }
+                });
+                changed |= at_height.len() != before;
+            }
+            by_height.retain(|_, at_height| !at_height.is_empty());
+            if changed {
+                state.generation = state.generation.wrapping_add(1);
+            }
+            newly_checked
+        };
+        self.append(&newly_checked)?;
+        // The log lock comes first, so no publish can append between the
+        // snapshot and the rewrite.
+        let mut log = self.log.lock().unwrap();
+        let (snapshot, checked) = {
+            let state = self.state.lock().unwrap();
+            (state.by_height.clone(), state.checked.clone())
+        };
+        let count: usize = snapshot.values().map(Vec::len).sum();
+        if log.lines
+            <= count
+                .saturating_mul(2)
+                .saturating_add(MAX_UNCHECKED_PER_HEIGHT * 64)
+        {
+            return Ok(());
+        }
+        let Some(path) = log.path.clone() else {
+            return Ok(());
+        };
+        let (text, lines) = render(&snapshot, &checked);
+        log.file = crate::Sink::File(crate::replace_file(&path, &text)?);
+        log.lines = lines;
+        Ok(())
+    }
+
+    /// The pair at `height` whose hash is `commitment`.
+    pub fn find(&self, height: u64, commitment: &Commitment) -> Option<Pair> {
+        let state = self.state.lock().unwrap();
+        state
+            .by_height
+            .get(&height)?
+            .iter()
+            .find(|pair| &pair.commitment() == commitment)
+            .copied()
+    }
+
+    /// Every pair at or above `height`, from low to high, at most `limit`.
+    pub fn from_height_limited(&self, height: u64, limit: usize) -> Vec<(u64, Pair)> {
+        let state = self.state.lock().unwrap();
+        state
+            .by_height
+            .range(height..)
+            .flat_map(|(height, pairs)| pairs.iter().map(move |pair| (*height, *pair)))
+            .take(limit)
+            .collect()
+    }
+
+    /// Every pair at or above `height`, from low to high.
+    pub fn from_height(&self, height: u64) -> Vec<(u64, Pair)> {
+        self.from_height_limited(height, usize::MAX)
+    }
+
+    /// A number that changes at each new pair.
+    pub fn generation(&self) -> u64 {
+        self.state.lock().unwrap().generation
+    }
+}
+
+fn line(height: u64, pair: &Pair, checked: bool) -> String {
+    format!(
+        "pair {height} {} {}{}\n",
+        crate::fork_choice::to_hex(&pair.block),
+        crate::fork_choice::to_hex(&pair.payee),
+        if checked { " checked" } else { "" }
+    )
+}
+
+/// The text up to the last line end.
+fn complete_lines(text: &str) -> &str {
+    text.rfind('\n').map_or("", |end| &text[..=end])
+}
+
+/// The text of the file, and its line count.
+fn render(
+    by_height: &BTreeMap<u64, Vec<Pair>>,
+    checked: &HashSet<(u64, Pair)>,
+) -> (Vec<u8>, usize) {
+    let mut text = String::new();
+    let mut lines = 0usize;
+    for (height, pairs) in by_height {
+        for pair in pairs {
+            text.push_str(&line(*height, pair, checked.contains(&(*height, *pair))));
+            lines = lines.saturating_add(1);
+        }
+    }
+    (text.into_bytes(), lines)
+}
+
+type Parsed = (BTreeMap<u64, Vec<Pair>>, HashSet<(u64, Pair)>);
+
+/// A pair comes again from the peers, so a bad line is dropped.
+fn parse(text: &str) -> Parsed {
+    let mut by_height: BTreeMap<u64, Vec<Pair>> = BTreeMap::new();
+    let mut checked = HashSet::new();
+    for (height, pair, is_checked) in text.lines().filter_map(parse_line) {
+        let at_height = by_height.entry(height).or_default();
+        if !at_height.contains(&pair) {
+            at_height.push(pair);
+            at_height.sort();
+        }
+        if is_checked {
+            checked.insert((height, pair));
+        }
+    }
+    (by_height, checked)
+}
+
+fn parse_line(line: &str) -> Option<(u64, Pair, bool)> {
+    let words: Vec<&str> = line.split_whitespace().collect();
+    let (height, block, payee, is_checked) = match words.as_slice() {
+        ["pair", height, block, payee] => (height, block, payee, false),
+        ["pair", height, block, payee, "checked"] => (height, block, payee, true),
+        _ => return None,
+    };
+    Some((
+        height.parse().ok()?,
+        Pair {
+            block: crate::fork_choice::from_hex(block)?,
+            payee: crate::fork_choice::from_hex(payee)?,
+        },
+        is_checked,
+    ))
+}
