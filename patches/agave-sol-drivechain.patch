+    fn check_ancestor_checkpoint(
+        credited_height: u64,
+        credited_block: BlockHash,
+        rejection: Rejection,
+    ) {
+        let banks = tree(&[(96, 0)]);
+        let saved = saved(&[anchor(100, 32)], &[], 0);
+        let ancestors = [
+            RecordedBlock {
+                slot: 32,
+                bank_hash: hash(32),
+                credited_height: 90,
+                credited_block: block(90),
+                part_block: [0; 32],
+            },
+            RecordedBlock {
+                slot: 64,
+                bank_hash: hash(64),
+                credited_height,
+                credited_block,
+                part_block: [0; 32],
+            },
+        ];
+        let mut checkpoints = vec![
+            checkpoint(100, 32),
+            checkpoint(198, 128),
+            checkpoint(199, 160),
+        ];
+        let expected = Some(Restart {
+            anchor: anchor(100, 32),
+            trigger_height: 199,
+        });
+        for attack in [false, true] {
+            if attack {
+                checkpoints.push(checkpoint(201, 64));
+            }
+            let screened = screen_root(&checkpoints, &ancestors, &saved);
+            let vouched = vouched_by_staked(&screened.absent, |_| vec![node(1)], &saved, 206);
+            let mut choice = choose(96, &banks, &screened.counted, 206, PARAMS);
+            let pending: Vec<_> = screened
+                .pending
+                .iter()
+                .copied()
+                .chain(vouched.iter().map(|checkpoint| checkpoint.height))
+                .collect();
+            choice.fallback &= !pending_stops_fallback(&pending, 206, PARAMS);
+            assert!(choice.fallback);
+            let candidates: Vec<_> = screened
+                .counted
+                .iter()
+                .chain(vouched.iter())
+                .copied()
+                .collect();
+            assert_eq!(
+                restart(
+                    96,
+                    &banks,
+                    &candidates,
+                    206,
+                    &saved,
+                    &ancestors,
+                    200,
+                    PARAMS
+                ),
+                expected
+            );
+            if attack {
+                assert_eq!(screened.rejected, vec![(checkpoint(201, 64), rejection)]);
+            }
+        }
+        assert_eq!(
+            record_answer(&ancestors[1], 100, 201, |height| Some(block(height))),
+            Some(RecordAnswer {
+                credited_height,
+                credits_active: false,
+            })
+        );
+    }
