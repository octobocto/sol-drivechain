--- /dev/null
+++ b/runtime/src/bank/bmm.rs
@@ -0,0 +1,79 @@
+//! sol-drivechain: the settle pre-check.
+//!
+//! `settle_bmm(H, M)` pays the winner of eCash block M at height H. Each
+//! validator asks its own enforcer before the tx runs, and it gives the
+//! answer to the bridge in the `BmmAnswer` account.
+
+use {
+    super::Bank,
+    sol_drivechain_bmm::{
+        BMM_ANSWER_ID, REPLAY_WAIT, answer_data, confirmations, settle_bmm_question, view,
+    },
+    solana_account::{Account, AccountSharedData},
+    solana_runtime_transaction::transaction_with_meta::TransactionWithMeta,
+    solana_svm::account_loader::TransactionCheckResult,
+    solana_transaction_error::TransactionError,
+};
+
+/// Who runs the batch, which sets the depth and the wait of the check.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum BmmCheck {
+    /// A leader or a simulation. It needs N + 1 blocks on top, and it does not
+    /// wait. The banking stage tries a "not ready" tx again later.
+    Leader,
+    /// Replay of a block from another validator. It needs N blocks on top, and
+    /// it waits for the local enforcer.
+    Replay,
+}
+
+impl Bank {
+    /// Answers the first top-level `settle_bmm` of each tx, or fails the tx
+    /// as "not ready".
+    pub(super) fn check_bmm_settles(
+        &self,
+        sanitized_txs: &[impl TransactionWithMeta],
+        check_results: Vec<TransactionCheckResult>,
+        check: BmmCheck,
+    ) -> Vec<TransactionCheckResult> {
+        check_results
+            .into_iter()
+            .zip(sanitized_txs)
+            .map(|(result, tx)| {
+                let details = result?;
+                let Some((program_id_index, (height, block_hash))) = tx
+                    .program_instructions_iter()
+                    .find_map(|(program_id, instruction)| {
+                        settle_bmm_question(program_id, instruction.data)
+                            .map(|question| (instruction.program_id_index, question))
+                    })
+                else {
+                    return Ok(details);
+                };
+                let answer = match check {
+                    BmmCheck::Leader => {
+                        view().answer(height, &block_hash, confirmations().saturating_add(1))
+                    }
+                    BmmCheck::Replay => {
+                        view().wait_for_answer(height, &block_hash, confirmations(), REPLAY_WAIT)
+                    }
+                };
+                let Some(commitment) = answer else {
+                    log::debug!(
+                        "the BMM view has no answer for eCash height {height}, block {}, as {:?}",
+                        hex::encode(block_hash),
+                        check,
+                    );
+                    return Err(TransactionError::ProgramExecutionTemporarilyRestricted {
+                        account_index: program_id_index,
+                    });
+                };
+                let account = AccountSharedData::from(Account {
+                    data: answer_data(height, &block_hash, commitment).to_vec(),
+                    owner: solana_sdk_ids::sysvar::id(),
+                    ..Account::default()
+                });
+                Ok(details.with_runtime_account(BMM_ANSWER_ID, account))
+            })
+            .collect()
+    }
+}
