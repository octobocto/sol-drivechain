+/// sol-drivechain: when BMM asked for a restart, puts every snapshot archive
+/// above the anchor slot aside and removes the roots above it. Then the start
+/// loads an older snapshot and replays the forks above it. Returns true when it
+/// prepared a restart.
+fn prepare_bmm_restart(
+    ledger_path: &Path,
+    validator_config: &mut ValidatorConfig,
+) -> Result<bool, String> {
+    use sol_drivechain_bmm::fork_choice::{SET_ASIDE_DIR, Saved, set_aside_archives_above};
+
+    let mut saved = Saved::load(ledger_path)
+        .map_err(|error| format!("cannot read the BMM fork choice state: {error}"))?;
+    let Some(slot) = saved.restart_to else {
+        return Ok(false);
+    };
+    let snapshot_config = &validator_config.snapshot_config;
+    let mut archive_dirs = vec![snapshot_config.full_snapshot_archives_dir.as_path()];
+    if snapshot_config.incremental_snapshot_archives_dir
+        != snapshot_config.full_snapshot_archives_dir
+    {
+        archive_dirs.push(snapshot_config.incremental_snapshot_archives_dir.as_path());
+    }
+    let seconds = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|error| format!("the clock is before 1970: {error}"))?
+        .as_secs();
+    let aside = ledger_path.join(SET_ASIDE_DIR).join(seconds.to_string());
+    let moved = set_aside_archives_above(&archive_dirs, slot, &aside).map_err(|error| {
+        format!("cannot put the snapshot archives above slot {slot} aside: {error}")
+    })?;
+    let blockstore = solana_ledger::blockstore::Blockstore::open(ledger_path)
+        .map_err(|error| format!("cannot open the blockstore for a BMM restart: {error:?}"))?;
+    let removed = blockstore
+        .remove_roots_above(slot)
+        .map_err(|error| format!("cannot remove the roots above slot {slot}: {error:?}"))?;
+    drop(blockstore);
+    validator_config.use_snapshot_archives_at_startup = UseSnapshotArchivesAtStartup::Always;
+    saved.restart_to = None;
+    saved.drop_anchors_above(slot);
+    saved
+        .store(ledger_path)
+        .map_err(|error| format!("cannot write the BMM fork choice state: {error}"))?;
+    warn!(
+        "BMM restart: the start loads a snapshot at or below slot {slot}. {} archives went to {}, \
+         and {} roots above slot {slot} are gone.",
+        moved.len(),
+        aside.display(),
+        removed.len()
+    );
+    Ok(true)
+}
