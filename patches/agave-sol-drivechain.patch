+/// Puts the account that the runtime built in place of the loaded account
+/// with the same key. A tx that does not list the key gets nothing.
+pub(crate) fn place_runtime_account(
+    load_result: TransactionLoadResult,
+    runtime_account: Option<(Pubkey, AccountSharedData)>,
+) -> TransactionLoadResult {
+    match (load_result, runtime_account) {
+        (TransactionLoadResult::Loaded(mut loaded), Some((key, account))) => {
+            for (loaded_key, loaded_account) in loaded.accounts.iter_mut() {
+                if *loaded_key == key {
+                    *loaded_account = account.clone();
+                }
+            }
+            TransactionLoadResult::Loaded(loaded)
+        }
+        (load_result, _) => load_result,
+    }
 }
 
