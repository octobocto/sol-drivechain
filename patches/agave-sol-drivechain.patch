+//! The eCash view of a SOL drivechain validator.
+//!
+//! Each validator reads the active eCash chain from its own enforcer. Before a
+//! `settle_bmm(H, M)` runs, the runtime asks this view one question: is block
+//! M the active block at height H, deep enough, and which commitment does its
+//! coinbase hold for the sidechain? The answer goes into the `BmmAnswer`
+//! account of that tx.
+
+#[cfg(feature = "poller")]
+mod enforcer;
+pub mod fork_choice;
+#[cfg(feature = "poller")]
+mod poller;
+
+#[cfg(feature = "poller")]
+pub use poller::start_poller;
+use {
+    solana_pubkey::Pubkey,
+    std::{
+        collections::BTreeMap,
+        sync::{
+            Condvar, Mutex, OnceLock,
+            atomic::{AtomicU64, Ordering},
+        },
+        time::{Duration, Instant},
+    },
+};
+
+/// The bridge program of the SOL drivechain.
+pub const BRIDGE_PROGRAM_ID: Pubkey =
+    Pubkey::from_str_const("ARA8mQfWk85ULDLAujy3b8gLknFF2QzrsAKHYbc8beu");
+
+/// The account that holds the pre-check answer for one tx. The runtime builds
+/// it for each tx, the same way as the instructions sysvar.
+pub const BMM_ANSWER_ID: Pubkey =
+    Pubkey::from_str_const("BmmAnswer1111111111111111111111111111111111");
+
+/// The seed of the treasury PDA, which collects every transaction fee.
+pub const TREASURY_SEED: &[u8] = b"treasury";
+
+/// The Anchor discriminator of `settle_bmm`: sha256("global:settle_bmm")[..8].
+pub const SETTLE_BMM_DISCRIMINATOR: [u8; 8] = [223, 214, 151, 212, 138, 42, 77, 15];
+
+/// The confirmation count when the validator flag does not set one.
+pub const DEFAULT_CONFIRMATIONS: u64 = 6;
+
+/// Replay waits this long for the local enforcer before it rejects a block.
+pub const REPLAY_WAIT: Duration = Duration::from_secs(30);
+
+/// The size of the `BmmAnswer` data: height, block hash, found, commitment.
+pub const BMM_ANSWER_LEN: usize = 8 + 32 + 1 + 32;
+
+/// A 32-byte block hash, in the internal byte order of Bitcoin. That is the
+/// reverse of the hex that block explorers show.
+pub type BlockHash = [u8; 32];
+
+/// A 32-byte BMM commitment from an eCash coinbase.
+pub type Commitment = [u8; 32];
+
+static CONFIRMATIONS: AtomicU64 = AtomicU64::new(DEFAULT_CONFIRMATIONS);
+
+/// Sets N, the blocks that must be on top of a settled block. Every validator
+/// of a cluster must use the same N.
+pub fn set_confirmations(confirmations: u64) {
+    CONFIRMATIONS.store(confirmations, Ordering::Relaxed);
+}
+
+/// N, the blocks that must be on top of a settled block.
+pub fn confirmations() -> u64 {
+    CONFIRMATIONS.load(Ordering::Relaxed)
+}
+
+/// The treasury PDA of the bridge.
+pub fn treasury() -> Pubkey {
+    static TREASURY: OnceLock<Pubkey> = OnceLock::new();
+    *TREASURY.get_or_init(|| Pubkey::find_program_address(&[TREASURY_SEED], &BRIDGE_PROGRAM_ID).0)
+}
+
+/// The eCash height and block that a `settle_bmm` instruction names, or `None`
+/// for any other instruction.
+pub fn settle_bmm_question(program_id: &Pubkey, data: &[u8]) -> Option<(u64, BlockHash)> {
+    if program_id != &BRIDGE_PROGRAM_ID {
+        return None;
+    }
+    let (discriminator, arguments) = data.split_first_chunk::<8>()?;
+    if discriminator != &SETTLE_BMM_DISCRIMINATOR {
+        return None;
+    }
+    let (height, rest) = arguments.split_first_chunk::<8>()?;
+    let block_hash = rest.first_chunk::<32>()?;
+    Some((u64::from_le_bytes(*height), *block_hash))
+}
+
+/// The data of the `BmmAnswer` account for one question and its answer.
+pub fn answer_data(
+    height: u64,
+    block_hash: &BlockHash,
+    commitment: Option<Commitment>,
+) -> [u8; BMM_ANSWER_LEN] {
+    let mut data = [0u8; BMM_ANSWER_LEN];
+    data[..8].copy_from_slice(&height.to_le_bytes());
+    data[8..40].copy_from_slice(block_hash);
+    if let Some(commitment) = commitment {
+        data[40] = 1;
+        data[41..].copy_from_slice(&commitment);
+    }
+    data
+}
+
+/// One block of the active eCash chain.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Block {
+    pub hash: BlockHash,
+    pub prev_hash: BlockHash,
+    pub commitment: Option<Commitment>,
+}
+
+#[derive(Default)]
+struct State {
+    /// The height of the active tip.
+    tip_height: Option<u64>,
+    /// The active chain, from the lowest height that the view holds up to
+    /// the tip.
+    active: BTreeMap<u64, Block>,
+    /// The lowest height that a caller asked for and the view did not hold.
+    wanted_low: Option<u64>,
+    /// Goes up by one at each change of the active chain.
+    generation: u64,
+}
+
+/// The active eCash chain of the local enforcer.
+#[derive(Default)]
+pub struct BmmView {
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+/// The view that the runtime reads.
+pub fn view() -> &'static BmmView {
+    static VIEW: OnceLock<BmmView> = OnceLock::new();
+    VIEW.get_or_init(BmmView::default)
+}
+
+impl BmmView {
+    /// The commitment of block `block_hash` if it is the active block at
+    /// `height` with at least `depth` blocks on top of it. `Some(None)` means
+    /// that its coinbase holds no commitment for the sidechain. `None` means
+    /// not ready.
+    pub fn answer(
+        &self,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+    ) -> Option<Option<Commitment>> {
+        let mut state = self.state.lock().unwrap();
+        Self::answer_locked(&mut state, height, block_hash, depth)
+    }
+
+    /// The same as `answer`, but it waits up to `timeout` for the enforcer.
+    pub fn wait_for_answer(
+        &self,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+        timeout: Duration,
+    ) -> Option<Option<Commitment>> {
+        let deadline = Instant::now().checked_add(timeout)?;
+        let mut state = self.state.lock().unwrap();
+        loop {
+            if let Some(answer) = Self::answer_locked(&mut state, height, block_hash, depth) {
+                return Some(answer);
+            }
+            let remaining = deadline.checked_duration_since(Instant::now())?;
+            state = self.changed.wait_timeout(state, remaining).unwrap().0;
+        }
+    }
+
+    fn answer_locked(
+        state: &mut State,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+    ) -> Option<Option<Commitment>> {
+        let lowest = state.active.keys().next().copied();
+        if lowest.is_some_and(|lowest| height < lowest) {
+            state.wanted_low = Some(state.wanted_low.map_or(height, |wanted| wanted.min(height)));
+            return None;
+        }
+        if state.tip_height?.checked_sub(height)? < depth {
+            return None;
+        }
+        let block = state.active.get(&height)?;
+        (&block.hash == block_hash).then_some(block.commitment)
+    }
+
+    /// Replaces the active chain from the lowest height in `blocks` upward.
+    /// `blocks` runs from low to high and ends at the new tip.
+    pub fn replace_from(&self, blocks: &[(u64, Block)]) {
+        let (Some(&(lowest, _)), Some(&(tip_height, _))) = (blocks.first(), blocks.last()) else {
+            return;
+        };
+        let mut state = self.state.lock().unwrap();
+        state.active.split_off(&lowest);
+        state.active.extend(blocks.iter().copied());
+        state.tip_height = Some(tip_height);
+        if state.wanted_low.is_some_and(|wanted| wanted >= lowest) {
+            state.wanted_low = None;
+        }
+        state.generation = state.generation.wrapping_add(1);
+        self.changed.notify_all();
+    }
+
+    /// Adds older blocks below the lowest block that the view holds.
+    pub fn extend_below(&self, blocks: &[(u64, Block)]) {
+        let mut state = self.state.lock().unwrap();
+        let lowest = state.active.keys().next().copied();
+        for (height, block) in blocks {
+            if lowest.is_none_or(|lowest| *height < lowest) {
+                state.active.insert(*height, *block);
+            }
+        }
+        let new_lowest = state.active.keys().next().copied();
+        if let (Some(wanted), Some(new_lowest)) = (state.wanted_low, new_lowest)
+            && wanted >= new_lowest
+        {
+            state.wanted_low = None;
+        }
+        state.generation = state.generation.wrapping_add(1);
+        self.changed.notify_all();
+    }
+
+    /// The active block at `height`, if the view holds it.
+    pub fn block_at(&self, height: u64) -> Option<Block> {
+        self.state.lock().unwrap().active.get(&height).copied()
+    }
+
+    /// The height and hash of the active tip.
+    pub fn tip(&self) -> Option<(u64, BlockHash)> {
+        let state = self.state.lock().unwrap();
+        state
+            .active
+            .iter()
+            .next_back()
+            .map(|(height, block)| (*height, block.hash))
+    }
+
+    /// The lowest height that the view holds.
+    pub fn lowest(&self) -> Option<u64> {
+        self.state.lock().unwrap().active.keys().next().copied()
+    }
+
+    /// The lowest height that a caller asked for and the view did not hold.
+    pub fn wanted_low(&self) -> Option<u64> {
+        self.state.lock().unwrap().wanted_low
+    }
+
+    /// A number that changes at each change of the active chain.
+    pub fn generation(&self) -> u64 {
+        self.state.lock().unwrap().generation
+    }
+
+    /// The tip height and every active block with a commitment, from low to
+    /// high, or `None` before the first read from the enforcer.
+    pub fn checkpoints(&self) -> Option<(u64, Vec<fork_choice::Checkpoint>)> {
+        let state = self.state.lock().unwrap();
+        let checkpoints = state
+            .active
+            .iter()
+            .filter_map(|(height, block)| {
+                block.commitment.map(|commitment| fork_choice::Checkpoint {
+                    height: *height,
+                    block_hash: block.hash,
+                    commitment,
+                })
+            })
+            .collect();
+        Some((state.tip_height?, checkpoints))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use {super::*, std::sync::Arc};
+
+    fn hash(byte: u8) -> BlockHash {
+        [byte; 32]
+    }
+
+    /// Blocks from `from` to `to`. The hash of height `h` is `[h + salt; 32]`,
+    /// and even heights hold the commitment `[h; 32]`.
+    fn chain(from: u64, to: u64, salt: u8) -> Vec<(u64, Block)> {
+        (from..=to)
+            .map(|height| {
+                let low = height as u8;
+                (
+                    height,
+                    Block {
+                        hash: hash(low.wrapping_add(salt)),
+                        prev_hash: hash(low.wrapping_sub(1).wrapping_add(salt)),
+                        commitment: (height % 2 == 0).then_some([low; 32]),
+                    },
+                )
+            })
+            .collect()
+    }
+
+    fn settle_data(height: u64, block_hash: &BlockHash) -> Vec<u8> {
+        let mut data = SETTLE_BMM_DISCRIMINATOR.to_vec();
+        data.extend_from_slice(&height.to_le_bytes());
+        data.extend_from_slice(block_hash);
+        data
+    }
+
+    #[test]
+    fn the_discriminator_is_eight_bytes_of_sha256() {
+        let digest = solana_sha256_hasher::hash(b"global:settle_bmm").to_bytes();
+        assert_eq!(SETTLE_BMM_DISCRIMINATOR, digest[..8]);
+    }
+
+    #[test]
+    fn a_settle_instruction_gives_its_question() {
+        assert_eq!(
+            settle_bmm_question(&BRIDGE_PROGRAM_ID, &settle_data(42, &hash(7))),
+            Some((42, hash(7)))
+        );
+    }
+
+    #[test]
+    fn another_program_gives_no_question() {
+        let other = Pubkey::new_from_array([9; 32]);
+        assert_eq!(
+            settle_bmm_question(&other, &settle_data(42, &hash(7))),
+            None
+        );
+    }
+
+    #[test]
+    fn another_instruction_gives_no_question() {
+        let mut data = settle_data(42, &hash(7));
+        data[0] ^= 1;
+        assert_eq!(settle_bmm_question(&BRIDGE_PROGRAM_ID, &data), None);
+    }
+
+    #[test]
+    fn short_data_gives_no_question() {
+        let data = settle_data(42, &hash(7));
+        assert_eq!(settle_bmm_question(&BRIDGE_PROGRAM_ID, &data[..47]), None);
+    }
+
+    #[test]
+    fn the_answer_data_holds_the_question_and_the_commitment() {
+        let data = answer_data(42, &hash(7), Some(hash(9)));
+        assert_eq!(&data[..8], &42u64.to_le_bytes());
+        assert_eq!(&data[8..40], &hash(7));
+        assert_eq!(data[40], 1);
+        assert_eq!(&data[41..], &hash(9));
+        let none = answer_data(42, &hash(7), None);
+        assert_eq!(none[40], 0);
+        assert_eq!(&none[41..], &[0u8; 32]);
+    }
+
+    #[test]
+    fn the_treasury_is_the_bridge_pda() {
+        let expected = Pubkey::find_program_address(&[b"treasury"], &BRIDGE_PROGRAM_ID).0;
+        assert_eq!(treasury(), expected);
+    }
+
+    #[test]
+    fn an_empty_view_is_not_ready() {
+        let view = BmmView::default();
+        assert_eq!(view.answer(10, &hash(10), 6), None);
+    }
+
+    #[test]
+    fn an_active_block_deep_enough_gives_its_commitment() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 110, 0));
+        assert_eq!(view.answer(104, &hash(104), 6), Some(Some([104; 32])));
+        assert_eq!(view.answer(103, &hash(103), 6), Some(None));
+    }
+
+    #[test]
+    fn a_block_without_enough_blocks_on_top_is_not_ready() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 110, 0));
+        assert_eq!(view.answer(105, &hash(105), 6), None);
+        assert_eq!(view.answer(105, &hash(105), 5), Some(None));
+    }
+
+    #[test]
+    fn a_block_that_is_not_active_is_not_ready() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 110, 0));
+        assert_eq!(view.answer(104, &hash(200), 6), None);
+    }
+
+    #[test]
+    fn a_reorg_replaces_the_active_blocks() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 110, 0));
+        view.replace_from(&chain(104, 120, 50));
+        assert_eq!(view.answer(104, &hash(104), 6), None);
+        assert_eq!(view.answer(104, &hash(104 + 50), 6), Some(Some([104; 32])));
+        assert_eq!(view.block_at(103).map(|block| block.hash), Some(hash(103)));
+    }
+
+    #[test]
+    fn a_shorter_new_chain_drops_the_old_blocks_above_it() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 120, 0));
+        view.replace_from(&chain(110, 112, 50));
+        assert_eq!(view.block_at(115), None);
+        assert_eq!(view.tip(), Some((112, hash(112 + 50))));
+    }
+
+    #[test]
+    fn a_question_below_the_view_asks_for_a_backfill() {
+        let view = BmmView::default();
+        view.replace_from(&chain(100, 120, 0));
+        assert_eq!(view.answer(90, &hash(90), 6), None);
+        assert_eq!(view.wanted_low(), Some(90));
+        view.extend_below(&chain(90, 99, 0));
+        assert_eq!(view.wanted_low(), None);
+        assert_eq!(view.answer(90, &hash(90), 6), Some(Some([90; 32])));
+    }
+
+    #[test]
+    fn wait_for_answer_returns_when_the_block_is_deep_enough() {
+        let view = Arc::new(BmmView::default());
+        view.replace_from(&chain(100, 105, 0));
+        let writer = Arc::clone(&view);
+        let handle = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            writer.replace_from(&chain(106, 110, 0));
+        });
+        assert_eq!(
+            view.wait_for_answer(104, &hash(104), 6, Duration::from_secs(10)),
+            Some(Some([104; 32]))
+        );
+        handle.join().unwrap();
+    }
+
+    #[test]
+    fn checkpoints_list_the_blocks_with_a_commitment() {
+        let view = BmmView::default();
+        assert_eq!(view.checkpoints(), None);
+        let before = view.generation();
+        view.replace_from(&chain(100, 105, 0));
+        assert_ne!(view.generation(), before);
+        let (tip, checkpoints) = view.checkpoints().unwrap();
+        assert_eq!(tip, 105);
+        let heights: Vec<u64> = checkpoints.iter().map(|checkpoint| checkpoint.height).collect();
+        assert_eq!(heights, vec![100, 102, 104]);
+        assert_eq!(checkpoints[1].block_hash, hash(102));
+        assert_eq!(checkpoints[1].commitment, [102; 32]);
+    }
+
+    #[test]
+    fn wait_for_answer_gives_up_after_the_timeout() {
+        let view = BmmView::default();
+        assert_eq!(
+            view.wait_for_answer(5, &hash(5), 6, Duration::from_millis(20)),
+            None
+        );
+    }
+}
