+    fn a_failed_store_moves_no_final_root() {
+        let mut bmm = BmmForkChoice {
+            ledger: PathBuf::from("/nonexistent/bmm-ledger"),
+            archives: None,
+            saved: Saved::default(),
+            key: None,
+            banks: Vec::new(),
+            checkpoints: Vec::new(),
+            vouched: Vec::new(),
+            unmatched: Vec::new(),
+            tip_height: 100,
+            choice: Choice {
+                new_root: Some(777_777),
+                new_anchors: vec![Anchor {
+                    slot: 777_777,
+                    bank_hash: [1; 32],
+                    height: 90,
+                    block_hash: [2; 32],
+                }],
+                ..Choice::default()
+            },
+            missing_archive_height: 0,
+            credits: HashMap::new(),
+            dropped: HashSet::new(),
+            root_dropped: false,
+            rejected: HashSet::new(),
+            ancestors: Vec::new(),
+            credited_tip: 0,
+        };
+        assert!(bmm.take_new_root(10).is_err());
+        assert_ne!(fork_choice::final_root(), 777_777);
+    }
+}
