+            &[&staked, &unstaked, &tiny],
+            vec![1_000_000_000, 0, 900_000],
+        );
+        genesis.genesis_config.fee_rate_governor =
+            solana_fee_calculator::FeeRateGovernor::new(5_000, 0);
+        let bank = Bank::new_for_tests(&genesis.genesis_config);
+        let voter_of = |keys: &ValidatorVoteKeypairs| {
+            let vote_key = keys.vote_keypair.pubkey();
+            let accounts = bank.get_current_epoch_vote_accounts();
+            let voter = accounts.get(&vote_key).and_then(|(_, account)| {
+                account
+                    .vote_state_view()
+                    .get_authorized_voter(bank.epoch())
+                    .copied()
+            });
+            match voter {
+                Some(voter) if voter == keys.node_keypair.pubkey() => {
+                    keys.node_keypair.insecure_clone()
+                }
+                _ => keys.vote_keypair.insecure_clone(),
+            }
+        };
+        let vote_tx = |vote_key: Pubkey, signer: &Keypair| {
+            let instruction = vote_instruction::tower_sync(
+                &vote_key,
+                &signer.pubkey(),
+                TowerSync::new_from_slot(0, Hash::default()),
+            );
+            Transaction::new_signed_with_payer(
+                &[instruction],
+                Some(&signer.pubkey()),
+                &[signer],
+                Hash::default(),
+            )
+        };
+        let authority = voter_of(&staked);
+        assert_eq!(
+            vote_fee(&bank, vote_tx(staked.vote_keypair.pubkey(), &authority)),
+            0
+        );
+        let stranger = Keypair::new();
+        assert_eq!(
+            vote_fee(&bank, vote_tx(staked.vote_keypair.pubkey(), &stranger)),
+            5_000
+        );
+        let unstaked_authority = voter_of(&unstaked);
+        assert_eq!(
+            vote_fee(
+                &bank,
+                vote_tx(unstaked.vote_keypair.pubkey(), &unstaked_authority)
+            ),
+            5_000
+        );
+        let transfer = Transaction::new_signed_with_payer(
+            &[solana_system_interface::instruction::transfer(
+                &authority.pubkey(),
+                &stranger.pubkey(),
+                1,
+            )],
+            Some(&authority.pubkey()),
+            &[&authority],
+            Hash::default(),
+        );
+        assert_eq!(vote_fee(&bank, transfer), 5_000);
+        let tiny_authority = voter_of(&tiny);
+        assert_eq!(
+            vote_fee(&bank, vote_tx(tiny.vote_keypair.pubkey(), &tiny_authority)),
+            5_000
+        );
+        let estimate = |vote_key: Pubkey, signer: &Keypair| {
+            let instruction = vote_instruction::tower_sync(
+                &vote_key,
+                &signer.pubkey(),
+                TowerSync::new_from_slot(0, Hash::default()),
+            );
+            let message = solana_message::Message::new_with_blockhash(
+                &[instruction],
+                Some(&signer.pubkey()),
+                &bank.last_blockhash(),
+            );
+            let message = solana_message::SanitizedMessage::try_from_legacy_message(
+                message,
+                &std::collections::HashSet::new(),
+            )
+            .unwrap();
+            bank.get_fee_for_message(&message)
+        };
+        assert_eq!(estimate(staked.vote_keypair.pubkey(), &authority), Some(0));
+        assert_eq!(
+            estimate(staked.vote_keypair.pubkey(), &stranger),
+            Some(5_000)
+        );
+        assert_eq!(
+            estimate(tiny.vote_keypair.pubkey(), &tiny_authority),
+            Some(5_000)
+        );
+    }
+
+    #[test]
+    fn block_production_asks_as_a_leader() {
+        assert_eq!(BmmCheck::of(true, false), BmmCheck::Simulation);
+        assert_eq!(BmmCheck::of(false, true), BmmCheck::Leader);
+        assert_eq!(BmmCheck::of(false, false), BmmCheck::Replay);
+        assert_eq!(
+            sol_drivechain_bmm::produce_block(|| BmmCheck::of(false, false)),
+            BmmCheck::Leader
+        );
+    }
+}
