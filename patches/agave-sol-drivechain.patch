+    /// Two credits in one batch: the second sees the config before the
+    /// first, as a leader does, or after it, as a replay one tx at a time
+    /// does. Both give the same answer.
+    #[test]
+    fn a_credit_gets_the_same_answer_before_and_after_an_earlier_credit_of_its_block() {
+        let genesis = create_genesis_config(1_000_000_000);
+        let (start, bank_forks) = Bank::new_with_bank_forks_for_tests(&genesis.genesis_config);
+        store_bridge(&start, 100, 40, 0);
+        let child = |slot| {
+            Bank::new_from_parent_with_bank_forks(
+                bank_forks.as_ref(),
+                start.clone(),
+                SlotLeader::default(),
+                slot,
+            )
+        };
+        let before = child(1);
+        let after = child(2);
+        store_bridge(&after, 100, 41, 0);
+        for check_as in [BmmCheck::Leader, BmmCheck::Replay] {
+            for height in [41, 42] {
+                let first = answer_of(check(&before, tx(credit_of_view(height), true), check_as));
+                let second = answer_of(check(&after, tx(credit_of_view(height), true), check_as));
+                assert_eq!(first, second);
