+//! BMM fork choice. eCash checkpoints select the Solana branch, and they move
+//! the Solana root.
+//!
+//! A checkpoint is an eCash block whose BMM commitment h* has a published pair
+//! (bank hash, payee) with SHA-256(bank hash ‖ payee) = h*. It counts when its
+//! bank is frozen. The branch with the most checkpoints above the root wins.
+//! In a tie the node builds on the lower bank hash, but a tie roots and
+//! prunes nothing, so the next checkpoint decides it. The root moves to the
+//! newest checkpoint on the winning branch with `root_depth` eCash blocks on
+//! top.
+//! When no checkpoint comes for `fallback_blocks` eCash blocks, the root
+//! follows the stake votes again. A checkpoint for an absent bank stops the
+//! fallback and asks for a restart only when a trusted staked peer holds its
+//! bank. A commitment without a pair is not a
+//! checkpoint.
+//!
+//! A checkpoint at eCash height H counts only when the bridge config of its
+//! bank credited every deposit through H - lag, and the active eCash chain
+//! still holds those credits. While the view cannot check the credits, the
+//! checkpoint stays pending. A bank whose credits the active eCash chain
+//! dropped never counts, and no leader builds on it.
+
+use {
+    crate::{BlockHash, Credits, RecordAnswer, RecordedBlock, peers::NodeId},
+    std::{
+        collections::{HashMap, HashSet},
+        fs,
+        io::{self, Write},
+        path::{Path, PathBuf},
+        sync::atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+};
+
+pub type Slot = u64;
+
+/// The hash of a frozen bank, as `Bank::hash` gives it.
+pub type BankHash = [u8; 32];
+
+/// K, the eCash blocks on top of a checkpoint before it becomes a root.
+pub const DEFAULT_ROOT_DEPTH: u64 = 2;
+
+/// L, the eCash blocks without a checkpoint before the root follows the stake
+/// votes.
+pub const DEFAULT_FALLBACK_BLOCKS: u64 = 6;
+
+/// The anchors stay this many eCash blocks below the tip, the same window that
+/// the view reads at start.
+const ANCHOR_WINDOW: u64 = 4032;
+
+/// The file in the ledger directory that keeps the anchors and the restart
+/// request.
+pub const STATE_FILE: &str = "bmm-fork-choice";
+
+/// The directory in the ledger directory that takes the snapshot archives
+/// above a restart slot.
+pub const SET_ASIDE_DIR: &str = "bmm-set-aside";
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static FINAL_ROOT: AtomicU64 = AtomicU64::new(0);
+static ROOT_DEPTH: AtomicU64 = AtomicU64::new(DEFAULT_ROOT_DEPTH);
+static FALLBACK_BLOCKS: AtomicU64 = AtomicU64::new(DEFAULT_FALLBACK_BLOCKS);
+static VOTE_FLOOR: AtomicU64 = AtomicU64::new(0);
+
+/// Lets BMM checkpoints select the fork and move the root.
+pub fn enable() {
+    ENABLED.store(true, Ordering::Relaxed);
+}
+
+/// Sets K and L from the genesis.
+pub fn set_params(params: Params) {
+    ROOT_DEPTH.store(params.root_depth, Ordering::Relaxed);
+    FALLBACK_BLOCKS.store(params.fallback_blocks, Ordering::Relaxed);
+}
+
+/// Sets the newest root that BMM checkpoints moved. Later pairs cannot take
+/// it back, and the RPC `finalized` commitment stops there.
+pub fn set_final_root(slot: Slot) {
+    FINAL_ROOT.store(slot, Ordering::Relaxed);
+}
+
+pub fn final_root() -> Slot {
+    FINAL_ROOT.load(Ordering::Relaxed)
+}
+
+/// True when BMM checkpoints select the fork and move the root.
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Stops every vote at or below `slot`. A start that drops the tower sets it
+/// to the last vote of that tower.
+pub fn raise_vote_floor(slot: Slot) {
+    VOTE_FLOOR.fetch_max(slot, Ordering::Relaxed);
+}
+
+/// The highest slot that this process must not vote on.
+pub fn vote_floor() -> Slot {
+    VOTE_FLOOR.load(Ordering::Relaxed)
+}
+
+/// The values that `enable` set.
+pub fn params() -> Params {
+    Params {
+        root_depth: ROOT_DEPTH.load(Ordering::Relaxed),
+        fallback_blocks: FALLBACK_BLOCKS.load(Ordering::Relaxed),
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Params {
+    pub root_depth: u64,
+    pub fallback_blocks: u64,
+}
+
+impl Default for Params {
+    fn default() -> Self {
+        Self {
+            root_depth: DEFAULT_ROOT_DEPTH,
+            fallback_blocks: DEFAULT_FALLBACK_BLOCKS,
+        }
+    }
+}
+
+/// A frozen bank at or above the root. The root has no parent.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ForkBank {
+    pub slot: Slot,
+    pub hash: BankHash,
+    pub parent: Option<Slot>,
+}
+
+/// An eCash block of the active chain with a BMM commitment and its pair.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Checkpoint {
+    pub height: u64,
+    pub block_hash: BlockHash,
+    /// The Solana bank hash of the pair.
+    pub bank_hash: BankHash,
+}
+
+/// A checkpoint whose bank became a root. The bank leaves the fork tree, so
+/// the node keeps this record of it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Anchor {
+    pub slot: Slot,
+    pub bank_hash: BankHash,
+    pub height: u64,
+    pub block_hash: BlockHash,
+}
+
+impl Anchor {
+    /// True when the active eCash chain still holds this checkpoint.
+    pub fn is_active(&self, checkpoints: &[Checkpoint]) -> bool {
+        checkpoints
+            .iter()
+            .any(|checkpoint| self.matches(checkpoint))
+    }
+
+    /// True when `checkpoint` is the checkpoint of this anchor.
+    pub fn matches(&self, checkpoint: &Checkpoint) -> bool {
+        checkpoint.height == self.height
+            && checkpoint.block_hash == self.block_hash
+            && checkpoint.bank_hash == self.bank_hash
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Choice {
+    /// The newest checkpoint bank on the branch with the most checkpoints
+    /// above the root.
+    pub head: Option<Slot>,
+    /// The checkpoints above the root on that branch.
+    pub count: usize,
+    /// The newest checkpoint bank on that branch with `root_depth` eCash
+    /// blocks on top, when it is above the root.
+    pub new_root: Option<Slot>,
+    /// The checkpoints at or below `new_root` and above the root.
+    pub new_anchors: Vec<Anchor>,
+    /// The checkpoints for banks that the move to `new_root` prunes. They
+    /// lost the fork choice, so they ask for no restart while the checkpoint
+    /// that beat them stays on the active eCash chain.
+    pub new_pruned: Vec<Pruned>,
+    /// No checkpoint came for `fallback_blocks` eCash blocks.
+    pub fallback: bool,
+    /// The heads with the most checkpoints. More than one is a tie.
+    pub tied: usize,
+}
+
+/// Selects the branch and the next root from the fork tree and the active
+/// eCash chain.
+pub fn choose(
+    root: Slot,
+    banks: &[ForkBank],
+    checkpoints: &[Checkpoint],
+    tip_height: u64,
+    params: Params,
+) -> Choice {
+    let tree = Tree::new(banks);
+    let matched: Vec<(Checkpoint, Slot)> = checkpoints
+        .iter()
+        .filter_map(|checkpoint| {
+            tree.slot_of(&checkpoint.bank_hash)
+                .map(|slot| (*checkpoint, slot))
+        })
+        .collect();
+
+    let fallback = checkpoints
+        .iter()
+        .map(|checkpoint| checkpoint.height)
+        .max()
+        .is_none_or(|height| tip_height.saturating_sub(height) >= params.fallback_blocks);
+
+    let mut direct: HashMap<Slot, usize> = HashMap::new();
+    for (_, slot) in matched.iter().filter(|(_, slot)| *slot > root) {
+        let count = direct.entry(*slot).or_default();
+        *count = count.saturating_add(1);
+    }
+    let mut counts: HashMap<Slot, usize> = HashMap::new();
+    let heads: Vec<(Slot, usize)> = direct
+        .keys()
+        .map(|slot| (*slot, tree.count(*slot, root, &direct, &mut counts)))
+        .collect();
+    let Some(count) = heads.iter().map(|(_, count)| *count).max() else {
+        return Choice {
+            fallback,
+            ..Choice::default()
+        };
+    };
+    let tied: Vec<Slot> = heads
+        .iter()
+        .filter(|(_, head_count)| *head_count == count)
+        .map(|(slot, _)| *slot)
+        .collect();
+    let Some(head) = tied.iter().copied().min_by_key(|slot| tree.hash(*slot)) else {
+        return Choice {
+            fallback,
+            ..Choice::default()
+        };
+    };
+    // A tie roots and prunes nothing. The next checkpoint decides it.
+    let decided = tied.len() == 1;
+
+    let path: HashSet<Slot> = tree.path(head, root).collect();
+    let deep_enough =
+        |checkpoint: &Checkpoint| tip_height.saturating_sub(checkpoint.height) >= params.root_depth;
+    let new_root = matched
+        .iter()
+        .filter(|(checkpoint, slot)| path.contains(slot) && deep_enough(checkpoint))
+        .map(|(_, slot)| *slot)
+        .max()
+        .filter(|_| decided);
+    let new_anchors: Vec<Anchor> = new_root
+        .map(|new_root| {
+            matched
+                .iter()
+                .filter(|(_, slot)| *slot <= new_root && path.contains(slot))
+                .map(|(checkpoint, slot)| Anchor {
+                    slot: *slot,
+                    bank_hash: checkpoint.bank_hash,
+                    height: checkpoint.height,
+                    block_hash: checkpoint.block_hash,
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let winner = new_anchors
+        .iter()
+        .max_by_key(|anchor| anchor.height)
+        .map(|anchor| (anchor.height, anchor.block_hash));
+    let new_pruned = new_root
+        .map(|new_root| {
+            matched
+                .iter()
+                .filter(|(_, slot)| {
+                    *slot > root && !path.contains(slot) && !tree.descends(*slot, new_root)
+                })
+                .map(|(checkpoint, _)| Pruned {
+                    checkpoint: *checkpoint,
+                    winner,
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    Choice {
+        head: Some(head),
+        count,
+        new_root,
+        new_anchors,
+        new_pruned,
+        fallback,
+        tied: tied.len(),
+    }
+}
+
+/// Stops the fallback while a pending or a vouched checkpoint came less than
+/// `fallback_blocks` eCash blocks ago. It never changes the root move.
+/// Returns the vouched checkpoints that stopped the fallback, so their peers
+/// must prove them with `open_proof`.
+pub fn stop_fallback(
+    choice: &mut Choice,
+    pending: &[u64],
+    vouched: &[Checkpoint],
+    tip_height: u64,
+    params: Params,
+) -> Vec<Checkpoint> {
+    if !choice.fallback {
+        return Vec::new();
+    }
+    if pending_stops_fallback(pending, tip_height, params) {
+        choice.fallback = false;
+        return Vec::new();
+    }
+    let stopping: Vec<Checkpoint> = vouched
+        .iter()
+        .filter(|checkpoint| tip_height.saturating_sub(checkpoint.height) < params.fallback_blocks)
+        .copied()
+        .collect();
+    choice.fallback = stopping.is_empty();
+    stopping
+}
+
+/// Puts the banks of `named` and their peers into the open proof. A peer of
+/// the proof vouches for nothing else, and when none of the banks arrives by
+/// the deadline, `settle_proof` distrusts it. True when `saved` changed.
+pub fn open_proof(
+    saved: &mut Saved,
+    named: &[Checkpoint],
+    attesters: impl Fn(&BankHash) -> Vec<NodeId>,
+    tip_height: u64,
+) -> bool {
+    let mut proof = saved.proof.clone().unwrap_or(Proof {
+        bank_hashes: Vec::new(),
+        nodes: Vec::new(),
+        deadline_height: tip_height.saturating_add(PROOF_BLOCKS),
+    });
+    for checkpoint in named {
+        if !proof.bank_hashes.contains(&checkpoint.bank_hash) {
+            proof.bank_hashes.push(checkpoint.bank_hash);
+        }
+        for node in attesters(&checkpoint.bank_hash) {
+            if !proof.nodes.contains(&node) {
+                proof.nodes.push(node);
+            }
+        }
+    }
+    let changed = saved.proof.as_ref() != Some(&proof);
+    saved.proof = Some(proof);
+    changed
+}
+
+/// The deposit credits of a bank, checked against the active eCash chain.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Deposits {
+    /// The active eCash chain holds every credit of the bank, through
+    /// `credited_height`.
+    Credited { credited_height: u64, lag: u64 },
+    /// The active eCash chain dropped a block whose deposits the bank
+    /// credited.
+    Dropped,
+    /// The bank holds no bridge config, or the view does not hold the
+    /// credited block.
+    Unknown,
+}
+
+/// Checks the credits of a bank: the credited block, and the block of the
+/// parts so far at the next height. `active_block` gives the hash of the
+/// active eCash block at a height, when the view holds it.
+pub fn check_deposits(
+    credits: Option<Credits>,
+    mut active_block: impl FnMut(u64) -> Option<BlockHash>,
+) -> Deposits {
+    let Some(credits) = credits else {
+        return Deposits::Unknown;
+    };
+    let blocks = [
+        (credits.credited_height, credits.credited_block),
+        (
+            credits.credited_height.saturating_add(1),
+            credits.part_block,
+        ),
+    ];
+    let mut unknown = false;
+    for (height, block) in blocks.into_iter().filter(|(_, block)| *block != [0u8; 32]) {
+        match active_block(height) {
+            Some(hash) if hash == block => (),
+            Some(_) => return Deposits::Dropped,
+            None => unknown = true,
+        }
+    }
+    if unknown {
+        return Deposits::Unknown;
+    }
+    Deposits::Credited {
+        credited_height: credits.credited_height,
+        lag: credits.lag,
+    }
+}
+
+/// Rule 3 for the settle of a checkpoint at eCash height `height` for the
+/// block of a record entry: the same check as `screen`. `None` means not
+/// ready, the same as a pending checkpoint.
+pub fn record_answer(
+    block: &RecordedBlock,
+    lag: u64,
+    height: u64,
+    active_block: impl FnMut(u64) -> Option<BlockHash>,
+) -> Option<RecordAnswer> {
+    if block.credited_height.saturating_add(lag) < height {
+        return Some(RecordAnswer {
+            credited_height: block.credited_height,
+            credits_active: false,
+        });
+    }
+    let credits_active = match check_deposits(Some(block.credits(lag)), active_block) {
+        Deposits::Credited { .. } => true,
+        Deposits::Dropped => false,
+        Deposits::Unknown if block.credited_height.saturating_add(lag) < height => false,
+        Deposits::Unknown => return None,
+    };
+    Some(RecordAnswer {
+        credited_height: block.credited_height,
+        credits_active,
+    })
+}
+
+/// Why a checkpoint does not count.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Rejection {
+    /// The bank credited the deposits only through this eCash height.
+    TooFewCredits(u64),
+    /// The active eCash chain dropped a block that the bank credited.
+    Dropped,
+    /// The bank is a saved anchor that left the block record of the root,
+    /// so this node cannot check its credits for a later checkpoint.
+    OutOfRecord,
+}
+
+/// The checkpoints after rules 3 and 4.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Screened {
+    /// The checkpoints that count.
+    pub counted: Vec<Checkpoint>,
+    /// The checkpoints whose bank this node does not hold.
+    pub absent: Vec<Checkpoint>,
+    /// The heights of the checkpoints whose credits the view cannot check yet.
+    pub pending: Vec<u64>,
+    pub rejected: Vec<(Checkpoint, Rejection)>,
+}
+
+/// The deposit credits of a block in the block record of the root.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Ancestor {
+    pub credited_height: u64,
+    pub lag: u64,
+    pub deposits: Deposits,
+}
+
+/// The banks below the root that this node holds.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct BelowRoot {
+    /// The saved anchors. Each one counts only its own checkpoint.
+    pub anchors: Vec<Anchor>,
+    /// The blocks of the block record of the root.
+    pub ancestors: HashMap<BankHash, Ancestor>,
+}
+
+impl BelowRoot {
+    /// Checks the credits of each block of the block record against the
+    /// active eCash chain. `lag` is the deposit lag of the root bank.
+    pub fn new(
+        anchors: &[Anchor],
+        record: &[RecordedBlock],
+        lag: Option<u64>,
+        mut active_block: impl FnMut(u64) -> Option<BlockHash>,
+    ) -> Self {
+        let ancestors = lag
+            .map(|lag| {
+                record
+                    .iter()
+                    .map(|block| {
+                        let ancestor = Ancestor {
+                            credited_height: block.credited_height,
+                            lag,
+                            deposits: check_deposits(Some(block.credits(lag)), &mut active_block),
+                        };
+                        (block.bank_hash, ancestor)
+                    })
+                    .collect()
+            })
+            .unwrap_or_default();
+        Self {
+            anchors: anchors.to_vec(),
+            ancestors,
+        }
+    }
+
+    /// True when a saved anchor or a block of the block record has this bank hash.
+    pub fn holds(&self, bank_hash: &BankHash) -> bool {
+        self.ancestors.contains_key(bank_hash)
+            || self
+                .anchors
+                .iter()
+                .any(|anchor| anchor.bank_hash == *bank_hash)
+    }
+}
+
+/// Applies rules 3 and 4 to the checkpoints. `deposits` holds the credits of
+/// each frozen bank. A checkpoint for a bank below the root counts when it is
+/// the checkpoint of a saved anchor, or when it passes rule 3 for its block of
+/// the block record. Only a bank that this node does not hold is absent.
+pub fn screen(
+    checkpoints: &[Checkpoint],
+    deposits: &HashMap<BankHash, Deposits>,
+    below_root: &BelowRoot,
+) -> Screened {
+    let mut screened = Screened::default();
+    for checkpoint in checkpoints {
+        match deposits.get(&checkpoint.bank_hash) {
+            None if below_root
+                .anchors
+                .iter()
+                .any(|anchor| anchor.matches(checkpoint)) =>
+            {
+                screened.counted.push(*checkpoint)
+            }
+            None => match below_root.ancestors.get(&checkpoint.bank_hash) {
+                None if below_root.holds(&checkpoint.bank_hash) => screened
+                    .rejected
+                    .push((*checkpoint, Rejection::OutOfRecord)),
+                None => screened.absent.push(*checkpoint),
+                Some(ancestor)
+                    if ancestor.credited_height.saturating_add(ancestor.lag)
+                        < checkpoint.height =>
+                {
+                    screened.rejected.push((
+                        *checkpoint,
+                        Rejection::TooFewCredits(ancestor.credited_height),
+                    ))
+                }
+                Some(ancestor) => match ancestor.deposits {
+                    Deposits::Credited { .. } => screened.counted.push(*checkpoint),
+                    Deposits::Dropped => screened.rejected.push((*checkpoint, Rejection::Dropped)),
+                    Deposits::Unknown => screened.pending.push(checkpoint.height),
+                },
+            },
+            Some(Deposits::Unknown) => screened.pending.push(checkpoint.height),
+            Some(Deposits::Dropped) => screened.rejected.push((*checkpoint, Rejection::Dropped)),
+            Some(Deposits::Credited {
+                credited_height,
+                lag,
+            }) => {
+                if credited_height.saturating_add(*lag) >= checkpoint.height {
+                    screened.counted.push(*checkpoint);
+                } else {
+                    screened
+                        .rejected
+                        .push((*checkpoint, Rejection::TooFewCredits(*credited_height)));
+                }
+            }
+        }
+    }
+    screened
+}
+
+/// True when a pending checkpoint came less than `fallback_blocks` eCash
+/// blocks ago. Such a checkpoint stops the fallback.
+pub fn pending_stops_fallback(pending: &[u64], tip_height: u64, params: Params) -> bool {
+    pending
+        .iter()
+        .any(|height| tip_height.saturating_sub(*height) < params.fallback_blocks)
+}
+
+/// A node that said it holds a bank, and the eCash height until which this
+/// node does not believe it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Distrust {
+    pub node: NodeId,
+    pub until_height: u64,
+}
+
+/// The banks that a restart or a stopped fallback named, and the nodes that
+/// said they hold them. When none of the banks arrives by `deadline_height`,
+/// this node distrusts those nodes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Proof {
+    pub bank_hashes: Vec<BankHash>,
+    pub nodes: Vec<NodeId>,
+    pub deadline_height: u64,
+}
+
+/// The eCash blocks after a proof opens in which one of its banks must arrive.
+pub const PROOF_BLOCKS: u64 = 12;
+
+/// A node whose proof brought no bank does not count for this many eCash
+/// blocks.
+pub const DISTRUST_BLOCKS: u64 = 1008;
+
+/// The absent checkpoints whose bank staked peers with more than a third of
+/// `total_stake` hold. `stake` gives the epoch stake of a node. A peer in
+/// `distrusted` does not count, and a peer in the open proof counts only for
+/// the banks of that proof.
+pub fn vouched(
+    absent: &[Checkpoint],
+    attesters: impl Fn(&BankHash) -> Vec<NodeId>,
+    stake: impl Fn(&NodeId) -> u64,
+    total_stake: u64,
+    saved: &Saved,
+    tip_height: u64,
+) -> Vec<Checkpoint> {
+    // A node of the open proof still counts for the banks of that proof.
+    let doubted = |node: &NodeId, bank_hash: &BankHash| {
+        saved.proof.as_ref().is_some_and(|proof| {
+            proof.nodes.contains(node) && !proof.bank_hashes.contains(bank_hash)
+        }) || saved
+            .distrusted
+            .iter()
+            .any(|distrust| &distrust.node == node && distrust.until_height > tip_height)
+    };
+    absent
+        .iter()
+        .filter(|checkpoint| {
+            let mut nodes = attesters(&checkpoint.bank_hash);
+            nodes.sort_unstable();
+            nodes.dedup();
+            let held: u128 = nodes
+                .iter()
+                .filter(|node| !doubted(node, &checkpoint.bank_hash))
+                .map(|node| u128::from(stake(node)))
+                .sum();
+            held.saturating_mul(3) > u128::from(total_stake)
+        })
+        .copied()
+        .collect()
+}
+
+/// Settles the open proof: a bank of the proof that this node now holds
+/// closes it, and a passed deadline makes its nodes distrusted. True when
+/// `saved` changed.
+pub fn settle_proof(saved: &mut Saved, holds: impl Fn(&BankHash) -> bool, tip_height: u64) -> bool {
+    let Some(proof) = &saved.proof else {
+        return false;
+    };
+    if proof.bank_hashes.iter().any(holds) {
+        saved.proof = None;
+        return true;
+    }
+    if tip_height < proof.deadline_height {
+        return false;
+    }
+    let until_height = tip_height.saturating_add(DISTRUST_BLOCKS);
+    let nodes = proof.nodes.clone();
+    saved
+        .distrusted
+        .retain(|distrust| distrust.until_height > tip_height && !nodes.contains(&distrust.node));
+    saved.distrusted.extend(
+        nodes
+            .into_iter()
+            .map(|node| Distrust { node, until_height }),
+    );
+    saved.proof = None;
+    true
+}
+
+/// The bank to build on in place of `candidate`, when the path from
+/// `candidate` down to the root holds a bank in `dropped`. It is the highest
+/// bank at or above the parent of the lowest such bank with no bank of
+/// `dropped` on its own path. `None` when the path holds no such bank.
+pub fn avoid_dropped(
+    root: Slot,
+    banks: &[ForkBank],
+    dropped: &HashSet<Slot>,
+    candidate: Slot,
+) -> Option<Slot> {
+    let tree = Tree::new(banks);
+    let lowest = tree
+        .path(candidate, root)
+        .filter(|slot| dropped.contains(slot))
+        .min()?;
+    let base = tree.parent.get(&lowest).copied().flatten()?;
+    banks
+        .iter()
+        .map(|bank| bank.slot)
+        .filter(|slot| {
+            tree.descends(*slot, base)
+                && !tree.path(*slot, base).any(|step| dropped.contains(&step))
+        })
+        .max()
+}
+
+/// A request to restart from a snapshot at or below `anchor.slot`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Restart {
+    pub anchor: Anchor,
+    /// The highest eCash height of the unknown checkpoints that caused it.
+    pub trigger_height: u64,
+}
+
+/// A checkpoint for a bank that a root move pruned.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Pruned {
+    pub checkpoint: Checkpoint,
+    /// The eCash height and block of the newest checkpoint that beat it.
+    /// `None` in a state file from before this field.
+    pub winner: Option<(u64, BlockHash)>,
+}
+
+impl Pruned {
+    /// True while the checkpoint that beat it stays on the active eCash
+    /// chain. After an eCash reorg drops that checkpoint, the pruned one
+    /// counts again.
+    pub fn is_lost(&self, checkpoints: &[Checkpoint]) -> bool {
+        self.winner.is_none_or(|(height, block_hash)| {
+            checkpoints.iter().any(|checkpoint| {
+                checkpoint.height == height && checkpoint.block_hash == block_hash
+            })
+        })
+    }
+}
+
+/// The saved anchors and the anchors that the block record of the root
+/// gives: each active checkpoint for an ancestor of the root in that record.
+fn known_anchors(
+    saved: &Saved,
+    ancestors: &[RecordedBlock],
+    checkpoints: &[Checkpoint],
+) -> Vec<Anchor> {
+    let recorded: HashMap<BankHash, Slot> = ancestors
+        .iter()
+        .map(|block| (block.bank_hash, block.slot))
+        .collect();
+    saved
+        .anchors
+        .iter()
+        .copied()
+        .chain(checkpoints.iter().filter_map(|checkpoint| {
+            recorded.get(&checkpoint.bank_hash).map(|slot| Anchor {
+                slot: *slot,
+                bank_hash: checkpoint.bank_hash,
+                height: checkpoint.height,
+                block_hash: checkpoint.block_hash,
+            })
+        }))
+        .collect()
+}
+
+/// The newest saved anchor on the chain of the root: the root itself, a
+/// block of its block record, or a slot that the ledger roots with the same
+/// bank hash, all by slot and bank hash. A slot number alone can name a block
+/// of an abandoned branch.
+pub fn final_from_anchors(
+    anchors: &[Anchor],
+    root: (Slot, BankHash),
+    record: &[RecordedBlock],
+    rooted: impl Fn(Slot, &BankHash) -> bool,
+) -> Option<Slot> {
+    let on_chain: HashSet<(Slot, BankHash)> = record
+        .iter()
+        .map(|block| (block.slot, block.bank_hash))
+        .chain(std::iter::once(root))
+        .collect();
+    anchors
+        .iter()
+        .filter(|anchor| {
+            anchor.slot <= root.0
+                && (on_chain.contains(&(anchor.slot, anchor.bank_hash))
+                    || rooted(anchor.slot, &anchor.bank_hash))
+        })
+        .map(|anchor| anchor.slot)
+        .max()
+}
+
+/// Finds a branch that splits behind the root and holds more checkpoints than
+/// this branch.
+///
+/// The root can pass the newest active anchor in two ways: the stake votes
+/// moved it in a fallback, or an eCash reorg removed a newer anchor. If more
+/// checkpoints above the split name banks that this node does not know, the
+/// node must replay from a snapshot at or below an anchor below the split.
+/// Unknown checkpoints at or below `saved.handled_height` caused an earlier
+/// restart, and they cannot cause another. `ancestors` is the block record of
+/// the root.
+///
+/// No shared data gives the slot of the split, so the eCash height of the
+/// first unknown checkpoint stands for it. The anchor is the newest active
+/// anchor below that height. Without one, it is the newest saved anchor below
+/// that height. A node without a saved anchor replays from `saved.base`, the
+/// root of its first start.
+///
+/// `credited_tip` is the highest eCash height that a frozen bank credited. An
+/// unknown checkpoint above it can name a bank that a node in catch-up did
+/// not replay yet, so it causes no restart.
+#[allow(clippy::too_many_arguments)]
+pub fn restart(
+    root: Slot,
+    banks: &[ForkBank],
+    checkpoints: &[Checkpoint],
+    tip_height: u64,
+    saved: &Saved,
+    ancestors: &[RecordedBlock],
+    credited_tip: u64,
+    params: Params,
+) -> Option<Restart> {
+    let anchors = known_anchors(saved, ancestors, checkpoints);
+    let base = saved
+        .anchors
+        .is_empty()
+        .then_some(saved.base)
+        .flatten()
+        .map(|base| Anchor {
+            slot: base.slot,
+            bank_hash: [0u8; 32],
+            height: base.credited_height,
+            block_hash: [0u8; 32],
+        });
+    let floor = anchors
+        .iter()
+        .chain(base.iter())
+        .map(|anchor| anchor.height)
+        .min()?;
+    let lost: HashSet<BankHash> = saved
+        .pruned
+        .iter()
+        .filter(|pruned| pruned.is_lost(checkpoints))
+        .map(|pruned| pruned.checkpoint.bank_hash)
+        .collect();
+    let known: HashSet<BankHash> = banks
+        .iter()
+        .map(|bank| bank.hash)
+        .chain(anchors.iter().map(|anchor| anchor.bank_hash))
+        .chain(ancestors.iter().map(|block| block.bank_hash))
+        .chain(lost.iter().copied())
+        .collect();
+    let theirs: Vec<u64> = checkpoints
+        .iter()
+        .filter(|checkpoint| {
+            checkpoint.height > floor
+                && !known.contains(&checkpoint.bank_hash)
+                && checkpoint.height <= credited_tip
+                && tip_height.saturating_sub(checkpoint.height) >= params.root_depth
+        })
+        .map(|checkpoint| checkpoint.height)
+        .collect();
+    let split_height = *theirs.iter().min()?;
+    let below_split = |anchor: &&Anchor| anchor.height < split_height;
+    let anchor = anchors
+        .iter()
+        .filter(below_split)
+        .filter(|anchor| anchor.is_active(checkpoints))
+        .max_by_key(|anchor| anchor.slot)
+        .or_else(|| {
+            saved
+                .anchors
+                .iter()
+                .filter(below_split)
+                .max_by_key(|anchor| anchor.slot)
+        })
+        .or(base.as_ref().filter(below_split))
+        .copied()?;
+    if anchor.slot >= root {
+        return None;
+    }
+    let ours = checkpoints
+        .iter()
+        .filter(|checkpoint| {
+            checkpoint.height > split_height
+                && known.contains(&checkpoint.bank_hash)
+                && !lost.contains(&checkpoint.bank_hash)
+        })
+        .count();
+    let trigger_height = *theirs.iter().max()?;
+    (theirs.len() > ours && trigger_height > saved.handled_height).then_some(Restart {
+        anchor,
+        trigger_height,
+    })
+}
+
+/// A restart request when the root bank credited deposits of an eCash block
+/// that the active chain dropped. No leader can build beside the root, so the
+/// node restarts at the newest anchor below the root that the active chain
+/// still holds. Its bank came before the dropped credit, because a credit
+/// waits for confirmations and the anchor block is older than the dropped
+/// block. Each eCash tip asks for one restart at most.
+pub fn restart_for_dropped_root(
+    root: Slot,
+    checkpoints: &[Checkpoint],
+    saved: &Saved,
+    ancestors: &[RecordedBlock],
+    tip_height: u64,
+) -> Option<Restart> {
+    if tip_height <= saved.handled_height {
+        return None;
+    }
+    let anchor = known_anchors(saved, ancestors, checkpoints)
+        .into_iter()
+        .filter(|anchor| anchor.slot < root && anchor.is_active(checkpoints))
+        .max_by_key(|anchor| anchor.slot)?;
+    Some(Restart {
+        anchor,
+        trigger_height: tip_height,
+    })
+}
+
+/// Keeps the pruned checkpoints that the view can still hold.
+pub fn retain_pruned(pruned: &mut Vec<Pruned>, tip_height: u64) {
+    let floor = tip_height.saturating_sub(ANCHOR_WINDOW);
+    pruned.retain(|pruned| pruned.checkpoint.height >= floor);
+    pruned.sort_by_key(|pruned| pruned.checkpoint.height);
+    pruned.dedup();
+}
+
+/// Keeps the anchors that the view can still check, and always the newest.
+pub fn retain_anchors(anchors: &mut Vec<Anchor>, tip_height: u64) {
+    let newest = anchors.iter().map(|anchor| anchor.slot).max();
+    let floor = tip_height.saturating_sub(ANCHOR_WINDOW);
+    anchors.retain(|anchor| anchor.height >= floor || Some(anchor.slot) == newest);
+    anchors.sort_by_key(|anchor| (anchor.slot, anchor.height));
+    anchors.dedup();
+}
+
+struct Tree {
+    parent: HashMap<Slot, Option<Slot>>,
+    hash: HashMap<Slot, BankHash>,
+    slot: HashMap<BankHash, Slot>,
+}
+
+impl Tree {
+    fn new(banks: &[ForkBank]) -> Self {
+        Self {
+            parent: banks.iter().map(|bank| (bank.slot, bank.parent)).collect(),
+            hash: banks.iter().map(|bank| (bank.slot, bank.hash)).collect(),
+            slot: banks.iter().map(|bank| (bank.hash, bank.slot)).collect(),
+        }
+    }
+
+    fn slot_of(&self, hash: &BankHash) -> Option<Slot> {
+        self.slot.get(hash).copied()
+    }
+
+    fn hash(&self, slot: Slot) -> BankHash {
+        self.hash.get(&slot).copied().unwrap_or_default()
+    }
+
+    /// True when `slot` is `ancestor` or one of its descendants.
+    fn descends(&self, slot: Slot, ancestor: Slot) -> bool {
+        self.path(slot, ancestor.saturating_sub(1))
+            .any(|step| step == ancestor)
+    }
+
+    /// The slots from `slot` down to the slot above `root`.
+    fn path(&self, slot: Slot, root: Slot) -> impl Iterator<Item = Slot> + '_ {
+        std::iter::successors(Some(slot), |slot| self.parent.get(slot).copied().flatten())
+            .take_while(move |slot| *slot > root)
+    }
+
+    /// The checkpoints on the path from `slot` down to the slot above `root`.
+    fn count(
+        &self,
+        slot: Slot,
+        root: Slot,
+        direct: &HashMap<Slot, usize>,
+        memo: &mut HashMap<Slot, usize>,
+    ) -> usize {
+        let mut unknown = Vec::new();
+        let mut base = 0;
+        for step in self.path(slot, root) {
+            if let Some(known) = memo.get(&step) {
+                base = *known;
+                break;
+            }
+            unknown.push(step);
+        }
+        for step in unknown.into_iter().rev() {
+            base = base.saturating_add(direct.get(&step).copied().unwrap_or_default());
+            memo.insert(step, base);
+        }
+        base
+    }
+}
+
+/// The root of the first start of a node, and the eCash height that its bank
+/// credited. A checkpoint at or below that height came before the root.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Base {
+    pub slot: Slot,
+    pub credited_height: u64,
+}
+
+/// What a node keeps on disk between two runs.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Saved {
+    pub anchors: Vec<Anchor>,
+    pub pruned: Vec<Pruned>,
+    /// The root of the first start of the node: the genesis or the snapshot
+    /// that it joined from.
+    pub base: Option<Base>,
+    /// Unknown checkpoints up to this eCash height caused a restart before.
+    pub handled_height: u64,
+    /// The next start must load a snapshot at or below this slot.
+    pub restart_to: Option<Slot>,
+    /// The banks of the open proof, until one of them arrives.
+    pub proof: Option<Proof>,
+    pub distrusted: Vec<Distrust>,
+}
+
+impl Saved {
+    /// Reads the state file in `ledger`. A missing file gives the default.
+    pub fn load(ledger: &Path) -> io::Result<Self> {
+        let text = match fs::read_to_string(ledger.join(STATE_FILE)) {
+            Ok(text) => text,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Self::default()),
+            Err(error) => return Err(error),
+        };
+        Self::parse(&text).ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("{} holds a bad line", ledger.join(STATE_FILE).display()),
+            )
+        })
+    }
+
+    /// Drops the anchors above `slot`, which a rollback to `slot` abandons.
+    pub fn drop_anchors_above(&mut self, slot: Slot) {
+        self.anchors.retain(|anchor| anchor.slot <= slot);
+    }
+
+    /// Writes the state file in `ledger` in one rename.
+    pub fn store(&self, ledger: &Path) -> io::Result<()> {
+        let path = ledger.join(STATE_FILE);
+        let temp = ledger.join(format!("{STATE_FILE}.tmp"));
+        let mut file = fs::File::create(&temp)?;
+        file.write_all(self.render().as_bytes())?;
+        file.sync_all()?;
+        fs::rename(temp, path)
+    }
+
+    fn render(&self) -> String {
+        let mut text = String::new();
+        for anchor in &self.anchors {
+            text.push_str(&format!(
+                "anchor {} {} {} {}\n",
+                anchor.slot,
+                to_hex(&anchor.bank_hash),
+                anchor.height,
+                to_hex(&anchor.block_hash)
+            ));
+        }
+        for pruned in &self.pruned {
+            let checkpoint = &pruned.checkpoint;
+            text.push_str(&format!(
+                "pruned {} {} {}",
+                checkpoint.height,
+                to_hex(&checkpoint.bank_hash),
+                to_hex(&checkpoint.block_hash)
+            ));
+            if let Some((height, block_hash)) = pruned.winner {
+                text.push_str(&format!(" {height} {}", to_hex(&block_hash)));
+            }
+            text.push('\n');
+        }
+        if let Some(base) = self.base {
+            text.push_str(&format!("base {} {}\n", base.slot, base.credited_height));
+        }
+        text.push_str(&format!("handled {}\n", self.handled_height));
+        if let Some(slot) = self.restart_to {
+            text.push_str(&format!("restart {slot}\n"));
+        }
+        if let Some(proof) = &self.proof {
+            let list = |items: &[[u8; 32]]| {
+                if items.is_empty() {
+                    "-".to_owned()
+                } else {
+                    items.iter().map(to_hex).collect::<Vec<_>>().join(",")
+                }
+            };
+            text.push_str(&format!(
+                "proof {} {} {}\n",
+                proof.deadline_height,
+                list(&proof.bank_hashes),
+                list(&proof.nodes)
+            ));
+        }
+        for distrust in &self.distrusted {
+            text.push_str(&format!(
+                "distrust {} {}\n",
+                to_hex(&distrust.node),
+                distrust.until_height
+            ));
+        }
+        text
+    }
+
+    fn parse(text: &str) -> Option<Self> {
+        let mut saved = Self::default();
+        for line in text.lines().filter(|line| !line.trim().is_empty()) {
+            let words: Vec<&str> = line.split_whitespace().collect();
+            match words.as_slice() {
+                ["anchor", slot, bank_hash, height, block_hash] => saved.anchors.push(Anchor {
+                    slot: slot.parse().ok()?,
+                    bank_hash: from_hex(bank_hash)?,
+                    height: height.parse().ok()?,
+                    block_hash: from_hex(block_hash)?,
+                }),
+                ["pruned", height, bank_hash, block_hash, winner @ ..] => {
+                    let winner = match winner {
+                        [] => None,
+                        [winner_height, winner_block] => {
+                            Some((winner_height.parse().ok()?, from_hex(winner_block)?))
+                        }
+                        _ => return None,
+                    };
+                    saved.pruned.push(Pruned {
+                        checkpoint: Checkpoint {
+                            height: height.parse().ok()?,
+                            block_hash: from_hex(block_hash)?,
+                            bank_hash: from_hex(bank_hash)?,
+                        },
+                        winner,
+                    })
+                }
+                ["base", slot, credited_height] => {
+                    saved.base = Some(Base {
+                        slot: slot.parse().ok()?,
+                        credited_height: credited_height.parse().ok()?,
+                    })
+                }
+                ["handled", height] => saved.handled_height = height.parse().ok()?,
+                ["restart", slot] => saved.restart_to = Some(slot.parse().ok()?),
+                ["proof", deadline_height, bank_hashes, nodes] => {
+                    let list = |text: &str| -> Option<Vec<[u8; 32]>> {
+                        if text == "-" {
+                            return Some(Vec::new());
+                        }
+                        text.split(',').map(from_hex).collect()
+                    };
+                    saved.proof = Some(Proof {
+                        bank_hashes: list(bank_hashes)?,
+                        nodes: list(nodes)?,
+                        deadline_height: deadline_height.parse().ok()?,
+                    })
+                }
+                ["distrust", node, until_height] => saved.distrusted.push(Distrust {
+                    node: from_hex(node)?,
+                    until_height: until_height.parse().ok()?,
+                }),
+                _ => return None,
+            }
+        }
+        Some(saved)
+    }
+}
+
+pub(crate) fn to_hex(bytes: &[u8; 32]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+pub(crate) fn from_hex(text: &str) -> Option<[u8; 32]> {
+    if text.len() != 64 {
+        return None;
+    }
+    let mut bytes = [0u8; 32];
+    for (byte, pair) in bytes.iter_mut().zip(text.as_bytes().chunks(2)) {
+        *byte = u8::from_str_radix(std::str::from_utf8(pair).ok()?, 16).ok()?;
+    }
+    Some(bytes)
+}
+
+/// The slot of a full snapshot archive, or the slot of an incremental one.
+fn archive_slot(name: &str) -> Option<Slot> {
+    let rest = name
+        .strip_prefix("incremental-snapshot-")
+        .map(|rest| rest.split_once('-').map(|(_, rest)| rest))
+        .unwrap_or_else(|| name.strip_prefix("snapshot-"))?;
+    rest.split_once('-')?.0.parse().ok()
+}
+
+fn is_full_archive(name: &str) -> bool {
+    name.starts_with("snapshot-")
+}
+
+/// The highest full snapshot archive slot in `dir` at or below `slot`.
+pub fn highest_full_archive_at_or_below(dir: &Path, slot: Slot) -> io::Result<Option<Slot>> {
+    let mut highest = None;
+    for entry in fs::read_dir(dir)? {
+        let name = entry?.file_name();
+        let Some(name) = name.to_str() else { continue };
+        if let Some(archive) = archive_slot(name).filter(|_| is_full_archive(name))
+            && archive <= slot
+        {
+            highest = highest.max(Some(archive));
+        }
+    }
+    Ok(highest)
+}
+
+/// Moves every snapshot archive in `dirs` above `slot` into `aside`, so the
+/// next start loads an older one. Nothing gets deleted. Returns the moved
+/// paths.
+pub fn set_aside_archives_above(
+    dirs: &[&Path],
+    slot: Slot,
+    aside: &Path,
+) -> io::Result<Vec<PathBuf>> {
+    let mut moved = Vec::new();
+    for dir in dirs {
+        for entry in fs::read_dir(dir)? {
+            let path = entry?.path();
+            let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+                continue;
+            };
+            if archive_slot(name).is_some_and(|archive| archive > slot) {
+                fs::create_dir_all(aside)?;
+                let target = aside.join(name);
+                fs::rename(&path, &target)?;
+                moved.push(target);
+            }
+        }
+    }
+    Ok(moved)
+}
