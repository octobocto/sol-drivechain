+//! The eCash view of a SOL drivechain validator.
+//!
+//! Each validator reads the active eCash chain from its own enforcer. Before a
+//! `settle_bmm(H, M, S)` runs, the runtime asks this view: is block M the
+//! active block at height H, deep enough, and which commitment does its
+//! coinbase hold for the sidechain? The bank adds if Solana block S is in its
+//! block record. The answer goes into the `BmmAnswer` account of that tx.
+//!
+//! Before a `credit_deposits(H, M, first, count)` runs, the runtime asks this
+//! view for the deposits of block M at height H. The answer goes into the
+//! `DepositAnswer` account of that tx.
+
+pub mod answers;
+#[cfg(feature = "poller")]
+mod enforcer;
+pub mod fork_choice;
+pub mod held;
+pub mod pairs;
+pub mod peers;
+#[cfg(feature = "poller")]
+mod poller;
+#[cfg(feature = "poller")]
+mod push;
+
+#[cfg(feature = "poller")]
+pub use {poller::start_poller, push::start_pair_push};
+use {
+    solana_pubkey::Pubkey,
+    std::{
+        collections::{BTreeMap, HashMap},
+        sync::{
+            Arc, Condvar, Mutex, OnceLock,
+            atomic::{AtomicBool, Ordering},
+        },
+        time::{Duration, Instant},
+    },
+};
+
+/// The bridge program of the SOL drivechain.
+pub const BRIDGE_PROGRAM_ID: Pubkey =
+    Pubkey::from_str_const("ARA8mQfWk85ULDLAujy3b8gLknFF2QzrsAKHYbc8beu");
+
+/// The account that holds the pre-check answer for one tx. The runtime builds
+/// it for each tx, the same way as the instructions sysvar.
+pub const BMM_ANSWER_ID: Pubkey =
+    Pubkey::from_str_const("BmmAnswer1111111111111111111111111111111111");
+
+/// The account that holds the answer for one `bundle_paid`. The runtime
+/// builds it for each tx, the same way as the instructions sysvar.
+pub const BMM_PAID_ID: Pubkey =
+    Pubkey::from_str_const("BmmPaid111111111111111111111111111111111111");
+
+/// The length of the `BmmPaid` data: height, block hash, M6ID, status, and
+/// the height of the Succeeded event.
+pub const BMM_PAID_LEN: usize = 8 + 32 + 32 + 1 + 8;
+
+/// The Anchor discriminator of `bundle_paid`:
+/// sha256("global:bundle_paid")[..8].
+pub const BUNDLE_PAID_DISCRIMINATOR: [u8; 8] = [252, 58, 105, 195, 106, 211, 35, 52];
+
+/// The ID of a withdrawal bundle, in the byte order of its ConsensusHex.
+pub type M6id = [u8; 32];
+
+/// The account that holds the block record: the last block of each
+/// `BLOCK_RECORD_STRIDE` slots on the fork, for `BLOCK_RECORD_ENTRIES`
+/// strides. A settle can pay only a commitment to a block in this record. The
+/// genesis holds this account at `BLOCK_RECORD_LEN` bytes and rent-exempt.
+pub const BMM_BLOCKS_ID: Pubkey =
+    Pubkey::from_str_const("BmmB1ocks1111111111111111111111111111111111");
+
+pub const BLOCK_RECORD_STRIDE: u64 = 32;
+pub const BLOCK_RECORD_ENTRIES: usize = 2048;
+
+/// One entry: the slot, the bank hash, the credited eCash height, the
+/// credited eCash block, and the eCash block of the parts so far.
+const BLOCK_RECORD_ENTRY_LEN: usize = 8 + 32 + 8 + 32 + 32;
+pub const BLOCK_RECORD_LEN: usize = BLOCK_RECORD_ENTRIES * BLOCK_RECORD_ENTRY_LEN;
+
+/// One block of a block record, with the deposit credits of its bank.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RecordedBlock {
+    pub slot: u64,
+    pub bank_hash: [u8; 32],
+    pub credited_height: u64,
+    pub credited_block: BlockHash,
+    pub part_block: BlockHash,
+}
+
+impl RecordedBlock {
+    /// The credits of the bank of this block, with the lag of the bridge
+    /// config.
+    pub fn credits(&self, lag: u64) -> Credits {
+        Credits {
+            credited_height: self.credited_height,
+            credited_block: self.credited_block,
+            part_block: self.part_block,
+            lag,
+        }
+    }
+}
+
+/// The account that holds the deposits of one eCash block for one
+/// `credit_deposits`. The runtime builds it for each tx, the same way as the
+/// instructions sysvar.
+pub const DEPOSIT_ANSWER_ID: Pubkey =
+    Pubkey::from_str_const("DepositAnswer111111111111111111111111111111");
+
+/// The seed of the treasury PDA, which collects every transaction fee.
+pub const TREASURY_SEED: &[u8] = b"treasury";
+
+/// The seed of the bridge config PDA.
+pub const CONFIG_SEED: &[u8] = b"config";
+
+/// The Anchor discriminator of the bridge `Config` account:
+/// sha256("account:Config")[..8].
+pub const CONFIG_DISCRIMINATOR: [u8; 8] = [155, 12, 170, 224, 30, 250, 204, 130];
+
+/// The offsets of the deposit fields in the bridge `Config` account. The
+/// bridge tests read the account at these offsets.
+const CONFIG_BMM_NEXT_HEIGHT: usize = 64;
+const CONFIG_DEPOSIT_CONFIRMATIONS: usize = 80;
+const CONFIG_DEPOSIT_LAG: usize = 88;
+const CONFIG_CREDITED_HEIGHT: usize = 96;
+const CONFIG_CREDITED_BLOCK: usize = 104;
+const CONFIG_CREDITED_BLOCK_END: usize = 136;
+const CONFIG_CREDIT_INDEX: usize = 136;
+const CONFIG_CREDIT_PART_BLOCK: usize = 144;
+const CONFIG_CREDIT_PART_BLOCK_END: usize = 176;
+
+/// The Anchor discriminator of `credit_deposits`:
+/// sha256("global:credit_deposits")[..8].
+pub const CREDIT_DEPOSITS_DISCRIMINATOR: [u8; 8] = [81, 116, 1, 140, 214, 108, 237, 178];
+
+/// The head of the `DepositAnswer` data: height, block hash, parent hash,
+/// deposit count of the block, first index, entry count.
+pub const DEPOSIT_ANSWER_HEAD_LEN: usize = 8 + 32 + 32 + 4 + 4 + 1;
+
+/// One `DepositAnswer` entry: sequence number, value in sats, a flag, and the
+/// target pubkey.
+pub const DEPOSIT_ANSWER_ENTRY_LEN: usize = 8 + 8 + 1 + 32;
+
+/// The Anchor discriminator of `settle_bmm`: sha256("global:settle_bmm")[..8].
+pub const SETTLE_BMM_DISCRIMINATOR: [u8; 8] = [223, 214, 151, 212, 138, 42, 77, 15];
+
+/// N when the genesis holds no `BmmParams` account.
+pub const DEFAULT_CONFIRMATIONS: u64 = 6;
+
+/// The account that holds the BMM values of the cluster. Only the genesis
+/// writes it, so every validator reads the same values.
+pub const BMM_PARAMS_ID: Pubkey =
+    Pubkey::from_str_const("BmmParams1111111111111111111111111111111111");
+
+const PARAMS_MAGIC: [u8; 8] = *b"bmmprm01";
+pub const PARAMS_LEN: usize = 8 + 1 + 8 + 8 + 8;
+
+/// The BMM values of the cluster, from the genesis.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ChainParams {
+    /// The BIP300 slot of the sidechain on eCash.
+    pub sidechain_slot: u8,
+    /// N, the eCash blocks on top of a block before its settle.
+    pub confirmations: u64,
+    /// K, the eCash blocks on top of a checkpoint before it becomes a root.
+    pub root_depth: u64,
+    /// L, the eCash blocks without a checkpoint before the stake votes root.
+    pub fallback_blocks: u64,
+}
+
+impl ChainParams {
+    pub fn to_data(&self) -> [u8; PARAMS_LEN] {
+        let mut data = [0u8; PARAMS_LEN];
+        data[..8].copy_from_slice(&PARAMS_MAGIC);
+        data[8] = self.sidechain_slot;
+        data[9..17].copy_from_slice(&self.confirmations.to_le_bytes());
+        data[17..25].copy_from_slice(&self.root_depth.to_le_bytes());
+        data[25..33].copy_from_slice(&self.fallback_blocks.to_le_bytes());
+        data
+    }
+
+    pub fn read(data: &[u8]) -> Option<Self> {
+        let data: &[u8; PARAMS_LEN] = data.try_into().ok()?;
+        if data[..8] != PARAMS_MAGIC {
+            return None;
+        }
+        let word = |at: usize| {
+            Some(u64::from_le_bytes(
+                data.get(at..at.checked_add(8)?)?.try_into().ok()?,
+            ))
+        };
+        Some(Self {
+            sidechain_slot: data[8],
+            confirmations: word(9)?,
+            root_depth: word(17)?,
+            fallback_blocks: word(25)?,
+        })
+    }
+}
+
+/// The questions of one replayed slot wait this long in all for a late
+/// eCash block, while the enforcer answers.
+pub const REPLAY_WAIT: Duration = Duration::from_secs(10);
+
+/// The size of the `BmmAnswer` data: height, block hash, found, commitment,
+/// Solana block, recorded, credited height, credits active.
+pub const BMM_ANSWER_LEN: usize = 8 + 32 + 1 + 32 + 32 + 1 + 8 + 1;
+
+/// A 32-byte block hash, in the internal byte order of Bitcoin. That is the
+/// reverse of the hex that block explorers show.
+pub type BlockHash = [u8; 32];
+
+/// A 32-byte BMM commitment from an eCash coinbase.
+pub type Commitment = [u8; 32];
+
+/// An eCash height, its block hash, and the commitment in its coinbase.
+pub type HeightCommitment = (u64, BlockHash, Commitment);
+
+/// Where a store writes its lines.
+#[derive(Debug, Default)]
+pub(crate) enum Sink {
+    /// No file, by design: the store lives in memory.
+    #[default]
+    Memory,
+    File(std::fs::File),
+    /// A write failed and its cut failed too. Every later write fails.
+    Broken,
+}
+
+/// Appends `text` to the file of `sink`, with one sync. A failed write cuts
+/// the file back to its old length, so no part of a line stays. A failed cut
+/// breaks the sink.
+pub(crate) fn append_or_roll_back(
+    sink: &mut Sink,
+    text: &[u8],
+    write: impl FnOnce(&mut std::fs::File, &[u8]) -> std::io::Result<()>,
+) -> std::io::Result<()> {
+    let handle = match sink {
+        Sink::Memory => return Ok(()),
+        Sink::Broken => return Err(std::io::Error::other("an earlier write to the log failed")),
+        Sink::File(handle) => handle,
+    };
+    let len = handle.metadata()?.len();
+    let Err(error) = write(handle, text).and_then(|()| handle.sync_data()) else {
+        return Ok(());
+    };
+    if handle
+        .set_len(len)
+        .and_then(|()| handle.sync_data())
+        .is_err()
+    {
+        *sink = Sink::Broken;
+    }
+    Err(error)
+}
+
+/// Writes `text` as the new file at `path` in one rename, and gives a handle
+/// that appends to it. The handle opens before the rename, so a failure leaves
+/// the old file and its handle as they were.
+pub(crate) fn replace_file(path: &std::path::Path, text: &[u8]) -> std::io::Result<std::fs::File> {
+    use std::io::Write;
+    let temp = path.with_extension("tmp");
+    let mut out = std::fs::File::create(&temp)?;
+    out.write_all(text)?;
+    out.sync_all()?;
+    let handle = std::fs::OpenOptions::new().append(true).open(&temp)?;
+    std::fs::rename(&temp, path)?;
+    Ok(handle)
+}
+
+/// `N` bytes from base58 text. Text longer than the base58 of `N` bytes fails
+/// before the decode, which takes time in the square of its length.
+pub(crate) fn decode_base58<const N: usize>(text: &str) -> Option<[u8; N]> {
+    let longest = N.saturating_mul(137).checked_div(100)?.saturating_add(1);
+    if text.len() > longest {
+        return None;
+    }
+    bs58::decode(text).into_vec().ok()?.try_into().ok()
+}
+
+thread_local! {
+    static PRODUCTION: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Runs `f` as block production, so the BMM check of the bank asks as a
+/// leader: no wait, and N + 1 blocks on top.
+pub fn produce_block<T>(f: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            PRODUCTION.set(self.0);
+        }
+    }
+    let _restore = Restore(PRODUCTION.replace(true));
+    f()
+}
+
+/// True inside `produce_block` on this thread.
+pub fn in_block_production() -> bool {
+    PRODUCTION.get()
+}
+
+/// The treasury PDA of the bridge.
+pub fn treasury() -> Pubkey {
+    static TREASURY: OnceLock<Pubkey> = OnceLock::new();
+    *TREASURY.get_or_init(|| Pubkey::find_program_address(&[TREASURY_SEED], &BRIDGE_PROGRAM_ID).0)
+}
+
+/// The config PDA of the bridge.
+pub fn config() -> Pubkey {
+    static CONFIG: OnceLock<Pubkey> = OnceLock::new();
+    *CONFIG.get_or_init(|| Pubkey::find_program_address(&[CONFIG_SEED], &BRIDGE_PROGRAM_ID).0)
+}
+
+fn config_u64(data: &[u8], at: usize) -> Option<u64> {
+    if data.get(..8)? != CONFIG_DISCRIMINATOR {
+        return None;
+    }
+    let end = at.checked_add(8)?;
+    Some(u64::from_le_bytes(data.get(at..end)?.try_into().ok()?))
+}
+
+/// D, the eCash confirmations before a credit, from the bridge config data.
+pub fn deposit_confirmations(config_data: &[u8]) -> Option<u64> {
+    config_u64(config_data, CONFIG_DEPOSIT_CONFIRMATIONS)
+}
+
+/// The lowest eCash height that a settle may still name, from the bridge
+/// config data.
+pub fn bmm_next_height(config_data: &[u8]) -> Option<u64> {
+    config_u64(config_data, CONFIG_BMM_NEXT_HEIGHT)
+}
+
+/// The index of the next deposit to credit, from the bridge config data.
+pub fn credit_index(config_data: &[u8]) -> Option<u64> {
+    config_u64(config_data, CONFIG_CREDIT_INDEX)
+}
+
+/// The deposit credits of a bank, from its bridge config data.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Credits {
+    /// The highest eCash height whose deposits the bank credited in full.
+    pub credited_height: u64,
+    /// The eCash block at `credited_height`. Zero before the first credit.
+    pub credited_block: BlockHash,
+    /// The eCash block at `credited_height + 1` whose first deposits the
+    /// bank credited. Zero when no part is open.
+    pub part_block: BlockHash,
+    /// A checkpoint at eCash height H counts only with
+    /// `credited_height + lag >= H`.
+    pub lag: u64,
+}
+
+impl Credits {
+    /// Reads the deposit credits from the bridge config data.
+    pub fn read(config_data: &[u8]) -> Option<Self> {
+        Some(Self {
+            credited_height: config_u64(config_data, CONFIG_CREDITED_HEIGHT)?,
+            credited_block: config_data
+                .get(CONFIG_CREDITED_BLOCK..CONFIG_CREDITED_BLOCK_END)?
+                .try_into()
+                .ok()?,
+            part_block: config_data
+                .get(CONFIG_CREDIT_PART_BLOCK..CONFIG_CREDIT_PART_BLOCK_END)?
+                .try_into()
+                .ok()?,
+            lag: config_u64(config_data, CONFIG_DEPOSIT_LAG)?,
+        })
+    }
+}
+
+/// What a `settle_bmm` instruction names: the eCash height, the eCash block,
+/// and the Solana block of the pair.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Question {
+    pub height: u64,
+    pub block_hash: BlockHash,
+    pub solana_block: [u8; 32],
+}
+
+/// The question of a `settle_bmm` instruction, or `None` for any other
+/// instruction.
+pub fn settle_bmm_question(program_id: &Pubkey, data: &[u8]) -> Option<Question> {
+    if program_id != &BRIDGE_PROGRAM_ID {
+        return None;
+    }
+    let (discriminator, arguments) = data.split_first_chunk::<8>()?;
+    if discriminator != &SETTLE_BMM_DISCRIMINATOR {
+        return None;
+    }
+    let (height, rest) = arguments.split_first_chunk::<8>()?;
+    let (block_hash, rest) = rest.split_first_chunk::<32>()?;
+    let solana_block = rest.first_chunk::<32>()?;
+    Some(Question {
+        height: u64::from_le_bytes(*height),
+        block_hash: *block_hash,
+        solana_block: *solana_block,
+    })
+}
+
+/// The credits of the Solana block of a settle, from its entry in the block
+/// record of the bank.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RecordAnswer {
+    pub credited_height: u64,
+    /// The active eCash chain holds every block that the bank credited.
+    pub credits_active: bool,
+}
+
+/// The data of the `BmmAnswer` account for one question and its answer.
+/// `record` is `None` when the block record does not hold the Solana block.
+pub fn answer_data(
+    question: &Question,
+    commitment: Option<Commitment>,
+    record: Option<RecordAnswer>,
+) -> [u8; BMM_ANSWER_LEN] {
+    let mut data = [0u8; BMM_ANSWER_LEN];
+    data[..8].copy_from_slice(&question.height.to_le_bytes());
+    data[8..40].copy_from_slice(&question.block_hash);
+    if let Some(commitment) = commitment {
+        data[40] = 1;
+        data[41..73].copy_from_slice(&commitment);
+    }
+    data[73..105].copy_from_slice(&question.solana_block);
+    if let Some(record) = record {
+        data[105] = 1;
+        data[106..114].copy_from_slice(&record.credited_height.to_le_bytes());
+        data[114] = u8::from(record.credits_active);
+    }
+    data
+}
+
+/// What a `bundle_paid` instruction names: the eCash height and block of the
+/// Succeeded event, and the M6ID.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PaidQuestion {
+    pub height: u64,
+    pub block_hash: BlockHash,
+    pub m6id: M6id,
+}
+
+/// The question of a `bundle_paid(through, height, block_hash, m6id)`
+/// instruction, or `None` for any other instruction.
+pub fn bundle_paid_question(program_id: &Pubkey, data: &[u8]) -> Option<PaidQuestion> {
+    if program_id != &BRIDGE_PROGRAM_ID {
+        return None;
+    }
+    let (discriminator, arguments) = data.split_first_chunk::<8>()?;
+    if discriminator != &BUNDLE_PAID_DISCRIMINATOR {
+        return None;
+    }
+    let (_through, rest) = arguments.split_first_chunk::<8>()?;
+    let (height, rest) = rest.split_first_chunk::<8>()?;
+    let (block_hash, rest) = rest.split_first_chunk::<32>()?;
+    let m6id = rest.first_chunk::<32>()?;
+    Some(PaidQuestion {
+        height: u64::from_le_bytes(*height),
+        block_hash: *block_hash,
+        m6id: *m6id,
+    })
+}
+
+/// The data of the `BmmPaid` account. Status 1 and the paid height H when
+/// block `block_hash` at H holds a Succeeded event for the M6ID, else 0.
+pub fn paid_answer_data(question: &PaidQuestion, paid: bool) -> [u8; BMM_PAID_LEN] {
+    let mut data = [0u8; BMM_PAID_LEN];
+    data[..8].copy_from_slice(&question.height.to_le_bytes());
+    data[8..40].copy_from_slice(&question.block_hash);
+    data[40..72].copy_from_slice(&question.m6id);
+    if paid {
+        data[72] = 1;
+        data[73..81].copy_from_slice(&question.height.to_le_bytes());
+    }
+    data
+}
+
+/// What a `credit_deposits` instruction names: the eCash height, the eCash
+/// block, the index of the first deposit, and the deposit count.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CreditQuestion {
+    pub height: u64,
+    pub block_hash: BlockHash,
+    pub first: u32,
+    pub count: u8,
+}
+
+/// The question of a `credit_deposits` instruction, or `None` for any other
+/// instruction.
+pub fn credit_deposits_question(program_id: &Pubkey, data: &[u8]) -> Option<CreditQuestion> {
+    if program_id != &BRIDGE_PROGRAM_ID {
+        return None;
+    }
+    let (discriminator, arguments) = data.split_first_chunk::<8>()?;
+    if discriminator != &CREDIT_DEPOSITS_DISCRIMINATOR {
+        return None;
+    }
+    let (height, rest) = arguments.split_first_chunk::<8>()?;
+    let (block_hash, rest) = rest.split_first_chunk::<32>()?;
+    let (first, rest) = rest.split_first_chunk::<4>()?;
+    let count = rest.first()?;
+    Some(CreditQuestion {
+        height: u64::from_le_bytes(*height),
+        block_hash: *block_hash,
+        first: u32::from_le_bytes(*first),
+        count: *count,
+    })
+}
+
+/// A deposit to the sidechain in an eCash block.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Deposit {
+    pub sequence_number: u64,
+    pub value_sats: u64,
+    /// The OP_RETURN payload of the deposit.
+    pub address: Vec<u8>,
+}
+
+impl Deposit {
+    /// The Solana pubkey that the OP_RETURN names, or `None`. The payload is
+    /// a bare base58 pubkey, or `s<slot>_<pubkey>_<checksum>` with
+    /// `sidechain_slot` in decimal and the checksum in lower-case hex of the
+    /// first 3 bytes of SHA-256("s<slot>_<pubkey>_").
+    pub fn target(&self, sidechain_slot: u8) -> Option<[u8; 32]> {
+        let text = std::str::from_utf8(&self.address).ok()?;
+        let pubkey = match text.split('_').collect::<Vec<_>>().as_slice() {
+            [pubkey] => *pubkey,
+            [prefix, pubkey, checksum] => {
+                if *prefix != format!("s{sidechain_slot}") {
+                    return None;
+                }
+                let signed = format!("{prefix}_{pubkey}_");
+                let digest = solana_sha256_hasher::hash(signed.as_bytes()).to_bytes();
+                let expected: String = digest[..3]
+                    .iter()
+                    .map(|byte| format!("{byte:02x}"))
+                    .collect();
+                if *checksum != expected {
+                    return None;
+                }
+                *pubkey
+            }
+            _ => return None,
+        };
+        decode_base58(pubkey)
+    }
+}
+
+/// The data of the `DepositAnswer` account: the head, then the deposits from
+/// index `first`, at most `count` of them.
+pub fn deposit_answer_data(
+    question: &CreditQuestion,
+    block: &Block,
+    sidechain_slot: u8,
+) -> Vec<u8> {
+    let total = u32::try_from(block.deposits.len()).unwrap_or(u32::MAX);
+    let entries: Vec<&Deposit> = block
+        .deposits
+        .iter()
+        .skip(question.first as usize)
+        .take(usize::from(question.count))
+        .collect();
+    let mut data = Vec::with_capacity(
+        DEPOSIT_ANSWER_HEAD_LEN
+            .saturating_add(entries.len().saturating_mul(DEPOSIT_ANSWER_ENTRY_LEN)),
+    );
+    data.extend_from_slice(&question.height.to_le_bytes());
+    data.extend_from_slice(&block.hash);
+    data.extend_from_slice(&block.prev_hash);
+    data.extend_from_slice(&total.to_le_bytes());
+    data.extend_from_slice(&question.first.to_le_bytes());
+    data.push(entries.len() as u8);
+    for deposit in entries {
+        data.extend_from_slice(&deposit.sequence_number.to_le_bytes());
+        data.extend_from_slice(&deposit.value_sats.to_le_bytes());
+        match deposit.target(sidechain_slot) {
+            Some(target) => {
+                data.push(1);
+                data.extend_from_slice(&target);
+            }
+            None => {
+                data.push(0);
+                data.extend_from_slice(&[0u8; 32]);
+            }
+        }
+    }
+    data
+}
+
+/// The `DepositAnswer` data for a credit that the bridge refuses from its
+/// config alone: the question with no block and no deposit.
+pub fn refused_deposit_answer_data(question: &CreditQuestion) -> Vec<u8> {
+    let mut data = Vec::with_capacity(DEPOSIT_ANSWER_HEAD_LEN);
+    data.extend_from_slice(&question.height.to_le_bytes());
+    data.extend_from_slice(&[0u8; 64]);
+    data.extend_from_slice(&0u32.to_le_bytes());
+    data.extend_from_slice(&question.first.to_le_bytes());
+    data.push(0);
+    data
+}
+
+/// Writes a block into a block record. The record keeps one block per stride,
+/// so a later block of the same stride takes the place of an earlier one.
+pub fn record_block(record: &mut [u8], block: &RecordedBlock) {
+    if record.len() != BLOCK_RECORD_LEN {
+        return;
+    }
+    let index = block
+        .slot
+        .checked_div(BLOCK_RECORD_STRIDE)
+        .and_then(|stride| stride.checked_rem(BLOCK_RECORD_ENTRIES as u64))
+        .unwrap_or_default() as usize;
+    if let Some(entry) = record.chunks_exact_mut(BLOCK_RECORD_ENTRY_LEN).nth(index) {
+        entry[..8].copy_from_slice(&block.slot.to_le_bytes());
+        entry[8..40].copy_from_slice(&block.bank_hash);
+        entry[40..48].copy_from_slice(&block.credited_height.to_le_bytes());
+        entry[48..80].copy_from_slice(&block.credited_block);
+        entry[80..112].copy_from_slice(&block.part_block);
+    }
+}
+
+/// The blocks in a block record.
+pub fn recorded_blocks(record: &[u8]) -> impl Iterator<Item = RecordedBlock> + '_ {
+    record
+        .chunks_exact(BLOCK_RECORD_ENTRY_LEN)
+        .filter_map(|entry| {
+            let block = RecordedBlock {
+                slot: u64::from_le_bytes(entry[..8].try_into().ok()?),
+                bank_hash: entry[8..40].try_into().ok()?,
+                credited_height: u64::from_le_bytes(entry[40..48].try_into().ok()?),
+                credited_block: entry[48..80].try_into().ok()?,
+                part_block: entry[80..112].try_into().ok()?,
+            };
+            (block.bank_hash != [0u8; 32]).then_some(block)
+        })
+}
+
+/// The entry of a block record for the bank hash `bank_hash`.
+pub fn find_recorded(record: &[u8], bank_hash: &[u8; 32]) -> Option<RecordedBlock> {
+    recorded_blocks(record).find(|block| &block.bank_hash == bank_hash)
+}
+
+/// True when a block record holds the bank hash `bank_hash`.
+pub fn is_recorded(record: &[u8], bank_hash: &[u8; 32]) -> bool {
+    find_recorded(record, bank_hash).is_some()
+}
+
+/// The checkpoints of the active chain: each commitment with a known pair,
+/// from low to high, and the heights of the commitments without one. `None`
+/// before the first read from the enforcer.
+pub fn checkpoints() -> Option<(u64, Vec<fork_choice::Checkpoint>, Vec<u64>)> {
+    matched_checkpoints(view(), pairs::pairs())
+}
+
+fn matched_checkpoints(
+    view: &BmmView,
+    pairs: &pairs::PairStore,
+) -> Option<(u64, Vec<fork_choice::Checkpoint>, Vec<u64>)> {
+    let (tip_height, commitments) = view.commitments()?;
+    let mut checkpoints = Vec::new();
+    let mut unmatched = Vec::new();
+    for (height, block_hash, commitment) in commitments {
+        match pairs.find(height, &commitment) {
+            Some(pair) => checkpoints.push(fork_choice::Checkpoint {
+                height,
+                block_hash,
+                bank_hash: pair.block,
+            }),
+            None => unmatched.push(height),
+        }
+    }
+    Some((tip_height, checkpoints, unmatched))
+}
+
+/// One block of the active eCash chain.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Block {
+    pub hash: BlockHash,
+    pub prev_hash: BlockHash,
+    pub commitment: Option<Commitment>,
+    /// The deposits to the sidechain, in block order.
+    pub deposits: Arc<[Deposit]>,
+    /// The M6IDs of the withdrawal bundles with a Succeeded event here.
+    pub paid: Arc<[M6id]>,
+}
+
+/// What the view gives for a question.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Lookup<T> {
+    Ready(T),
+    /// The view can give the answer after at most `MAX_AHEAD` new eCash
+    /// blocks, or after a backfill.
+    NotYet,
+    /// No answer can come from the active chain that this view holds.
+    Never,
+}
+
+impl<T> Lookup<T> {
+    pub fn map<U>(self, f: impl FnOnce(T) -> U) -> Lookup<U> {
+        match self {
+            Self::Ready(value) => Lookup::Ready(f(value)),
+            Self::NotYet => Lookup::NotYet,
+            Self::Never => Lookup::Never,
+        }
+    }
+
+    pub fn ready(self) -> Option<T> {
+        match self {
+            Self::Ready(value) => Some(value),
+            Self::NotYet | Self::Never => None,
+        }
+    }
+}
+
+/// How long a question may wait for the enforcer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Wait {
+    /// A leader or a simulation: no wait.
+    No,
+    /// Replay of `slot`. All questions of one slot share `REPLAY_WAIT`. While
+    /// the enforcer does not answer, the wait has no limit, so an outage
+    /// stops the replay and marks no block dead.
+    Replay { slot: u64 },
+}
+
+/// A question may name a block this many eCash blocks above what the view can
+/// answer now. A replay then waits for the enforcer, and a leader tries again.
+/// A block further up is `Never`, so a leader cannot make each replay wait.
+pub const MAX_AHEAD: u64 = 2;
+
+/// The view drops blocks this far below the tip, except a backfill that a
+/// question asked for in the last `PIN_TIME`.
+const RETAIN: u64 = 8064;
+const PIN_TIME: Duration = Duration::from_secs(3600);
+
+/// The enforcer is away when the poller read nothing for this long.
+const HEALTH_WINDOW: Duration = Duration::from_secs(10);
+
+/// A backfill that adds no block for this long stops to hold a replay.
+const BACKFILL_STALL: Duration = Duration::from_secs(5);
+
+/// One step of a wait, so an exit or a recovered enforcer is seen soon.
+const WAIT_STEP: Duration = Duration::from_secs(1);
+
+const MAX_BUDGETS: usize = 512;
+
+/// A lookup inside the view. `Ahead` names a block more than `MAX_AHEAD`
+/// blocks past what the view can answer. `Mismatch` names another block than
+/// the view holds with exactly `depth` blocks on top, which a reorg to a
+/// chain one block longer can still change. `Backfill` waits for older blocks.
+enum Found<T> {
+    Ready(T),
+    NotYet,
+    Ahead,
+    Mismatch,
+    Backfill,
+    Never,
+}
+
+#[derive(Default)]
+struct State {
+    /// The height of the active tip.
+    tip_height: Option<u64>,
+    /// The active chain, from the lowest height that the view holds up to
+    /// the tip.
+    active: BTreeMap<u64, Block>,
+    /// The lowest height that a question asked for and the view did not hold.
+    wanted_low: Option<u64>,
+    /// The lowest backfill height of a recent question, which pruning keeps.
+    pinned: Option<(u64, Instant)>,
+    /// Goes up by one at each change of the active chain.
+    generation: u64,
+    /// The last time the poller read the enforcer.
+    synced_at: Option<Instant>,
+    /// The exit flag of the poller. `None` while no poller runs.
+    exit: Option<Arc<AtomicBool>>,
+    /// The end of the wait of each replayed slot.
+    budgets: HashMap<u64, Duration>,
+    /// The last time that a backfill started or added older blocks.
+    backfill_progress: Option<Instant>,
+}
+
+impl State {
+    /// True while a backfill adds blocks. Its wait takes no slot budget,
+    /// and the floor of each question bounds its length.
+    fn backfilling(&self) -> bool {
+        self.backfill_progress
+            .is_some_and(|at| at.elapsed() < BACKFILL_STALL)
+    }
+
+    fn healthy(&self) -> bool {
+        self.synced_at
+            .is_some_and(|synced_at| synced_at.elapsed() < HEALTH_WINDOW)
+    }
+
+    fn exiting(&self) -> bool {
+        self.exit
+            .as_ref()
+            .is_some_and(|exit| exit.load(Ordering::Relaxed))
+    }
+
+    fn lowest(&self) -> Option<u64> {
+        self.active.keys().next().copied()
+    }
+
+    /// `Never` for a height below `floor`. Else asks for a backfill.
+    fn below_view<T>(&mut self, height: u64, floor: u64) -> Found<T> {
+        if height < floor {
+            return Found::Never;
+        }
+        if self.wanted_low.is_none_or(|wanted| height < wanted) {
+            self.backfill_progress = Some(Instant::now());
+        }
+        self.wanted_low = Some(self.wanted_low.map_or(height, |wanted| wanted.min(height)));
+        let pin = self
+            .pinned
+            .filter(|(_, at)| at.elapsed() < PIN_TIME)
+            .map_or(height, |(pinned, _)| pinned.min(height));
+        self.pinned = Some((pin, Instant::now()));
+        Found::Backfill
+    }
+
+    /// Block `block_hash` at `height` with `depth` blocks on top.
+    fn deep_block(
+        &mut self,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+        floor: u64,
+    ) -> Found<Block> {
+        let Some(tip_height) = self.tip_height else {
+            return Found::NotYet;
+        };
+        if self.lowest().is_some_and(|lowest| height < lowest) {
+            return self.below_view(height, floor);
+        }
+        let missing = height.saturating_add(depth).saturating_sub(tip_height);
+        match self.active.get(&height) {
+            Some(block) if missing == 0 => {
+                if &block.hash == block_hash {
+                    Found::Ready(block.clone())
+                } else if tip_height.saturating_sub(height) > depth {
+                    Found::Never
+                } else {
+                    Found::Mismatch
+                }
+            }
+            _ if missing <= MAX_AHEAD => Found::NotYet,
+            _ => Found::Ahead,
+        }
+    }
+
+    /// The hash of the active block at `height`.
+    fn hash_at(&mut self, height: u64, floor: u64) -> Found<BlockHash> {
+        let Some(tip_height) = self.tip_height else {
+            return Found::NotYet;
+        };
+        if let Some(block) = self.active.get(&height) {
+            return Found::Ready(block.hash);
+        }
+        if self.lowest().is_some_and(|lowest| height < lowest) {
+            return self.below_view(height, floor);
+        }
+        if height.saturating_sub(tip_height) <= MAX_AHEAD {
+            Found::NotYet
+        } else {
+            Found::Ahead
+        }
+    }
+
+    /// The healthy wait that `slot` has left. A wait while the enforcer is
+    /// away or a backfill adds blocks uses none of it.
+    fn budget(&mut self, slot: u64) -> Duration {
+        if self.budgets.len() >= MAX_BUDGETS {
+            let mut slots: Vec<u64> = self.budgets.keys().copied().collect();
+            slots.sort_unstable();
+            for old in &slots[..slots.len() / 2] {
+                self.budgets.remove(old);
+            }
+        }
+        *self.budgets.entry(slot).or_insert(REPLAY_WAIT)
+    }
+
+    fn spend(&mut self, slot: u64, spent: Duration) {
+        if let Some(left) = self.budgets.get_mut(&slot) {
+            *left = left.saturating_sub(spent);
+        }
+    }
+
+    fn prune(&mut self) {
+        let Some(tip_height) = self.tip_height else {
+            return;
+        };
+        let mut keep = tip_height.saturating_sub(RETAIN);
+        if let Some((pinned, at)) = self.pinned {
+            if at.elapsed() < PIN_TIME {
+                keep = keep.min(pinned);
+            } else {
+                self.pinned = None;
+            }
+        }
+        self.active = self.active.split_off(&keep);
+    }
+}
+
+/// The active eCash chain of the local enforcer.
+#[derive(Default)]
+pub struct BmmView {
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+/// The view that the runtime reads.
+pub fn view() -> &'static BmmView {
+    static VIEW: OnceLock<BmmView> = OnceLock::new();
+    VIEW.get_or_init(BmmView::default)
+}
+
+impl BmmView {
+    /// Block `block_hash` if it is the active block at `height` with at least
+    /// `depth` blocks on top of it. A height below `floor` asks for no
+    /// backfill.
+    pub fn deep_block(
+        &self,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+        floor: u64,
+        wait: Wait,
+    ) -> Lookup<Block> {
+        self.resolve(wait, |state| {
+            state.deep_block(height, block_hash, depth, floor)
+        })
+    }
+
+    /// The commitment of block `block_hash`, with the rules of `deep_block`.
+    /// `Ready(None)` means that its coinbase holds no commitment for the
+    /// sidechain.
+    pub fn answer(
+        &self,
+        height: u64,
+        block_hash: &BlockHash,
+        depth: u64,
+        floor: u64,
+        wait: Wait,
+    ) -> Lookup<Option<Commitment>> {
+        self.deep_block(height, block_hash, depth, floor, wait)
+            .map(|block| block.commitment)
+    }
+
+    /// The hash of the active block at `height`. A height below `floor` asks
+    /// for no backfill.
+    pub fn hash_at(&self, height: u64, floor: u64, wait: Wait) -> Lookup<BlockHash> {
+        self.resolve(wait, |state| state.hash_at(height, floor))
+    }
+
+    /// A leader drops a question `Ahead` of the view, and so does a replay
+    /// while the enforcer answers. A replay waits for `NotYet` within
+    /// `REPLAY_WAIT` per slot, because its own view can lag.
+    fn resolve<T>(&self, wait: Wait, mut query: impl FnMut(&mut State) -> Found<T>) -> Lookup<T> {
+        let mut state = self.state.lock().unwrap();
+        loop {
+            let found = query(&mut state);
+            let Wait::Replay { slot } = wait else {
+                return match found {
+                    Found::Ready(value) => Lookup::Ready(value),
+                    Found::NotYet | Found::Backfill => Lookup::NotYet,
+                    Found::Ahead | Found::Mismatch | Found::Never => Lookup::Never,
+                };
+            };
+            // A view that the enforcer does not update cannot say "never".
+            let away = state.exit.is_some() && !state.healthy();
+            let backfill = matches!(found, Found::Backfill) && state.backfilling();
+            match found {
+                Found::Ready(value) => return Lookup::Ready(value),
+                Found::Never | Found::Ahead if !away => return Lookup::Never,
+                _ if state.exiting() => return Lookup::NotYet,
+                _ => (),
+            }
+            let paused = away || backfill;
+            let step = if paused {
+                WAIT_STEP
+            } else {
+                match state.budget(slot) {
+                    left if left.is_zero() => return Lookup::NotYet,
+                    left => left.min(WAIT_STEP),
+                }
+            };
+            let start = Instant::now();
+            state = self.changed.wait_timeout(state, step).unwrap().0;
+            if !paused {
+                state.spend(slot, start.elapsed());
+            }
+        }
+    }
+
+    /// Ties the view to a poller. From now on a replay waits while the
+    /// enforcer is away, until `exit`.
+    pub fn set_source(&self, exit: Arc<AtomicBool>) {
+        self.state.lock().unwrap().exit = Some(exit);
+    }
+
+    /// The poller failed to read the enforcer. A replay stops to use its
+    /// budget at once.
+    pub fn mark_failed(&self) {
+        let mut state = self.state.lock().unwrap();
+        state.synced_at = None;
+        self.changed.notify_all();
+    }
+
+    /// The poller read the enforcer.
+    pub fn mark_synced(&self) {
+        let mut state = self.state.lock().unwrap();
+        state.synced_at = Some(Instant::now());
+        self.changed.notify_all();
+    }
+
+    /// Replaces the active chain from the lowest height in `blocks` upward.
+    /// `blocks` runs from low to high and ends at the new tip. When the parent
+    /// of the lowest block is not the view block below it, the view drops all
+    /// blocks below too, so a gap asks for a backfill.
+    pub fn replace_from(&self, blocks: &[(u64, Block)]) {
+        let (Some((lowest, oldest)), Some(&(tip_height, _))) = (blocks.first(), blocks.last())
+        else {
+            return;
+        };
+        let lowest = *lowest;
+        let mut state = self.state.lock().unwrap();
+        state.active.split_off(&lowest);
+        let joins = lowest.checked_sub(1).is_none_or(|below| {
+            state
+                .active
+                .get(&below)
+                .is_some_and(|parent| parent.hash == oldest.prev_hash)
+        });
+        if !joins {
+            state.active.clear();
+        }
+        state.active.extend(blocks.iter().cloned());
+        state.tip_height = Some(tip_height);
+        if state.wanted_low.is_some_and(|wanted| wanted >= lowest) {
+            state.wanted_low = None;
+        }
+        state.prune();
+        state.generation = state.generation.wrapping_add(1);
+        self.changed.notify_all();
+    }
+
+    /// Adds older blocks below the lowest block that the view holds.
+    pub fn extend_below(&self, blocks: &[(u64, Block)]) {
+        let mut state = self.state.lock().unwrap();
+        let lowest = state.lowest();
+        for (height, block) in blocks {
+            if lowest.is_none_or(|lowest| *height < lowest) {
+                state.active.insert(*height, block.clone());
+                state.backfill_progress = Some(Instant::now());
+            }
+        }
+        if let (Some(wanted), Some(new_lowest)) = (state.wanted_low, state.lowest())
+            && wanted >= new_lowest
+        {
+            state.wanted_low = None;
+        }
+        state.generation = state.generation.wrapping_add(1);
+        self.changed.notify_all();
+    }
+
+    /// The active block at `height`, if the view holds it.
+    pub fn block_at(&self, height: u64) -> Option<Block> {
+        self.state.lock().unwrap().active.get(&height).cloned()
+    }
+
+    /// The height and hash of the active tip.
+    pub fn tip(&self) -> Option<(u64, BlockHash)> {
+        let state = self.state.lock().unwrap();
+        state
+            .active
+            .iter()
+            .next_back()
+            .map(|(height, block)| (*height, block.hash))
+    }
+
+    /// The lowest height that the view holds.
+    pub fn lowest(&self) -> Option<u64> {
+        self.state.lock().unwrap().lowest()
+    }
+
+    /// The lowest height that a question asked for and the view did not hold.
+    pub fn wanted_low(&self) -> Option<u64> {
+        self.state.lock().unwrap().wanted_low
+    }
+
+    /// A number that changes at each change of the active chain.
+    pub fn generation(&self) -> u64 {
+        self.state.lock().unwrap().generation
+    }
+
+    /// The tip height and every active block with a commitment, from low to
+    /// high, or `None` before the first read from the enforcer.
+    pub fn commitments(&self) -> Option<(u64, Vec<HeightCommitment>)> {
+        let state = self.state.lock().unwrap();
+        let commitments = state
+            .active
+            .iter()
+            .filter_map(|(height, block)| {
+                block
+                    .commitment
+                    .map(|commitment| (*height, block.hash, commitment))
+            })
+            .collect();
+        Some((state.tip_height?, commitments))
+    }
+}
