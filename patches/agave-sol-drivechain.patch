diff --git a/core/src/bmm_fork_choice.rs b/core/src/bmm_fork_choice.rs
new file mode 100644
index 0000000..e7237b7
--- /dev/null
+++ b/core/src/bmm_fork_choice.rs
@@ -0,0 +1,621 @@
+//! sol-drivechain: BMM checkpoints select the fork and move the root. The
+//! decision logic is in `sol_drivechain_bmm::fork_choice`. This module feeds it
+//! the bank forks, the deposit credits of each bank, and the eCash view, and
+//! it keeps the anchors on disk.
+
+use {
+    crate::consensus::{Tower, heaviest_subtree_fork_choice::HeaviestSubtreeForkChoice},
+    sol_drivechain_bmm::{
+        BMM_BLOCKS_ID, BlockHash, Credits, RecordedBlock, checkpoints,
+        fork_choice::{
+            self, BankHash, Base, BelowRoot, Checkpoint, Choice, Deposits, ForkBank, Rejection,
+            Restart, Saved,
+        },
+        pairs::{PAIR_WINDOW, pairs},
+        peers::peers,
+        recorded_blocks, view,
+    },
+    solana_account::ReadableAccount,
+    solana_clock::Slot,
+    solana_pubkey::Pubkey,
+    solana_runtime::{bank::Bank, bank_forks::BankForks},
+    std::{
+        collections::{HashMap, HashSet},
+        io,
+        path::{Path, PathBuf},
+        sync::{Arc, RwLock},
+    },
+};
+
+/// The exit code of a validator that must start again from an older snapshot.
+pub const RESTART_EXIT_CODE: i32 = 75;
+
+pub(crate) struct BmmForkChoice {
+    ledger: PathBuf,
+    archives: Option<PathBuf>,
+    saved: Saved,
+    key: Option<(u64, u64, u64, Slot, usize, Slot)>,
+    banks: Vec<ForkBank>,
+    checkpoints: Vec<Checkpoint>,
+    vouched: Vec<Checkpoint>,
+    unmatched: Vec<u64>,
+    tip_height: u64,
+    choice: Choice,
+    missing_archive_height: u64,
+    credits: HashMap<(Slot, BankHash), Option<Credits>>,
+    dropped: HashSet<Slot>,
+    root_dropped: bool,
+    rejected: HashSet<(u64, BankHash)>,
+    ancestors: Vec<RecordedBlock>,
+    credited_tip: u64,
+}
+
+impl BmmForkChoice {
+    /// `None` when BMM does not control the forks. `start_root` is the root
+    /// bank that this process loaded. The first start keeps it as the base.
+    pub(crate) fn new(
+        ledger: &Path,
+        archives: Option<PathBuf>,
+        start_root: &Bank,
+        blockstore: &solana_ledger::blockstore::Blockstore,
+    ) -> Option<Self> {
+        if !fork_choice::enabled() {
+            return None;
+        }
+        // The validator read this file at start, so an error here is new.
+        let mut saved = Saved::load(ledger)
+            .unwrap_or_else(|error| panic!("cannot read the BMM fork choice state: {error}"));
+        if saved.base.is_none() {
+            let credited_height = start_root
+                .get_account(&sol_drivechain_bmm::config())
+                .and_then(|account| Credits::read(account.data()))
+                .map_or(0, |credits| credits.credited_height);
+            saved.base = Some(Base {
+                slot: start_root.slot(),
+                credited_height,
+            });
+            saved
+                .store(ledger)
+                .unwrap_or_else(|error| panic!("cannot write the BMM fork choice state: {error}"));
+        }
+        let record: Vec<RecordedBlock> = start_root
+            .get_account(&BMM_BLOCKS_ID)
+            .map(|account| recorded_blocks(account.data()).collect())
+            .unwrap_or_default();
+        let final_root = fork_choice::final_from_anchors(
+            &saved.anchors,
+            (start_root.slot(), start_root.hash().to_bytes()),
+            &record,
+            |slot, bank_hash| {
+                blockstore.is_root(slot)
+                    && blockstore
+                        .get_bank_hash(slot)
+                        .is_some_and(|hash| &hash.to_bytes() == bank_hash)
+            },
+        )
+        .unwrap_or_default();
+        fork_choice::set_final_root(final_root);
+        info!(
+            "BMM fork choice is on with {:?} and {} anchors, final root {final_root}",
+            fork_choice::params(),
+            saved.anchors.len()
+        );
+        Some(Self {
+            ledger: ledger.to_path_buf(),
+            archives,
+            saved,
+            key: None,
+            banks: Vec::new(),
+            checkpoints: Vec::new(),
+            vouched: Vec::new(),
+            unmatched: Vec::new(),
+            tip_height: 0,
+            choice: Choice::default(),
+            missing_archive_height: 0,
+            credits: HashMap::new(),
+            dropped: HashSet::new(),
+            root_dropped: false,
+            rejected: HashSet::new(),
+            ancestors: Vec::new(),
+            credited_tip: 0,
+        })
+    }
+
+    /// Computes the choice again when the eCash view, the pairs, or the
+    /// frozen banks changed. `frozen_banks` holds the root and the frozen
+    /// banks above it.
+    pub(crate) fn update(&mut self, root: Slot, frozen_banks: &[Arc<Bank>]) {
+        sol_drivechain_bmm::answers::answers().prune_noted_below(root);
+        let highest = frozen_banks
+            .iter()
+            .map(|bank| bank.slot())
+            .max()
+            .unwrap_or(root);
+        let key = (
+            view().generation(),
+            pairs().generation(),
+            peers().generation(),
+            root,
+            frozen_banks.len(),
+            highest,
+        );
+        if self.key == Some(key) {
+            return;
+        }
+        let Some((tip_height, checkpoints, unmatched)) = checkpoints() else {
+            return;
+        };
+        let recent = tip_height.saturating_sub(fork_choice::params().fallback_blocks);
+        for height in unmatched
+            .iter()
+            .filter(|height| **height >= recent && !self.unmatched.contains(height))
+        {
+            info!("BMM: the commitment at eCash height {height} has no published pair");
+        }
+        self.unmatched = unmatched;
+        if self.key.is_none_or(|old| old.3 != root) {
+            self.ancestors = frozen_banks
+                .iter()
+                .find(|bank| bank.slot() == root)
+                .and_then(|bank| bank.get_account(&BMM_BLOCKS_ID))
+                .map(|account| recorded_blocks(account.data()).collect())
+                .unwrap_or_default();
+        }
+        self.key = Some(key);
+        self.banks = frozen_banks
+            .iter()
+            .map(|bank| ForkBank {
+                slot: bank.slot(),
+                hash: bank.hash().to_bytes(),
+                parent: (bank.slot() != root).then(|| bank.parent_slot()),
+            })
+            .collect();
+        let deposits = self.check_deposits(frozen_banks);
+        self.credited_tip = deposits
+            .values()
+            .filter_map(|checked| match checked {
+                Deposits::Credited {
+                    credited_height, ..
+                } => Some(*credited_height),
+                _ => None,
+            })
+            .max()
+            .unwrap_or_default();
+        let root_lag = frozen_banks
+            .iter()
+            .find(|bank| bank.slot() == root)
+            .and_then(|bank| self.credits.get(&(root, bank.hash().to_bytes())))
+            .and_then(|credits| credits.map(|credits| credits.lag));
+        let below_root = BelowRoot::new(&self.saved.anchors, &self.ancestors, root_lag, |height| {
+            view().block_at(height).map(|block| block.hash)
+        });
+        let screened = fork_choice::screen(&checkpoints, &deposits, &below_root);
+        self.share_banks(&screened.absent, &below_root, tip_height);
+        for (checkpoint, rejection) in &screened.rejected {
+            if self
+                .rejected
+                .insert((checkpoint.height, checkpoint.bank_hash))
+            {
+                let block = solana_hash::Hash::new_from_array(checkpoint.bank_hash);
+                match rejection {
+                    Rejection::TooFewCredits(credited) => info!(
+                        "BMM: the checkpoint at eCash height {} fails rule 3: block {block} \
+                         credited deposits only through eCash height {credited}",
+                        checkpoint.height
+                    ),
+                    Rejection::Dropped => info!(
+                        "BMM: the checkpoint at eCash height {} fails rule 3: block {block} \
+                         credited deposits of an eCash block that the active chain dropped",
+                        checkpoint.height
+                    ),
+                    Rejection::OutOfRecord => info!(
+                        "BMM: the checkpoint at eCash height {} fails rule 3: block {block} \
+                         is an anchor out of the block record, so this node cannot check its credits",
+                        checkpoint.height
+                    ),
+                }
+            }
+        }
+        self.rejected
+            .retain(|(height, _)| height.saturating_add(PAIR_WINDOW) >= tip_height);
+        let dropped: HashSet<Slot> = self
+            .banks
+            .iter()
+            .filter(|bank| deposits.get(&bank.hash) == Some(&Deposits::Dropped))
+            .map(|bank| bank.slot)
+            .collect();
+        let root_dropped = self
+            .banks
+            .iter()
+            .find(|bank| bank.slot == root)
+            .is_some_and(|bank| deposits.get(&bank.hash) == Some(&Deposits::Dropped));
+        if root_dropped && !self.root_dropped {
+            error!(
+                "BMM: root {root} credits deposits of an eCash block that the active chain \
+                 dropped, so only a restart at an older anchor can leave it"
+            );
+        }
+        self.root_dropped = root_dropped;
+        if dropped != self.dropped {
+            if let Some(lowest) = dropped.iter().min() {
+                warn!(
+                    "BMM: {} banks from slot {lowest} credit deposits of eCash blocks that the \
+                     active chain dropped, so no leader builds on them",
+                    dropped.len()
+                );
+            }
+            self.dropped = dropped;
+        }
+        let staked = frozen_banks
+            .iter()
+            .find(|bank| bank.slot() == root)
+            .map(|bank| bank.current_epoch_staked_nodes())
+            .unwrap_or_default();
+        let vouched = fork_choice::vouched(
+            &screened.absent,
+            |bank_hash| peers().attesters(bank_hash),
+            |node| {
+                staked
+                    .get(&Pubkey::new_from_array(*node))
+                    .copied()
+                    .unwrap_or_default()
+            },
+            staked.values().sum(),
+            &self.saved,
+            tip_height,
+        );
+        if vouched != self.vouched {
+            info!(
+                "BMM: staked peers hold the banks of {} of {} absent checkpoints",
+                vouched.len(),
+                screened.absent.len()
+            );
+        }
+        self.vouched = vouched;
+        self.checkpoints = screened.counted;
+        self.tip_height = tip_height;
+        let mut choice = fork_choice::choose(
+            root,
+            &self.banks,
+            &self.checkpoints,
+            tip_height,
+            fork_choice::params(),
+        );
+        // A checkpoint whose bank trusted staked peers hold can still arrive
+        // here, so it stops the fallback as a pending one does.
+        let stopping = fork_choice::stop_fallback(
+            &mut choice,
+            &screened.pending,
+            &self.vouched,
+            tip_height,
+            fork_choice::params(),
+        );
+        if !stopping.is_empty() {
+            let mut saved = self.saved.clone();
+            if fork_choice::open_proof(
+                &mut saved,
+                &stopping,
+                |bank_hash| peers().attesters(bank_hash),
+                tip_height,
+            ) {
+                match saved.store(&self.ledger) {
+                    Ok(()) => self.saved = saved,
+                    Err(error) => error!("cannot write the BMM fork choice state: {error}"),
+                }
+            }
+        }
+        if choice.head != self.choice.head
+            || choice.fallback != self.choice.fallback
+            || choice.tied != self.choice.tied
+        {
+            info!(
+                "BMM fork choice: head {:?} with {} checkpoints above root {root}, {} tied \
+                 heads, eCash tip {tip_height}, fallback {}",
+                choice.head, choice.count, choice.tied, choice.fallback
+            );
+        }
+        self.choice = choice;
+    }
+
+    /// Tells the peer sync which banks this node holds and which it wants,
+    /// and settles the open proof.
+    fn share_banks(&mut self, absent: &[Checkpoint], below_root: &BelowRoot, tip_height: u64) {
+        let known: HashMap<BankHash, Slot> = self
+            .banks
+            .iter()
+            .map(|bank| (bank.hash, bank.slot))
+            .chain(
+                self.ancestors
+                    .iter()
+                    .map(|block| (block.bank_hash, block.slot)),
+            )
+            .chain(
+                self.saved
+                    .anchors
+                    .iter()
+                    .map(|anchor| (anchor.bank_hash, anchor.slot)),
+            )
+            .collect();
+        let mut wanted: Vec<&Checkpoint> = absent.iter().collect();
+        wanted.sort_by_key(|checkpoint| checkpoint.height);
+        peers().set_wanted(
+            wanted
+                .iter()
+                .map(|checkpoint| checkpoint.bank_hash)
+                .collect(),
+        );
+        let mut saved = self.saved.clone();
+        let holds =
+            |bank_hash: &BankHash| known.contains_key(bank_hash) || below_root.holds(bank_hash);
+        if fork_choice::settle_proof(&mut saved, holds, tip_height) {
+            if saved.proof.is_none() && saved.distrusted.len() > self.saved.distrusted.len() {
+                warn!(
+                    "BMM: no bank that the peers of the proof named arrived, so this node \
+                     distrusts {} peers",
+                    saved.distrusted.len() - self.saved.distrusted.len()
+                );
+            }
+            match saved.store(&self.ledger) {
+                Ok(()) => self.saved = saved,
+                Err(error) => error!("cannot write the BMM fork choice state: {error}"),
+            }
+        }
+        peers().set_known(known);
+    }
+
+    /// The deposit credits of each frozen bank, checked against the active
+    /// eCash chain. A frozen bank never changes, so its credits stay cached.
+    fn check_deposits(&mut self, frozen_banks: &[Arc<Bank>]) -> HashMap<BankHash, Deposits> {
+        let keys: HashSet<(Slot, BankHash)> = frozen_banks
+            .iter()
+            .map(|bank| (bank.slot(), bank.hash().to_bytes()))
+            .collect();
+        self.credits.retain(|key, _| keys.contains(key));
+        let mut active: HashMap<u64, Option<BlockHash>> = HashMap::new();
+        let mut deposits = HashMap::with_capacity(frozen_banks.len());
+        for bank in frozen_banks {
+            let key = (bank.slot(), bank.hash().to_bytes());
+            let credits = *self.credits.entry(key).or_insert_with(|| {
+                bank.get_account(&sol_drivechain_bmm::config())
+                    .and_then(|account| Credits::read(account.data()))
+            });
+            let checked = fork_choice::check_deposits(credits, |height| {
+                *active
+                    .entry(height)
+                    .or_insert_with(|| view().block_at(height).map(|block| block.hash))
+            });
+            deposits.insert(key.1, checked);
+        }
+        deposits
+    }
+
+    /// True when the stake votes move the root, because no checkpoint came for
+    /// the fallback span.
+    pub(crate) fn tower_roots(&self) -> bool {
+        self.choice.fallback
+    }
+
+    /// The bank to build on and vote on, when it is not `stock`: the heaviest
+    /// bank under the BMM head, or `stock` when no checkpoint is above the
+    /// root. Neither may hold credits of a dropped eCash block, so a leader
+    /// builds beside such a bank.
+    pub(crate) fn heaviest(
+        &self,
+        fork_choice: &HeaviestSubtreeForkChoice,
+        bank_forks: &RwLock<BankForks>,
+        stock: &Bank,
+    ) -> Option<Arc<Bank>> {
+        let bank_forks = bank_forks.read().unwrap();
+        let head = match self.choice.head {
+            Some(head) => Some(bank_forks.get(head)?),
+            None => None,
+        };
+        let candidate = match &head {
+            Some(head) => fork_choice.best_slot(&(head.slot(), head.hash()))?.0,
+            None => stock.slot(),
+        };
+        let root = bank_forks.root();
+        let slot = (!self.root_dropped)
+            .then(|| fork_choice::avoid_dropped(root, &self.banks, &self.dropped, candidate))
+            .flatten()
+            .unwrap_or(candidate);
+        (head.is_some() || slot != stock.slot())
+            .then(|| bank_forks.get(slot))
+            .flatten()
+    }
+
+    /// The anchor that the root must move to. It writes the new anchors to
+    /// disk first, so a restart still knows them.
+    pub(crate) fn take_new_root(&mut self, root: Slot) -> io::Result<Option<Slot>> {
+        let Some(new_root) = self.choice.new_root.filter(|new_root| *new_root > root) else {
+            return Ok(None);
+        };
+        let mut saved = self.saved.clone();
+        saved
+            .anchors
+            .extend(self.choice.new_anchors.iter().copied());
+        fork_choice::retain_anchors(&mut saved.anchors, self.tip_height);
+        saved.pruned.extend(self.choice.new_pruned.iter().copied());
+        fork_choice::retain_pruned(&mut saved.pruned, self.tip_height);
+        saved.store(&self.ledger)?;
+        // Only a stored anchor is final. The caller moves the root next.
+        fork_choice::set_final_root(new_root);
+        self.saved = saved;
+        self.choice.new_root = None;
+        Ok(Some(new_root))
+    }
+
+    /// A restart request when a branch that splits behind the root holds more
+    /// checkpoints. It writes the request to disk. The request waits while no
+    /// snapshot archive at or below the anchor exists. A vouched checkpoint
+    /// counts only when `delivered` gives true for a slot that its peers name.
+    pub(crate) fn take_restart(
+        &mut self,
+        root: Slot,
+        delivered: impl Fn(Slot) -> bool,
+    ) -> io::Result<Option<Restart>> {
+        let candidates: Vec<Checkpoint> = self
+            .checkpoints
+            .iter()
+            .copied()
+            .chain(self.vouched.iter().copied().filter(|checkpoint| {
+                peers()
+                    .attested_slots(&checkpoint.bank_hash)
+                    .into_iter()
+                    .any(&delivered)
+            }))
+            .collect();
+        let restart = fork_choice::restart(
+            root,
+            &self.banks,
+            &candidates,
+            self.tip_height,
+            &self.saved,
+            &self.ancestors,
+            self.credited_tip,
+            fork_choice::params(),
+        )
+        .or_else(|| {
+            self.root_dropped
+                .then(|| {
+                    fork_choice::restart_for_dropped_root(
+                        root,
+                        &self.checkpoints,
+                        &self.saved,
+                        &self.ancestors,
+                        self.tip_height,
+                    )
+                })
+                .flatten()
+        });
+        let Some(restart) = restart else {
+            return Ok(None);
+        };
+        let archive = match &self.archives {
+            Some(archives) => {
+                fork_choice::highest_full_archive_at_or_below(archives, restart.anchor.slot)?
+            }
+            None => None,
+        };
+        // Slot 0 needs no archive: the start then replays from the genesis.
+        if archive.is_none() && restart.anchor.slot > 0 {
+            if restart.trigger_height > self.missing_archive_height {
+                self.missing_archive_height = restart.trigger_height;
+                error!(
+                    "BMM checkpoints up to eCash height {} select a branch behind root {root}, \
+                     but no snapshot archive is at or below anchor slot {}. The validator cannot \
+                     roll back.",
+                    restart.trigger_height, restart.anchor.slot
+                );
+            }
+            return Ok(None);
+        }
+        let mut saved = self.saved.clone();
+        saved.handled_height = restart.trigger_height;
+        saved.restart_to = Some(restart.anchor.slot);
+        let named: Vec<Checkpoint> = self
+            .vouched
+            .iter()
+            .filter(|checkpoint| {
+                checkpoint.height > restart.anchor.height
+                    && checkpoint.height <= restart.trigger_height
+            })
+            .copied()
+            .collect();
+        fork_choice::open_proof(
+            &mut saved,
+            &named,
+            |bank_hash| peers().attesters(bank_hash),
+            self.tip_height,
+        );
+        saved.store(&self.ledger)?;
+        self.saved = saved;
+        Ok(Some(restart))
+    }
+}
+
+/// The kept answers move this many slots behind the lowest ledger slot
+/// before the file shrinks.
+const ANSWER_PRUNE_STEP: Slot = 100_000;
+
+/// Drops the kept answers below `lowest_ledger_slot`, which no replay can
+/// reach again.
+pub(crate) fn prune_answers(lowest_ledger_slot: Slot) {
+    let answers = sol_drivechain_bmm::answers::answers();
+    if answers
+        .lowest_slot()
+        .is_some_and(|kept| kept.saturating_add(ANSWER_PRUNE_STEP) < lowest_ledger_slot)
+        && let Err(error) = answers.prune_below(lowest_ledger_slot)
+    {
+        error!("cannot shrink the BMM answers file: {error}");
+    }
+}
+
+/// Makes the tower fit the bank forks root `root` and the bank `heaviest`.
+/// When the last vote is on the path of `heaviest`, only the tower root moves
+/// up. Else the tower starts again from the lockouts that `heaviest` holds,
+/// and the result is the old last vote: a vote at or below it would repeat an
+/// older vote in gossip.
+pub(crate) fn fit_tower(
+    tower: &mut Tower,
+    node: &Pubkey,
+    vote_account: &Pubkey,
+    root: Slot,
+    heaviest: &Bank,
+) -> Option<Slot> {
+    let last = tower.last_voted_slot();
+    let on_path =
+        last.is_none_or(|last| last == heaviest.slot() || heaviest.ancestors.contains_key(&last));
+    if on_path {
+        if tower.root() < root {
+            tower.set_bmm_root(root);
+        }
+        return None;
+    }
+    warn!(
+        "BMM fork choice resets the tower: last vote {last:?}, tower root {}, root {root}, bank {}",
+        tower.root(),
+        heaviest.slot()
+    );
+    *tower = Tower::new(node, vote_account, root, heaviest);
+    last
+}
