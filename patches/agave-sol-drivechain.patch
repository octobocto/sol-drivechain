+    /// sol-drivechain: the most pairs in one `bmmGetPairs` reply.
+    pub const MAX_PAIRS_REPLY: usize = 8192;
+
     pub struct MinimalImpl;
     impl Minimal for MinimalImpl {
+        fn bmm_publish_pairs(
+            &self,
+            _meta: Self::Metadata,
+            pairs: Vec<(u64, String, String)>,
+        ) -> Result<Vec<String>> {
+            use sol_drivechain_bmm::pairs::{Pair, Publish};
+            let parse = |text: &str| {
+                Pubkey::from_str(text)
+                    .map(|key| key.to_bytes())
+                    .map_err(|_| Error::invalid_params(format!("{text} is not base58 of 32 bytes")))
+            };
+            pairs
+                .into_iter()
+                .map(|(height, block, payee)| {
+                    let pair = Pair {
+                        block: parse(&block)?,
+                        payee: parse(&payee)?,
+                    };
+                    let outcome = sol_drivechain_bmm::pairs::pairs()
+                        .publish(height, pair, sol_drivechain_bmm::view())
+                        .map_err(|error| {
+                            warn!("cannot store a BMM pair: {error}");
+                            Error::internal_error()
+                        })?;
+                    Ok(match outcome {
+                        Publish::New => {
+                            info!("BMM: a new pair for eCash height {height}: block {block}");
+                            "new".to_owned()
+                        }
+                        Publish::Known => "known".to_owned(),
+                        Publish::Refused(reason) => format!("refused: {reason}"),
+                    })
+                })
+                .collect()
+        }
+
+        fn bmm_get_pairs(
+            &self,
+            _meta: Self::Metadata,
+            from_height: u64,
+        ) -> Result<Vec<(u64, String, String)>> {
+            Ok(sol_drivechain_bmm::pairs::pairs()
+                .from_height_limited(from_height, MAX_PAIRS_REPLY)
+                .into_iter()
+                .map(|(height, pair)| {
+                    (
+                        height,
+                        Pubkey::new_from_array(pair.block).to_string(),
+                        Pubkey::new_from_array(pair.payee).to_string(),
+                    )
+                })
+                .collect())
+        }
+
+        fn bmm_known_banks(
+            &self,
+            meta: Self::Metadata,
+            bank_hashes: Vec<String>,
+            nonce: String,
+        ) -> Result<(Vec<Option<u64>>, u64, String)> {
+            use sol_drivechain_bmm::peers::{MAX_WANTED, known_banks_message, peers};
+            if bank_hashes.len() > MAX_WANTED {
+                return Err(Error::invalid_params("too many bank hashes"));
+            }
+            let parse = |text: &str| {
+                Pubkey::from_str(text)
+                    .map(|key| key.to_bytes())
+                    .map_err(|_| Error::invalid_params(format!("{text} is not base58 of 32 bytes")))
+            };
+            let nonce = parse(&nonce)?;
+            let bank_hashes = bank_hashes
+                .iter()
+                .map(|text| parse(text))
+                .collect::<Result<Vec<_>>>()?;
+            let slots: Vec<Option<u64>> = bank_hashes
+                .iter()
+                .map(|bank_hash| peers().known_slot(bank_hash))
+                .collect();
+            let timestamp = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map_err(|_| Error::internal_error())?
+                .as_secs();
+            let keypair = meta.cluster_info.keypair();
+            let message = known_banks_message(
+                &keypair.pubkey().to_bytes(),
+                &bank_hashes,
+                &slots,
+                &nonce,
+                timestamp,
+            );
+            Ok((slots, timestamp, keypair.sign_message(&message).to_string()))
+        }
