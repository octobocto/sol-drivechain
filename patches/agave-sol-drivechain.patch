index 0000000..bf37e56
--- /dev/null
+++ b/sol-drivechain-bmm/src/answers.rs
@@ -0,0 +1,551 @@
+//! The answers of the pre-check, per tx. A replay of a rooted slot uses the
+//! answer of its first run, because a later eCash reorg can drop the block
+//! that the tx names, and the view then has no answer for it.
+//!
+//! The check of a tx only notes its answer. When the bank of the slot
+//! freezes, the answers of the committed txs go to the file in one write,
+//! with the bank hash. Only the same block of the slot uses them again.
+
+use {
+    solana_pubkey::Pubkey,
+    std::{
+        collections::{BTreeMap, HashMap},
+        fs::{self, OpenOptions},
+        io::{self, Write},
+        path::{Path, PathBuf},
+        sync::{Mutex, OnceLock},
+    },
+};
+
+/// The file in the ledger directory that keeps the answers.
+pub const ANSWERS_FILE: &str = "bmm-answers";
+
+/// The slot and the first signature of a tx.
+type TxKey = (u64, [u8; 64]);
+
+/// An answer that a check gave and that waits for the freeze of its bank.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Noted {
+    blockhash: [u8; 32],
+    key: Pubkey,
+    data: Vec<u8>,
+}
+
+/// An answer of a committed tx, and the hash of the bank that froze it.
+/// A line from before the hash has none.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Kept {
+    bank_hash: Option<[u8; 32]>,
+    key: Pubkey,
+    data: Vec<u8>,
+}
+
+#[derive(Default)]
+struct State {
+    by_tx: HashMap<TxKey, Kept>,
+    noted: BTreeMap<u64, HashMap<[u8; 64], Noted>>,
+    path: Option<PathBuf>,
+    file: crate::Sink,
+    /// The blockstore root at the start. Only a slot at or below it takes a
+    /// recorded answer.
+    replay_root: Option<u64>,
+    /// The bank hash that the ledger holds for a frozen slot.
+    frozen_hash: Option<FrozenHash>,
+}
+
+type FrozenHash = Box<dyn Fn(u64) -> Option<[u8; 32]> + Send>;
+
+/// The answers that this validator gave to the txs of its blocks.
+#[derive(Default)]
+pub struct AnswerStore {
+    state: Mutex<State>,
+}
+
+/// The store that the runtime fills and reads.
+pub fn answers() -> &'static AnswerStore {
+    static ANSWERS: OnceLock<AnswerStore> = OnceLock::new();
+    ANSWERS.get_or_init(AnswerStore::default)
+}
+
+impl AnswerStore {
+    /// Reads the answers file in `ledger`, and adds each new answer to it
+    /// from now on. A crash in a write can leave a part of the last line,
+    /// and the open drops that part.
+    pub fn open(&self, ledger: &Path) -> io::Result<()> {
+        let path = ledger.join(ANSWERS_FILE);
+        let (by_tx, file) = match fs::read_to_string(&path) {
+            Ok(text) => {
+                let complete = text.rfind('\n').map_or("", |end| &text[..=end]);
+                let by_tx = parse(complete).ok_or_else(|| {
+                    io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        format!("{} holds a bad line", path.display()),
+                    )
+                })?;
+                let file = if complete.len() != text.len() {
+                    crate::replace_file(&path, &render(&by_tx))?
+                } else {
+                    OpenOptions::new().append(true).open(&path)?
+                };
+                (by_tx, file)
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => (
+                HashMap::new(),
+                OpenOptions::new().create(true).append(true).open(&path)?,
+            ),
+            Err(error) => return Err(error),
+        };
+        let mut state = self.state.lock().unwrap();
+        state.by_tx = by_tx;
+        state.file = crate::Sink::File(file);
+        state.path = Some(path);
+        Ok(())
+    }
+
+    /// Sets the highest slot of the ledger at the start. A slot at or below
+    /// it that has a kept answer is a slot that this node already ran.
+    pub fn set_replay_root(&self, slot: u64) {
+        self.state.lock().unwrap().replay_root = Some(slot);
+    }
+
+    /// Sets where the ledger keeps the bank hash of each frozen slot. A purge
+    /// of a block also drops its hash.
+    pub fn set_frozen_hashes(
+        &self,
+        frozen_hash: impl Fn(u64) -> Option<[u8; 32]> + Send + 'static,
+    ) {
+        self.state.lock().unwrap().frozen_hash = Some(Box::new(frozen_hash));
+    }
+
+    /// The answer of the first run of a tx in a slot from before the start,
+    /// when the ledger still holds the frozen block of that run.
+    pub fn recorded(&self, slot: u64, signature: &[u8; 64]) -> Option<(Pubkey, Vec<u8>)> {
+        let state = self.state.lock().unwrap();
+        if state.replay_root.is_none_or(|root| slot > root) {
+            return None;
+        }
+        let kept = state.by_tx.get(&(slot, *signature))?;
+        let frozen_hash = state.frozen_hash.as_ref()?;
+        (kept.bank_hash.is_some() && kept.bank_hash == frozen_hash(slot))
+            .then(|| (kept.key, kept.data.clone()))
+    }
+
+    /// Notes the answer that a tx in `slot` gets. `freeze` keeps it when the
+    /// tx commits.
+    pub fn note(
+        &self,
+        slot: u64,
+        signature: &[u8; 64],
+        blockhash: &[u8; 32],
+        key: &Pubkey,
+        data: &[u8],
+    ) {
+        let mut state = self.state.lock().unwrap();
+        state.noted.entry(slot).or_default().insert(
+            *signature,
+            Noted {
+                blockhash: *blockhash,
+                key: *key,
+                data: data.to_vec(),
+            },
+        );
+    }
+
+    /// Keeps the noted answers of `slot` whose tx `committed` gives true for,
+    /// with the hash of the frozen bank, in one write.
+    pub fn freeze(
+        &self,
+        slot: u64,
+        bank_hash: &[u8; 32],
+        mut committed: impl FnMut(&[u8; 64], &[u8; 32]) -> bool,
+    ) -> io::Result<()> {
+        let mut state = self.state.lock().unwrap();
+        let noted = state.noted.remove(&slot).unwrap_or_default();
+        let mut text = String::new();
+        let mut kept = Vec::new();
+        for (signature, noted) in noted {
+            if !committed(&signature, &noted.blockhash) {
+                continue;
+            }
+            let entry = Kept {
+                bank_hash: Some(*bank_hash),
+                key: noted.key,
+                data: noted.data,
+            };
+            if state.by_tx.get(&(slot, signature)) == Some(&entry) {
+                continue;
+            }
+            text.push_str(&line(slot, &signature, &entry));
+            kept.push(((slot, signature), entry));
+        }
+        if text.is_empty() {
+            return Ok(());
+        }
+        crate::append_or_roll_back(&mut state.file, text.as_bytes(), |file, bytes| {
+            file.write_all(bytes)
+        })?;
+        state.by_tx.extend(kept);
+        Ok(())
+    }
+
+    /// Drops the noted answers of the slots below `root`. A bank below the
+    /// root that did not freeze is gone, and a frozen one wrote its answers.
+    pub fn prune_noted_below(&self, root: u64) {
+        let mut state = self.state.lock().unwrap();
+        state.noted = state.noted.split_off(&root);
+    }
+
+    /// Drops the answers below `slot`, which no replay can reach again, and
+    /// writes the file again.
+    pub fn prune_below(&self, slot: u64) -> io::Result<()> {
+        let mut state = self.state.lock().unwrap();
+        let before = state.by_tx.len();
+        state.by_tx.retain(|(tx_slot, _), _| *tx_slot >= slot);
+        if state.by_tx.len() == before {
+            return Ok(());
+        }
+        let Some(path) = state.path.clone() else {
+            return Ok(());
+        };
+        state.file = crate::Sink::File(crate::replace_file(&path, &render(&state.by_tx))?);
+        Ok(())
+    }
+
+    /// The lowest slot with a kept answer.
+    pub fn lowest_slot(&self) -> Option<u64> {
+        self.state
+            .lock()
+            .unwrap()
+            .by_tx
+            .keys()
+            .map(|(slot, _)| *slot)
+            .min()
+    }
+}
+
+fn line(slot: u64, signature: &[u8; 64], kept: &Kept) -> String {
+    let mut text = format!(
+        "answer {slot} {} {} {}",
+        to_hex(signature),
+        to_hex(kept.key.as_ref()),
+        to_hex(&kept.data)
+    );
+    if let Some(bank_hash) = &kept.bank_hash {
+        text.push(' ');
+        text.push_str(&to_hex(bank_hash));
+    }
+    text.push('\n');
+    text
+}
+
+fn render(by_tx: &HashMap<TxKey, Kept>) -> Vec<u8> {
+    let mut entries: Vec<_> = by_tx.iter().collect();
+    entries.sort_by_key(|((slot, signature), _)| (*slot, *signature));
+    let mut text = String::new();
+    for ((slot, signature), kept) in entries {
+        text.push_str(&line(*slot, signature, kept));
+    }
+    text.into_bytes()
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn from_hex(text: &str) -> Option<Vec<u8>> {
+    if !text.len().is_multiple_of(2) {
+        return None;
+    }
+    text.as_bytes()
+        .chunks(2)
+        .map(|pair| u8::from_str_radix(std::str::from_utf8(pair).ok()?, 16).ok())
+        .collect()
+}
+
+/// A later line for the same tx takes the place of an earlier one.
+fn parse(text: &str) -> Option<HashMap<TxKey, Kept>> {
+    let mut by_tx = HashMap::new();
+    for line in text.lines().filter(|line| !line.trim().is_empty()) {
+        let words: Vec<&str> = line.split_whitespace().collect();
+        let (slot, signature, key, data, bank_hash) = match words.as_slice() {
+            ["answer", slot, signature, key, data] => (slot, signature, key, data, None),
+            ["answer", slot, signature, key, data, bank_hash] => (
+                slot,
+                signature,
+                key,
+                data,
+                Some(from_hex(bank_hash)?.try_into().ok()?),
+            ),
+            _ => return None,
+        };
+        let signature: [u8; 64] = from_hex(signature)?.try_into().ok()?;
+        let key: [u8; 32] = from_hex(key)?.try_into().ok()?;
+        by_tx.insert(
+            (slot.parse().ok()?, signature),
+            Kept {
+                bank_hash,
+                key: Pubkey::new_from_array(key),
+                data: from_hex(data)?,
+            },
+        );
+    }
+    Some(by_tx)
+}
+
+#[cfg(test)]
+mod tests {
+    use {super::*, crate::BMM_ANSWER_ID};
+
+    fn temp_dir(name: &str) -> std::path::PathBuf {
+        let dir = std::env::temp_dir().join(format!("bmm-answers-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    /// A store whose ledger holds the hash that `keep` freezes each slot with.
+    fn stored() -> AnswerStore {
+        let store = AnswerStore::default();
+        store.set_frozen_hashes(|slot| Some([slot as u8; 32]));
+        store
+    }
+
+    fn keep(store: &AnswerStore, slot: u64, signature: [u8; 64], data: &[u8]) {
+        store.note(slot, &signature, &[0; 32], &BMM_ANSWER_ID, data);
+        store.freeze(slot, &[slot as u8; 32], |_, _| true).unwrap();
+    }
+
+    fn lines(dir: &Path) -> usize {
+        fs::read_to_string(dir.join(ANSWERS_FILE))
+            .unwrap()
+            .lines()
+            .count()
+    }
+
+    #[test]
+    fn a_rooted_slot_takes_the_answer_of_its_first_run_after_a_restart() {
+        let dir = temp_dir("restart");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1, 2, 3]);
+        keep(&store, 41, [8; 64], &[4]);
+
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(40);
+        assert_eq!(
+            again.recorded(40, &[7; 64]),
+            Some((BMM_ANSWER_ID, vec![1, 2, 3]))
+        );
+        assert_eq!(again.recorded(40, &[8; 64]), None);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_slot_above_the_root_never_takes_a_recorded_answer() {
+        let store = stored();
+        keep(&store, 41, [8; 64], &[4]);
+        assert_eq!(store.recorded(41, &[8; 64]), None);
+        store.set_replay_root(40);
+        assert_eq!(store.recorded(41, &[8; 64]), None);
+        store.set_replay_root(41);
+        assert_eq!(store.recorded(41, &[8; 64]), Some((BMM_ANSWER_ID, vec![4])));
+    }
+
+    #[test]
+    fn a_later_answer_for_the_same_tx_takes_the_place_of_the_first() {
+        let dir = temp_dir("later");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        keep(&store, 40, [7; 64], &[2]);
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(40);
+        assert_eq!(again.recorded(40, &[7; 64]), Some((BMM_ANSWER_ID, vec![2])));
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn only_a_committed_tx_writes_its_answer() {
+        let dir = temp_dir("committed");
+        let store = stored();
+        store.open(&dir).unwrap();
+        store.note(40, &[7; 64], &[1; 32], &BMM_ANSWER_ID, &[1]);
+        store.note(40, &[8; 64], &[2; 32], &BMM_ANSWER_ID, &[2]);
+        store.note(40, &[8; 64], &[2; 32], &BMM_ANSWER_ID, &[2]);
+        store
+            .freeze(40, &[0; 32], |signature, blockhash| {
+                signature == &[7; 64] && blockhash == &[1; 32]
+            })
+            .unwrap();
+        assert_eq!(lines(&dir), 1);
+        store.freeze(40, &[0; 32], |_, _| true).unwrap();
+        assert_eq!(lines(&dir), 1);
+        store.set_replay_root(40);
+        assert_eq!(store.recorded(40, &[8; 64]), None);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn the_same_answer_twice_writes_one_line() {
+        let dir = temp_dir("twice");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        keep(&store, 40, [7; 64], &[1]);
+        assert_eq!(lines(&dir), 1);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn the_answers_below_a_slot_leave_the_file() {
+        let dir = temp_dir("prune");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        keep(&store, 50, [8; 64], &[2]);
+        store.prune_below(45).unwrap();
+        assert_eq!(store.lowest_slot(), Some(50));
+        keep(&store, 60, [9; 64], &[3]);
+        assert_eq!(lines(&dir), 2);
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(60);
+        assert_eq!(again.recorded(40, &[7; 64]), None);
+        assert_eq!(again.recorded(60, &[9; 64]), Some((BMM_ANSWER_ID, vec![3])));
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_noted_answer_waits_for_its_bank_until_the_root_passes_it() {
+        let store = stored();
+        store.note(10, &[7; 64], &[0; 32], &BMM_ANSWER_ID, &[1]);
+        store.freeze(10_000, &[0; 32], |_, _| true).unwrap();
+        store.prune_noted_below(10);
+        store.freeze(10, &[10; 32], |_, _| true).unwrap();
+        store.set_replay_root(10);
+        assert_eq!(store.recorded(10, &[7; 64]), Some((BMM_ANSWER_ID, vec![1])));
+        store.note(20, &[8; 64], &[0; 32], &BMM_ANSWER_ID, &[2]);
+        store.prune_noted_below(21);
+        assert!(store.state.lock().unwrap().noted.is_empty());
+    }
+
+    #[test]
+    fn a_part_of_a_last_line_is_dropped_at_the_open() {
+        let dir = temp_dir("partial");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        let mut file = OpenOptions::new()
+            .append(true)
+            .open(dir.join(ANSWERS_FILE))
+            .unwrap();
+        file.write_all(b"answer 41 0a").unwrap();
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(41);
+        assert_eq!(again.recorded(40, &[7; 64]), Some((BMM_ANSWER_ID, vec![1])));
+        assert!(
+            fs::read_to_string(dir.join(ANSWERS_FILE))
+                .unwrap()
+                .ends_with('\n')
+        );
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_failed_append_leaves_no_part_of_a_line() {
+        let dir = temp_dir("partial-write");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        let failed = crate::append_or_roll_back(
+            &mut store.state.lock().unwrap().file,
+            b"answer 41 0a0b\n",
+            |file, bytes| {
+                file.write_all(&bytes[..5])?;
+                Err(io::Error::other("no space left"))
+            },
+        );
+        assert!(failed.is_err());
+        keep(&store, 42, [9; 64], &[3]);
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(42);
+        assert_eq!(again.recorded(40, &[7; 64]), Some((BMM_ANSWER_ID, vec![1])));
+        assert_eq!(again.recorded(42, &[9; 64]), Some((BMM_ANSWER_ID, vec![3])));
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_broken_log_fails_each_later_freeze() {
+        let dir = temp_dir("broken");
+        let store = stored();
+        store.open(&dir).unwrap();
+        store.state.lock().unwrap().file = crate::Sink::Broken;
+        store.note(40, &[7; 64], &[0; 32], &BMM_ANSWER_ID, &[1]);
+        assert!(store.freeze(40, &[0; 32], |_, _| true).is_err());
+        store.note(41, &[8; 64], &[0; 32], &BMM_ANSWER_ID, &[2]);
+        assert!(store.freeze(41, &[0; 32], |_, _| true).is_err());
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_prune_that_cannot_rename_keeps_the_old_file_and_handle() {
+        let dir = temp_dir("prune-rename");
+        let store = stored();
+        store.open(&dir).unwrap();
+        keep(&store, 40, [7; 64], &[1]);
+        keep(&store, 50, [8; 64], &[2]);
+        fs::create_dir_all(dir.join(ANSWERS_FILE).with_extension("tmp")).unwrap();
+        assert!(store.prune_below(45).is_err());
+        keep(&store, 60, [9; 64], &[3]);
+        fs::remove_dir_all(dir.join(ANSWERS_FILE).with_extension("tmp")).unwrap();
+        let again = stored();
+        again.open(&dir).unwrap();
+        again.set_replay_root(60);
+        assert_eq!(again.recorded(60, &[9; 64]), Some((BMM_ANSWER_ID, vec![3])));
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_bad_line_stops_the_open() {
+        let dir = temp_dir("bad");
+        fs::write(dir.join(ANSWERS_FILE), "answer 1 zz\n").unwrap();
+        assert!(stored().open(&dir).is_err());
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn only_the_frozen_block_of_the_first_run_takes_its_answer() {
+        let frozen = std::sync::Arc::new(Mutex::new(HashMap::from([(50u64, [50u8; 32])])));
+        let ledger = std::sync::Arc::clone(&frozen);
+        let store = AnswerStore::default();
+        store.set_frozen_hashes(move |slot| ledger.lock().unwrap().get(&slot).copied());
+        store.set_replay_root(60);
+        keep(&store, 50, [8; 64], &[2]);
+        assert_eq!(store.recorded(50, &[8; 64]), Some((BMM_ANSWER_ID, vec![2])));
+        frozen.lock().unwrap().insert(50, [51; 32]);
+        assert_eq!(store.recorded(50, &[8; 64]), None);
+        frozen.lock().unwrap().remove(&50);
+        assert_eq!(store.recorded(50, &[8; 64]), None);
+        assert_eq!(AnswerStore::default().recorded(50, &[8; 64]), None);
+    }
+
+    #[test]
+    fn a_line_without_a_bank_hash_takes_no_answer() {
+        let dir = temp_dir("no-hash");
+        let data = format!(
+            "answer 40 {} {} 01\n",
+            to_hex(&[7; 64]),
+            to_hex(BMM_ANSWER_ID.as_ref())
+        );
+        fs::write(dir.join(ANSWERS_FILE), data).unwrap();
+        let store = stored();
+        store.open(&dir).unwrap();
+        store.set_replay_root(50);
+        assert_eq!(store.recorded(40, &[7; 64]), None);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+}
