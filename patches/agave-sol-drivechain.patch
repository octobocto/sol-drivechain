+//! The bridge txs that a leader keeps in its queue while the view cannot
+//! answer them yet. Such a tx pays no fee, so the leader keeps few of them,
+//! and each for a short time.
+
+use {
+    solana_pubkey::Pubkey,
+    std::{
+        collections::HashMap,
+        sync::{Mutex, OnceLock},
+        time::{Duration, Instant},
+    },
+};
+
+/// A tx leaves the queue this long after its first "not ready".
+pub const HOLD_TIME: Duration = Duration::from_secs(30);
+
+/// A dropped tx stays known this long, so it cannot enter the queue again.
+const FORGET_TIME: Duration = Duration::from_secs(120);
+
+/// The txs of one fee payer in the queue at one time.
+pub const MAX_PER_PAYER: usize = 4;
+
+/// The txs in the queue at one time.
+pub const MAX_HELD: usize = 256;
+
+#[derive(Default)]
+pub struct Held {
+    by_signature: Mutex<HashMap<[u8; 64], (Pubkey, Instant)>>,
+}
+
+/// The queue limits of this leader.
+pub fn held() -> &'static Held {
+    static HELD: OnceLock<Held> = OnceLock::new();
+    HELD.get_or_init(Held::default)
+}
+
+impl Held {
+    /// True when the leader may keep a tx that is not ready, so it tries the
+    /// tx again later. False when the leader must drop it.
+    pub fn admit(&self, signature: &[u8; 64], payer: &Pubkey, now: Instant) -> bool {
+        let mut by_signature = self.by_signature.lock().unwrap();
+        let age = |first: &Instant| now.saturating_duration_since(*first);
+        by_signature.retain(|_, (_, first)| age(first) < FORGET_TIME);
+        if let Some((_, first)) = by_signature.get(signature) {
+            return age(first) < HOLD_TIME;
+        }
+        let active = || {
+            by_signature
+                .values()
+                .filter(|(_, first)| age(first) < HOLD_TIME)
+        };
+        let of_payer = active()
+            .filter(|(held_payer, _)| held_payer == payer)
+            .count();
+        if of_payer >= MAX_PER_PAYER || active().count() >= MAX_HELD {
+            return false;
+        }
+        by_signature.insert(*signature, (*payer, now));
+        true
+    }
+
+    /// Forgets a tx that got its answer.
+    pub fn release(&self, signature: &[u8; 64]) {
+        self.by_signature.lock().unwrap().remove(signature);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn signature(byte: u8) -> [u8; 64] {
+        [byte; 64]
+    }
+
+    #[test]
+    fn a_tx_stays_for_the_hold_time_only() {
+        let held = Held::default();
+        let payer = Pubkey::new_from_array([1; 32]);
+        let start = Instant::now();
+        assert!(held.admit(&signature(1), &payer, start));
+        assert!(held.admit(&signature(1), &payer, start + HOLD_TIME / 2));
+        assert!(!held.admit(&signature(1), &payer, start + HOLD_TIME));
+        assert!(!held.admit(&signature(1), &payer, start + HOLD_TIME * 2));
+        assert!(held.admit(&signature(2), &payer, start + HOLD_TIME * 2));
+    }
+
+    #[test]
+    fn one_payer_keeps_at_most_its_share() {
+        let held = Held::default();
+        let payer = Pubkey::new_from_array([1; 32]);
+        let other = Pubkey::new_from_array([2; 32]);
+        let now = Instant::now();
+        for byte in 0..MAX_PER_PAYER as u8 {
+            assert!(held.admit(&signature(byte), &payer, now));
+        }
+        assert!(!held.admit(&signature(200), &payer, now));
+        assert!(held.admit(&signature(201), &other, now));
+        held.release(&signature(0));
+        assert!(held.admit(&signature(200), &payer, now));
+    }
+
+    #[test]
+    fn the_queue_has_a_limit_for_all_payers() {
+        let held = Held::default();
+        let now = Instant::now();
+        for index in 0..MAX_HELD {
+            let mut key = [0u8; 32];
+            key[..8].copy_from_slice(&(index as u64).to_le_bytes());
+            let mut sig = [0u8; 64];
+            sig[..8].copy_from_slice(&(index as u64).to_le_bytes());
+            assert!(held.admit(&sig, &Pubkey::new_from_array(key), now));
+        }
+        assert!(!held.admit(&[255; 64], &Pubkey::new_from_array([255; 32]), now));
+    }
+}
