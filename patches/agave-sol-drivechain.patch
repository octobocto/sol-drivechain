+    #[test]
+    fn a_replaced_block_with_the_same_settle_tx_asks_the_bridge_again() {
+        let genesis = create_genesis_config(1_000_000_000);
+        let (start, bank_forks) = Bank::new_with_bank_forks_for_tests(&genesis.genesis_config);
+        store_bridge(&start, 100, 40, 0);
+        let slot = 900_001;
+        let bank = Bank::new_from_parent_with_bank_forks(
+            bank_forks.as_ref(),
+            start,
+            SlotLeader::default(),
+            slot,
+        );
+        let settle_tx = tx(credit_of_view(41), true);
+        let signature: [u8; 64] = settle_tx.signature().as_ref().try_into().unwrap();
+        let first_run = vec![9; 4];
+        static LEDGER_HASH: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(1);
+        answers().set_frozen_hashes(move |frozen| {
+            (frozen == slot).then(|| [LEDGER_HASH.load(std::sync::atomic::Ordering::Relaxed); 32])
+        });
+        answers().note(slot, &signature, &[0; 32], &BMM_ANSWER_ID, &first_run);
+        answers().freeze(slot, &[1; 32], |_, _| true).unwrap();
+        answers().set_replay_root(u64::MAX);
+        assert_eq!(
+            answer_of(check(&bank, settle_tx.clone(), BmmCheck::Replay)),
+            first_run
+        );
+
+        LEDGER_HASH.store(2, std::sync::atomic::Ordering::Relaxed);
+        let asked = answer_of(check(&bank, settle_tx.clone(), BmmCheck::Replay));
+        assert_ne!(asked, first_run);
+        assert_eq!(asked, answer_of(check(&bank, settle_tx, BmmCheck::Leader)));
+    }
