--- /dev/null
+++ b/runtime/src/bank/bmm.rs
@@ -0,0 +1,1031 @@
+//! sol-drivechain: the settle and credit pre-checks.
+//!
+//! `settle_bmm(H, M, S)` pays the payee of the commitment in eCash block M at
+//! height H. Each validator asks its own enforcer before the tx runs. The bank
+//! adds if Solana block S is in its block record, which holds only blocks of
+//! its own fork, and the credits of S from that record, checked against the
+//! active eCash chain. The answer goes to the bridge in the `BmmAnswer`
+//! account.
+//!
+//! `credit_deposits(H, M, first, count)` credits deposits of eCash block M at
+//! height H. Block M must have D confirmations, with D from the bridge config
+//! of the bank. The deposits go to the bridge in the `DepositAnswer` account.
+//!
+//! A question that the bridge refuses from the bank state alone gets a fixed
+//! answer at once, so the tx runs, fails, and pays its fee. That is a tx
+//! without a write lock on the bridge config, a settle below
+//! `bmm_next_height`, and a credit at or below `credited_height`, both from
+//! the config at the start of the bank.
+
+use {
+    super::Bank,
+    sol_drivechain_bmm::{
+        BLOCK_RECORD_LEN, BLOCK_RECORD_STRIDE, BMM_ANSWER_ID, BMM_BLOCKS_ID, BMM_PAID_ID,
+        BMM_PARAMS_ID, ChainParams, CreditQuestion, Credits, DEFAULT_CONFIRMATIONS,
+        DEPOSIT_ANSWER_ID, Lookup, PaidQuestion, Question, RecordAnswer, RecordedBlock, Wait,
+        answer_data, answers::answers, bmm_next_height, bundle_paid_question,
+        credit_deposits_question, deposit_answer_data, deposit_confirmations, find_recorded,
+        fork_choice, held::held, paid_answer_data, record_block, refused_deposit_answer_data,
+        settle_bmm_question, view,
+    },
+    solana_account::{Account, AccountSharedData, ReadableAccount, WritableAccount},
+    solana_hash::Hash,
+    solana_pubkey::Pubkey,
+    solana_runtime_transaction::transaction_with_meta::TransactionWithMeta,
+    solana_svm::account_loader::TransactionCheckResult,
+    solana_transaction_error::TransactionError,
+    std::time::Instant,
+};
+
+/// Who runs the batch, which sets the depth and the wait of the check.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum BmmCheck {
+    /// A leader. It needs N + 1 blocks on top, and it does not wait. The
+    /// banking stage tries a "not ready" tx again later, within the limits
+    /// of `held`.
+    Leader,
+    /// A simulation. It asks the same as a leader, and it keeps no answer.
+    Simulation,
+    /// Replay of a block from another validator. It needs N blocks on top,
+    /// and it waits for the local enforcer within `REPLAY_WAIT` per slot.
+    Replay,
+}
+
+impl BmmCheck {
+    pub(super) fn of(simulation: bool, leader_policy: bool) -> Self {
+        if simulation {
+            Self::Simulation
+        } else if leader_policy || sol_drivechain_bmm::in_block_production() {
+            Self::Leader
+        } else {
+            Self::Replay
+        }
+    }
+}
+
+/// A vote account with less than this part of the epoch stake pays its fee.
+const MIN_VOTE_STAKE_PARTS: u64 = 1_000;
+
+impl Bank {
+    /// Writes the parent into the block record when it is the last block of
+    /// its stride on this fork. No tx of this bank ran yet, so the bridge
+    /// config holds the credits of the parent.
+    pub(super) fn update_bmm_blocks(&self) {
+        if self.parent_slot.checked_div(BLOCK_RECORD_STRIDE)
+            == self.slot().checked_div(BLOCK_RECORD_STRIDE)
+        {
+            return;
+        }
+        let credits = self
+            .get_account(&sol_drivechain_bmm::config())
+            .and_then(|account| Credits::read(account.data()));
+        let block = RecordedBlock {
+            slot: self.parent_slot,
+            bank_hash: self.parent_hash.to_bytes(),
+            credited_height: credits.map_or(0, |credits| credits.credited_height),
+            credited_block: credits.map_or([0; 32], |credits| credits.credited_block),
+            part_block: credits.map_or([0; 32], |credits| credits.part_block),
+        };
+        self.update_sysvar_account(&BMM_BLOCKS_ID, |old| {
+            let mut account = match old {
+                Some(old) if old.data().len() == BLOCK_RECORD_LEN => old.clone(),
+                _ => AccountSharedData::from(Account {
+                    lamports: self.inherit_specially_retained_account_fields(old).0,
+                    data: vec![0; BLOCK_RECORD_LEN],
+                    owner: solana_sdk_ids::sysvar::id(),
+                    ..Account::default()
+                }),
+            };
+            record_block(account.data_as_mut_slice(), &block);
+            account
+        });
+    }
+
+    fn bmm_params(&self) -> Option<ChainParams> {
+        self.get_account(&BMM_PARAMS_ID)
+            .and_then(|account| ChainParams::read(account.data()))
+    }
+
+    /// N from the genesis.
+    fn bmm_confirmations(&self) -> u64 {
+        self.bmm_params()
+            .map_or(DEFAULT_CONFIRMATIONS, |params| params.confirmations)
+    }
+
+    /// The bridge config at the start of this bank. A tx of the same block
+    /// can move the cursors only up, so a check against this config gives the
+    /// same result in every order that a leader or a replay runs the txs.
+    fn bmm_start_config(&self) -> Option<Vec<u8>> {
+        self.parent()
+            .map_or_else(
+                || self.get_account(&sol_drivechain_bmm::config()),
+                |parent| parent.get_account(&sol_drivechain_bmm::config()),
+            )
+            .map(|account| account.data().to_vec())
+    }
+
+    fn bmm_recorded_block(&self, bank_hash: &[u8; 32]) -> Option<RecordedBlock> {
+        self.get_account(&BMM_BLOCKS_ID)
+            .and_then(|account| find_recorded(account.data(), bank_hash))
+    }
+
+    /// Answers the first top-level `settle_bmm`, `credit_deposits`, or
+    /// `bundle_paid` of each tx, or fails the tx. A replay of a slot at or below the start root
+    /// takes the answer of the first run, because an eCash reorg after that
+    /// run can drop the block that the tx names.
+    pub(super) fn check_bmm_settles(
+        &self,
+        sanitized_txs: &[impl TransactionWithMeta],
+        check_results: Vec<TransactionCheckResult>,
+        check: BmmCheck,
+    ) -> Vec<TransactionCheckResult> {
+        check_results
+            .into_iter()
+            .zip(sanitized_txs)
+            .map(|(result, tx)| {
+                let details = result?;
+                let Some((program_id_index, question)) =
+                    tx.program_instructions_iter()
+                        .find_map(|(program_id, instruction)| {
+                            BridgeQuestion::of(program_id, instruction.data)
+                                .map(|question| (instruction.program_id_index, question))
+                        })
+                else {
+                    return Ok(details);
+                };
+                let signature: Option<[u8; 64]> = tx.signature().as_ref().try_into().ok();
+                let answer = match self.recorded_answer(signature.as_ref(), check) {
+                    Some(answer) => Lookup::Ready(answer),
+                    None => self.bridge_answer(tx, &question, signature.as_ref(), check),
+                };
+                let (key, data) = match answer {
+                    Lookup::Ready(answer) => {
+                        if let Some(signature) = &signature {
+                            held().release(signature);
+                        }
+                        answer
+                    }
+                    // Only a leader drops a tx, so the other checks report
+                    // both the same way.
+                    Lookup::Never if check != BmmCheck::Leader => {
+                        log::debug!(
+                            "the BMM view can give no answer for {question:?} as {check:?}"
+                        );
+                        return Err(TransactionError::ProgramExecutionTemporarilyRestricted {
+                            account_index: program_id_index,
+                        });
+                    }
+                    Lookup::NotYet
+                        if check != BmmCheck::Leader
+                            || signature.is_some_and(|signature| {
+                                self.can_pay_fee(tx.fee_payer(), details.fee_details().total_fee())
+                                    && held().admit(&signature, tx.fee_payer(), Instant::now())
+                            }) =>
+                    {
+                        log::debug!("the BMM view has no answer yet for {question:?} as {check:?}");
+                        return Err(TransactionError::ProgramExecutionTemporarilyRestricted {
+                            account_index: program_id_index,
+                        });
+                    }
+                    Lookup::NotYet | Lookup::Never => {
+                        log::debug!(
+                            "the BMM view can give no answer for {question:?} as {check:?}"
+                        );
+                        return Err(TransactionError::InvalidProgramForExecution);
+                    }
+                };
+                let account = AccountSharedData::from(Account {
+                    data,
+                    owner: solana_sdk_ids::sysvar::id(),
+                    ..Account::default()
+                });
+                Ok(details.with_runtime_account(key, account))
+            })
+            .collect()
+    }
+
+    /// A simple vote pays no signature fee when its vote account holds stake
+    /// in the epoch stakes and the authorized voter of that account signs
+    /// it. Every other tx pays, so a free vote needs stake.
+    pub(super) fn waive_staked_vote_fees(
+        &self,
+        sanitized_txs: &[impl TransactionWithMeta],
+        check_results: Vec<TransactionCheckResult>,
+    ) -> Vec<TransactionCheckResult> {
+        check_results
+            .into_iter()
+            .zip(sanitized_txs)
+            .map(|(result, tx)| {
+                let details = result?;
+                Ok(if self.is_staked_vote(tx) {
+                    details.without_signature_fee()
+                } else {
+                    details
+                })
+            })
+            .collect()
+    }
+
+    /// True for a simple vote that pays no signature fee: its vote account
+    /// holds at least 1/`MIN_VOTE_STAKE_PARTS` of the epoch stake and its
+    /// authorized voter signs it.
+    pub fn is_staked_vote(&self, tx: &impl TransactionWithMeta) -> bool {
+        tx.is_simple_vote_transaction() && self.is_staked_vote_message(tx)
+    }
+
+    /// The same rule for a message alone, as a fee estimate sees it.
+    pub(super) fn is_staked_simple_vote_message(
+        &self,
+        message: &impl solana_svm_transaction::svm_message::SVMMessage,
+    ) -> bool {
+        let signatures = vec![
+            solana_signature::Signature::default();
+            usize::try_from(message.num_transaction_signatures())
+                .unwrap_or(usize::MAX)
+        ];
+        let simple =
+            solana_transaction::simple_vote_transaction_checker::is_simple_vote_transaction_impl(
+                &signatures,
+                message.version() == solana_transaction::versioned::TransactionVersion::LEGACY,
+                message
+                    .program_instructions_iter()
+                    .map(|(program_id, _)| program_id),
+            );
+        simple && self.is_staked_vote_message(message)
+    }
+
+    fn is_staked_vote_message(
+        &self,
+        tx: &impl solana_svm_transaction::svm_message::SVMMessage,
+    ) -> bool {
+        let Some((_, instruction)) = tx.program_instructions_iter().next() else {
+            return false;
+        };
+        let account_keys = tx.account_keys();
+        let Some(vote_key) = instruction
+            .accounts
+            .first()
+            .and_then(|index| account_keys.get(usize::from(*index)))
+        else {
+            return false;
+        };
+        let Some((stake, vote_account)) = self.get_current_epoch_vote_accounts().get(vote_key)
+        else {
+            return false;
+        };
+        if stake.saturating_mul(MIN_VOTE_STAKE_PARTS) < self.get_current_epoch_total_stake() {
+            return false;
+        }
+        let Some(voter) = vote_account
+            .vote_state_view()
+            .get_authorized_voter(self.epoch())
+        else {
+            return false;
+        };
+        account_keys
+            .iter()
+            .position(|key| key == voter)
+            .is_some_and(|index| tx.is_signer(index))
+    }
+
+    /// True when `payer` holds `fee`, so a held tx can pay when it runs.
+    fn can_pay_fee(&self, payer: &Pubkey, fee: u64) -> bool {
+        self.get_account(payer)
+            .is_some_and(|account| account.lamports() >= fee.max(1))
+    }
+
+    fn recorded_answer(
+        &self,
+        signature: Option<&[u8; 64]>,
+        check: BmmCheck,
+    ) -> Option<(Pubkey, Vec<u8>)> {
+        if check != BmmCheck::Replay {
+            return None;
+        }
+        let answer = answers().recorded(self.slot(), signature?)?;
+        log::debug!(
+            "the replay of slot {} takes the answer of its first run",
+            self.slot()
+        );
+        Some(answer)
+    }
+
+    /// The answer from the bank state, or else from the view. A view answer
+    /// waits in `answers` for the freeze of this bank.
+    fn bridge_answer(
+        &self,
+        tx: &impl TransactionWithMeta,
+        question: &BridgeQuestion,
+        signature: Option<&[u8; 64]>,
+        check: BmmCheck,
+    ) -> Lookup<(Pubkey, Vec<u8>)> {
+        let config_index = tx
+            .account_keys()
+            .iter()
+            .position(|key| key == &sol_drivechain_bmm::config());
+        let config = config_index
+            .filter(|index| tx.is_writable(*index))
+            .and_then(|_| self.bmm_start_config());
+        let wait = match check {
+            BmmCheck::Leader | BmmCheck::Simulation => Wait::No,
+            BmmCheck::Replay => Wait::Replay { slot: self.slot() },
+        };
+        let answer = match (question, config) {
+            (BridgeQuestion::Settle(question), None) => refused_settle(question),
+            (BridgeQuestion::Credit(question), None) => refused_credit(question),
+            (BridgeQuestion::Settle(question), Some(config)) => {
+                self.settle_answer(question, &config, check, wait)
+            }
+            (BridgeQuestion::Credit(question), Some(config)) => {
+                self.credit_answer(question, &config, check, wait)
+            }
+            (BridgeQuestion::Paid(question), None) => unpaid(question),
+            (BridgeQuestion::Paid(question), Some(_)) => self.paid_answer(question, check, wait),
+        };
+        let Lookup::Ready(Answer { key, data, kept }) = answer else {
+            return answer.map(|answer| (answer.key, answer.data));
+        };
+        if kept
+            && check != BmmCheck::Simulation
+            && let Some(signature) = signature
+        {
+            answers().note(
+                self.slot(),
+                signature,
+                &tx.recent_blockhash().to_bytes(),
+                &key,
+                &data,
+            );
+        }
+        Lookup::Ready((key, data))
+    }
+
+    /// Status 1 when block M at H, with K blocks on top for a replay and one
+    /// more for a leader, holds a Succeeded event for the M6ID.
+    fn paid_answer(&self, question: &PaidQuestion, check: BmmCheck, wait: Wait) -> Lookup<Answer> {
+        let root_depth = self
+            .bmm_params()
+            .map_or(fork_choice::params().root_depth, |params| params.root_depth);
+        let depth = match check {
+            BmmCheck::Leader | BmmCheck::Simulation => root_depth.saturating_add(1),
+            BmmCheck::Replay => root_depth,
+        };
+        view()
+            .deep_block(
+                question.height,
+                &question.block_hash,
+                depth,
+                question.height,
+                wait,
+            )
+            .map(|block| Answer {
+                key: BMM_PAID_ID,
+                data: paid_answer_data(question, block.paid.contains(&question.m6id)).to_vec(),
+                kept: true,
+            })
+    }
+
+    fn settle_answer(
+        &self,
+        question: &Question,
+        config: &[u8],
+        check: BmmCheck,
+        wait: Wait,
+    ) -> Lookup<Answer> {
+        let Some(next_height) = bmm_next_height(config) else {
+            return refused_settle(question);
+        };
+        if question.height < next_height {
+            return refused_settle(question);
+        }
+        let depth = match check {
+            BmmCheck::Leader | BmmCheck::Simulation => self.bmm_confirmations().saturating_add(1),
+            BmmCheck::Replay => self.bmm_confirmations(),
+        };
+        let height = question.height;
+        let commitment = match view().answer(height, &question.block_hash, depth, height, wait) {
+            Lookup::Ready(commitment) => commitment,
+            Lookup::NotYet => return Lookup::NotYet,
+            Lookup::Never => return Lookup::Never,
+        };
+        let record = match self.bmm_recorded_block(&question.solana_block) {
+            Some(block) => match self.bmm_record_answer(&block, config, height, wait) {
+                Lookup::Ready(record) => Some(record),
+                Lookup::NotYet => return Lookup::NotYet,
+                Lookup::Never => return Lookup::Never,
+            },
+            None => None,
+        };
+        Lookup::Ready(Answer {
+            key: BMM_ANSWER_ID,
+            data: answer_data(question, commitment, record).to_vec(),
+            kept: true,
+        })
+    }
+
+    /// Rule 3 for a settle at eCash height `height` of the recorded block
+    /// `block`, with the same check as the fork choice.
+    fn bmm_record_answer(
+        &self,
+        block: &RecordedBlock,
+        config: &[u8],
+        height: u64,
+        wait: Wait,
+    ) -> Lookup<RecordAnswer> {
+        let Some(lag) = Credits::read(config).map(|credits| credits.lag) else {
+            return Lookup::Never;
+        };
+        let floor = height.saturating_sub(lag);
+        let mut blocked = None;
+        let answer = fork_choice::record_answer(block, lag, height, |at| {
+            match view().hash_at(at, floor, wait) {
+                Lookup::Ready(hash) => Some(hash),
+                other => {
+                    blocked.get_or_insert(other.map(|_| ()));
+                    None
+                }
+            }
+        });
+        match (answer, blocked) {
+            (Some(answer), _) => Lookup::Ready(answer),
+            (None, Some(Lookup::Never)) => Lookup::Never,
+            (None, _) => Lookup::NotYet,
+        }
+    }
+
+    /// A block with D confirmations has D - 1 blocks on top of it.
+    fn credit_answer(
+        &self,
+        question: &CreditQuestion,
+        config: &[u8],
+        check: BmmCheck,
+        wait: Wait,
+    ) -> Lookup<Answer> {
+        let (Some(credits), Some(confirmations), Some(params)) = (
+            Credits::read(config),
+            deposit_confirmations(config),
+            self.bmm_params(),
+        ) else {
+            return refused_credit(question);
+        };
+        if question.height <= credits.credited_height {
+            return refused_credit(question);
+        }
+        let on_top = confirmations.saturating_sub(1);
+        let depth = match check {
+            BmmCheck::Leader | BmmCheck::Simulation => on_top.saturating_add(1),
+            BmmCheck::Replay => on_top,
+        };
+        let height = question.height;
+        view()
+            .deep_block(height, &question.block_hash, depth, height, wait)
+            .map(|block| Answer {
+                key: DEPOSIT_ANSWER_ID,
+                data: deposit_answer_data(question, &block, params.sidechain_slot),
+                kept: true,
+            })
+    }
+
+    /// Writes the answers of the committed txs of this bank to the answers
+    /// file. A failed write stops the validator, because a later replay
+    /// needs the answer.
+    pub(super) fn keep_bmm_answers(&self, bank_hash: &Hash) {
+        let slot = self.slot();
+        let status_cache = self.status_cache.read().unwrap();
+        let kept = answers().freeze(slot, &bank_hash.to_bytes(), |signature, blockhash| {
+            status_cache
+                .get_status(
+                    solana_signature::Signature::from(*signature),
+                    &Hash::new_from_array(*blockhash),
+                    &self.ancestors,
+                )
+                .is_some_and(|(status_slot, _)| status_slot == slot)
+        });
+        if let Err(error) = kept {
+            panic!("cannot keep the BMM answers of slot {slot}: {error}");
+        }
+    }
+}
+
+struct Answer {
+    key: Pubkey,
+    data: Vec<u8>,
+    /// False for an answer from the bank state alone, which every replay
+    /// gives again.
+    kept: bool,
+}
+
+fn refused_settle(question: &Question) -> Lookup<Answer> {
+    Lookup::Ready(Answer {
+        key: BMM_ANSWER_ID,
+        data: answer_data(question, None, None).to_vec(),
+        kept: false,
+    })
+}
+
+fn refused_credit(question: &CreditQuestion) -> Lookup<Answer> {
+    Lookup::Ready(Answer {
+        key: DEPOSIT_ANSWER_ID,
+        data: refused_deposit_answer_data(question),
+        kept: false,
+    })
+}
+
+fn unpaid(question: &PaidQuestion) -> Lookup<Answer> {
+    Lookup::Ready(Answer {
+        key: BMM_PAID_ID,
+        data: paid_answer_data(question, false).to_vec(),
+        kept: false,
+    })
+}
+
+#[derive(Clone, Copy, Debug)]
+enum BridgeQuestion {
+    Settle(Question),
+    Credit(CreditQuestion),
+    Paid(PaidQuestion),
+}
+
+impl BridgeQuestion {
+    fn of(program_id: &Pubkey, data: &[u8]) -> Option<Self> {
+        settle_bmm_question(program_id, data)
+            .map(Self::Settle)
+            .or_else(|| credit_deposits_question(program_id, data).map(Self::Credit))
+            .or_else(|| bundle_paid_question(program_id, data).map(Self::Paid))
+    }
+}
