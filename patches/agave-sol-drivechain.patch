+//! What this validator and its staked peers know about the banks of BMM
+//! checkpoints. A checkpoint for a bank that this node does not hold counts
+//! toward a restart only when a staked peer says that it holds that bank.
+
+use {
+    crate::fork_choice::{BankHash, Slot},
+    std::{
+        collections::{HashMap, HashSet},
+        sync::{Mutex, OnceLock},
+    },
+};
+
+/// A node identity.
+pub type NodeId = [u8; 32];
+
+/// The most banks that one question to a peer names.
+pub const MAX_WANTED: usize = 64;
+
+/// A reply to `bmmKnownBanks` holds at most this old a time, in seconds.
+pub const MAX_REPLY_AGE: u64 = 60;
+
+/// The bytes that a node signs in a reply to `bmmKnownBanks`: the node, the
+/// asked banks, its slots, the nonce of the asker, and the time in seconds.
+pub fn known_banks_message(
+    node: &NodeId,
+    bank_hashes: &[BankHash],
+    slots: &[Option<Slot>],
+    nonce: &[u8; 32],
+    timestamp: u64,
+) -> Vec<u8> {
+    let mut message = b"sol-drivechain bmmKnownBanks v1".to_vec();
+    message.extend_from_slice(node);
+    message.extend_from_slice(nonce);
+    message.extend_from_slice(&timestamp.to_le_bytes());
+    message.extend_from_slice(&(bank_hashes.len() as u64).to_le_bytes());
+    for (bank_hash, slot) in bank_hashes.iter().zip(slots) {
+        message.extend_from_slice(bank_hash);
+        match slot {
+            Some(slot) => {
+                message.push(1);
+                message.extend_from_slice(&slot.to_le_bytes());
+            }
+            None => message.push(0),
+        }
+    }
+    message
+}
+
+#[derive(Default)]
+struct State {
+    known: HashMap<BankHash, Slot>,
+    wanted: Vec<BankHash>,
+    attested: HashMap<BankHash, HashMap<NodeId, Slot>>,
+    generation: u64,
+}
+
+#[derive(Default)]
+pub struct Peers {
+    state: Mutex<State>,
+}
+
+/// The bank knowledge that the fork choice, the RPC, and the peer sync share.
+pub fn peers() -> &'static Peers {
+    static PEERS: OnceLock<Peers> = OnceLock::new();
+    PEERS.get_or_init(Peers::default)
+}
+
+impl Peers {
+    /// Sets the banks that this node holds: the frozen banks, the block
+    /// record of the root, and the anchors.
+    pub fn set_known(&self, known: HashMap<BankHash, Slot>) {
+        self.state.lock().unwrap().known = known;
+    }
+
+    /// The slot of a bank that this node holds.
+    pub fn known_slot(&self, bank_hash: &BankHash) -> Option<Slot> {
+        self.state.lock().unwrap().known.get(bank_hash).copied()
+    }
+
+    /// Sets the banks of the checkpoints that this node does not hold, the
+    /// newest last. It keeps the newest `MAX_WANTED`.
+    pub fn set_wanted(&self, mut wanted: Vec<BankHash>) {
+        let excess = wanted.len().saturating_sub(MAX_WANTED);
+        wanted.drain(..excess);
+        let mut state = self.state.lock().unwrap();
+        state
+            .attested
+            .retain(|bank_hash, _| wanted.contains(bank_hash));
+        state.wanted = wanted;
+    }
+
+    pub fn wanted(&self) -> Vec<BankHash> {
+        self.state.lock().unwrap().wanted.clone()
+    }
+
+    /// Keeps that the staked peer `node` holds the bank `bank_hash` at `slot`.
+    pub fn attest(&self, bank_hash: &BankHash, node: NodeId, slot: Slot) {
+        let mut state = self.state.lock().unwrap();
+        if state.wanted.contains(bank_hash)
+            && state
+                .attested
+                .entry(*bank_hash)
+                .or_default()
+                .insert(node, slot)
+                != Some(slot)
+        {
+            state.generation = state.generation.wrapping_add(1);
+        }
+    }
+
+    /// Forgets that `node` holds `bank_hash`, after it said that it does not.
+    pub fn withdraw(&self, bank_hash: &BankHash, node: &NodeId) {
+        let mut state = self.state.lock().unwrap();
+        if state
+            .attested
+            .get_mut(bank_hash)
+            .is_some_and(|nodes| nodes.remove(node).is_some())
+        {
+            state.generation = state.generation.wrapping_add(1);
+        }
+    }
+
+    /// Drops the attestations of every node outside `staked`, the peers
+    /// that hold stake now.
+    pub fn retain_nodes(&self, staked: &HashSet<NodeId>) {
+        let mut state = self.state.lock().unwrap();
+        let mut removed = false;
+        for nodes in state.attested.values_mut() {
+            let before = nodes.len();
+            nodes.retain(|node, _| staked.contains(node));
+            removed |= nodes.len() != before;
+        }
+        if removed {
+            state.generation = state.generation.wrapping_add(1);
+        }
+    }
+
+    /// A number that changes at each new or withdrawn attestation.
+    pub fn generation(&self) -> u64 {
+        self.state.lock().unwrap().generation
+    }
+
+    /// The staked peers that hold the bank `bank_hash`.
+    pub fn attesters(&self, bank_hash: &BankHash) -> Vec<NodeId> {
+        let state = self.state.lock().unwrap();
+        let mut nodes: Vec<NodeId> = state
+            .attested
+            .get(bank_hash)
+            .map(|nodes| nodes.keys().copied().collect())
+            .unwrap_or_default();
+        nodes.sort_unstable();
+        nodes
+    }
+
+    /// The slots at which the staked peers say that they hold `bank_hash`.
+    pub fn attested_slots(&self, bank_hash: &BankHash) -> Vec<Slot> {
+        let state = self.state.lock().unwrap();
+        let mut slots: Vec<Slot> = state
+            .attested
+            .get(bank_hash)
+            .map(|nodes| nodes.values().copied().collect())
+            .unwrap_or_default();
+        slots.sort_unstable();
+        slots.dedup();
+        slots
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_wanted_bank_takes_an_attestation() {
+        let peers = Peers::default();
+        peers.attest(&[1; 32], [9; 32], 5);
+        assert!(peers.attesters(&[1; 32]).is_empty());
+        peers.set_wanted(vec![[1; 32]]);
+        let before = peers.generation();
+        peers.attest(&[1; 32], [9; 32], 5);
+        peers.attest(&[1; 32], [9; 32], 5);
+        assert_eq!(peers.attesters(&[1; 32]), vec![[9; 32]]);
+        assert_eq!(peers.generation(), before.wrapping_add(1));
+        peers.set_wanted(vec![[2; 32]]);
+        assert!(peers.attesters(&[1; 32]).is_empty());
+    }
+
+    #[test]
+    fn the_attested_slots_hold_each_slot_that_a_peer_names() {
+        let peers = Peers::default();
+        peers.set_wanted(vec![[1; 32]]);
+        peers.attest(&[1; 32], [9; 32], 7);
+        peers.attest(&[1; 32], [8; 32], 7);
+        peers.attest(&[1; 32], [7; 32], 6);
+        assert_eq!(peers.attested_slots(&[1; 32]), vec![6, 7]);
+        let before = peers.generation();
+        peers.attest(&[1; 32], [9; 32], 8);
+        assert_ne!(peers.generation(), before);
+        peers.withdraw(&[1; 32], &[7; 32]);
+        assert_eq!(peers.attested_slots(&[1; 32]), vec![7, 8]);
+    }
+
+    #[test]
+    fn a_peer_that_no_longer_holds_a_bank_stops_counting() {
+        let peers = Peers::default();
+        peers.set_wanted(vec![[1; 32]]);
+        peers.attest(&[1; 32], [9; 32], 5);
+        peers.attest(&[1; 32], [8; 32], 5);
+        let before = peers.generation();
+        peers.withdraw(&[1; 32], &[9; 32]);
+        assert_eq!(peers.attesters(&[1; 32]), vec![[8; 32]]);
+        assert_ne!(peers.generation(), before);
+        let after = peers.generation();
+        peers.withdraw(&[1; 32], &[9; 32]);
+        assert_eq!(peers.generation(), after);
+    }
+
+    #[test]
+    fn a_peer_without_stake_stops_counting() {
+        let peers = Peers::default();
+        peers.set_wanted(vec![[1; 32]]);
+        peers.attest(&[1; 32], [9; 32], 5);
+        peers.attest(&[1; 32], [8; 32], 5);
+        let before = peers.generation();
+        peers.retain_nodes(&HashSet::from([[8; 32]]));
+        assert_eq!(peers.attesters(&[1; 32]), vec![[8; 32]]);
+        assert_ne!(peers.generation(), before);
+        let after = peers.generation();
+        peers.retain_nodes(&HashSet::from([[8; 32]]));
+        assert_eq!(peers.generation(), after);
+    }
+
+    #[test]
+    fn the_wanted_list_keeps_the_newest() {
+        let peers = Peers::default();
+        let wanted: Vec<BankHash> = (0..=MAX_WANTED as u8).map(|byte| [byte; 32]).collect();
+        peers.set_wanted(wanted);
+        let kept = peers.wanted();
+        assert_eq!(kept.len(), MAX_WANTED);
+        assert_eq!(kept.first(), Some(&[1; 32]));
+    }
+
+    #[test]
+    fn the_known_banks_give_their_slots() {
+        let peers = Peers::default();
+        peers.set_known(HashMap::from([([3; 32], 30)]));
+        assert_eq!(peers.known_slot(&[3; 32]), Some(30));
+        assert_eq!(peers.known_slot(&[4; 32]), None);
+    }
+}
diff --git a/sol-drivechain-bmm/src/poller.rs b/sol-drivechain-bmm/src/poller.rs
new file mode 100644
index 0000000..92b4529
--- /dev/null
+++ b/sol-drivechain-bmm/src/poller.rs
@@ -0,0 +1,420 @@
+//! Copies the active eCash chain from the local enforcer into the view.
+
+use {
+    crate::{
+        Block, BlockHash, BmmView,
+        enforcer::{Enforcer, EnforcerError, Header, decode_block_hash},
+        view,
+    },
+    std::{
+        collections::HashMap,
+        sync::{
+            Arc,
+            atomic::{AtomicBool, Ordering},
+        },
+        thread::JoinHandle,
+        time::Duration,
+    },
+};
+
+/// At start, the view reads this many blocks below the tip.
+const INITIAL_WINDOW: u64 = 4032;
+
+/// A tip change first reads this many blocks, then doubles until the new
+/// blocks connect to the view.
+const FIRST_REORG_SPAN: u64 = 16;
+
+/// The largest ancestor count in one enforcer call.
+const MAX_BATCH: u64 = 1000;
+
+const POLL_INTERVAL: Duration = Duration::from_millis(500);
+const RETRY_INTERVAL: Duration = Duration::from_secs(1);
+
+/// After this many failures in a row, the poller writes an error, not a
+/// warning. At one second per try that is about one minute.
+const FAILURES_BEFORE_ALARM: u32 = 60;
+
+/// While the enforcer stays away, the poller repeats the error this often.
+const FAILURES_BETWEEN_ALARMS: u32 = 300;
+
+/// Starts the thread that keeps the view in step with the enforcer at
+/// `enforcer_url`, for the sidechain in `sidechain_slot`.
+pub fn start_poller(
+    enforcer_url: String,
+    sidechain_slot: u8,
+    exit: Arc<AtomicBool>,
+) -> std::io::Result<JoinHandle<()>> {
+    view().set_source(exit.clone());
+    std::thread::Builder::new()
+        .name("solBmmPoller".to_owned())
+        .spawn(move || {
+            let runtime = match tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+            {
+                Ok(runtime) => runtime,
+                Err(error) => {
+                    log::error!("the BMM poller cannot start a tokio runtime: {error}");
+                    return;
+                }
+            };
+            runtime.block_on(poll(enforcer_url, sidechain_slot, exit));
+        })
+}
+
+/// True when a failure count deserves an error in the log. An operator must
+/// see a stalled enforcer before a settle arrives, because the validator
+/// rejects a block with a settle that it cannot check.
+pub(crate) fn alarm_now(failures: u32) -> bool {
+    match failures.checked_sub(FAILURES_BEFORE_ALARM) {
+        None => false,
+        Some(0) => true,
+        Some(since_alarm) => since_alarm.is_multiple_of(FAILURES_BETWEEN_ALARMS),
+    }
+}
+
+async fn poll(enforcer_url: String, sidechain_slot: u8, exit: Arc<AtomicBool>) {
+    let mut enforcer = None;
+    let mut failures: u32 = 0;
+    while !exit.load(Ordering::Relaxed) {
+        let connected = match enforcer.as_mut() {
+            Some(connected) => connected,
+            None => match Enforcer::connect(&enforcer_url).await {
+                Ok(connected) => {
+                    log::info!("the BMM poller reads eCash from {enforcer_url}");
+                    failures = 0;
+                    enforcer.insert(connected)
+                }
+                Err(error) => {
+                    view().mark_failed();
+                    failures = failures.saturating_add(1);
+                    report(failures, &error.to_string());
+                    tokio::time::sleep(RETRY_INTERVAL).await;
+                    continue;
+                }
+            },
+        };
+        match sync(connected, sidechain_slot, view()).await {
+            Ok(()) => {
+                view().mark_synced();
+                failures = 0;
+                tokio::time::sleep(POLL_INTERVAL).await;
+            }
+            Err(error) => {
+                view().mark_failed();
+                failures = failures.saturating_add(1);
+                report(failures, &error.to_string());
+                enforcer = None;
+                tokio::time::sleep(RETRY_INTERVAL).await;
+            }
+        }
+    }
+}
+
+fn report(failures: u32, error: &str) {
+    if alarm_now(failures) {
+        log::error!(
+            "the BMM poller cannot read eCash after {failures} tries: {error}. This validator \
+             rejects every block with a BMM settle until the enforcer answers again."
+        );
+    } else {
+        log::warn!("the BMM poller failed, and it connects again: {error}");
+    }
+}
+
+/// Brings the view to the enforcer tip, and fills any old heights that a
+/// caller asked for.
+async fn sync(
+    enforcer: &mut Enforcer,
+    sidechain_slot: u8,
+    view: &BmmView,
+) -> Result<(), EnforcerError> {
+    let tip = enforcer.chain_tip().await?;
+    let tip_hash = decode_block_hash(&tip.hash)?;
+    if view.tip() != Some((tip.height, tip_hash)) {
+        follow_tip(enforcer, sidechain_slot, view, &tip).await?;
+    }
+    backfill(enforcer, sidechain_slot, view).await
+}
+
+/// True when a run of new blocks joins the view. The parent of its lowest
+/// block must be the block that the view holds at that height. Without this
+/// test a jump of the tip leaves a gap, and every height in the gap stays
+/// unanswered.
+pub(crate) fn connects(lowest: u64, oldest_prev_hash: &BlockHash, parent: Option<Block>) -> bool {
+    lowest == 0 || parent.is_some_and(|parent| &parent.hash == oldest_prev_hash)
+}
+
+/// Reads blocks down from the tip until they connect to the view, then puts
+/// them in place of the old blocks at those heights.
+async fn follow_tip(
+    enforcer: &mut Enforcer,
+    sidechain_slot: u8,
+    view: &BmmView,
+    tip: &Header,
+) -> Result<(), EnforcerError> {
+    let mut span = if view.tip().is_none() {
+        INITIAL_WINDOW
+    } else {
+        FIRST_REORG_SPAN
+    };
+    loop {
+        let from = tip.height.saturating_sub(span);
+        let blocks = read_down(enforcer, sidechain_slot, &tip.hash, tip.height, from).await?;
+        let Some((lowest, oldest_prev_hash)) = blocks
+            .first()
+            .map(|(height, block)| (*height, block.prev_hash))
+        else {
+            return Ok(());
+        };
+        let parent = lowest.checked_sub(1).and_then(|below| view.block_at(below));
+        let joins = connects(lowest, &oldest_prev_hash, parent);
+        if joins || span >= INITIAL_WINDOW {
+            if !joins {
+                log::warn!(
+                    "the BMM view reaches only eCash height {lowest}, and the heights below it \
+                     stay unanswered until a backfill"
+                );
+            }
+            log::debug!(
+                "the BMM view takes eCash heights {lowest} to {} from the enforcer",
+                tip.height
+            );
+            view.replace_from(&blocks);
+            return Ok(());
+        }
+        span = span.saturating_mul(2).min(INITIAL_WINDOW);
+    }
+}
+
+/// The heights that one backfill step reads. The next tip read comes
+/// between two steps.
+pub(crate) fn backfill_span(below: u64, wanted: u64) -> Option<(u64, u64)> {
+    (wanted <= below).then(|| (below, wanted.max(below.saturating_sub(MAX_BATCH - 1))))
+}
+
+/// Reads one step of the heights below the view that a question asked for.
+async fn backfill(
+    enforcer: &mut Enforcer,
+    sidechain_slot: u8,
+    view: &BmmView,
+) -> Result<(), EnforcerError> {
+    let (Some(wanted), Some(lowest)) = (view.wanted_low(), view.lowest()) else {
+        return Ok(());
+    };
+    let (Some(below), Some(block)) = (lowest.checked_sub(1), view.block_at(lowest)) else {
+        return Ok(());
+    };
+    let Some((top, from)) = backfill_span(below, wanted) else {
+        return Ok(());
+    };
+    let blocks = read_down(
+        enforcer,
+        sidechain_slot,
+        &reverse_hex(&block.prev_hash),
+        top,
+        from,
+    )
+    .await?;
+    view.extend_below(&blocks);
+    Ok(())
+}
+
+/// A block hash in the reversed hex of the enforcer.
+fn reverse_hex(hash: &BlockHash) -> String {
+    hex::encode(hash.iter().rev().copied().collect::<Vec<_>>())
+}
+
+/// Reads the blocks from `top` (at `top_height`) down to `from`, with their
+/// deposits, and returns them from low to high. It returns fewer if the
+/// enforcer holds no BMM data below its start height.
+async fn read_down(
+    enforcer: &mut Enforcer,
+    sidechain_slot: u8,
+    top: &str,
+    top_height: u64,
+    from: u64,
+) -> Result<Vec<(u64, Block)>, EnforcerError> {
+    let mut blocks = Vec::new();
+    let mut cursor_hash = top.to_owned();
+    let mut cursor_height = top_height;
+    loop {
+        let span = cursor_height.saturating_sub(from).min(MAX_BATCH);
+        let ancestors = u32::try_from(span).unwrap_or(u32::MAX);
+        let commitments = enforcer
+            .commitments(&cursor_hash, sidechain_slot, ancestors)
+            .await?;
+        let headers = enforcer.headers(&cursor_hash, ancestors).await?;
+        let count = commitments.len().min(headers.len());
+        for (header, commitment) in headers.iter().zip(commitments).take(count) {
+            blocks.push((
+                header.height,
+                Block {
+                    hash: decode_block_hash(&header.hash)?,
+                    prev_hash: decode_block_hash(&header.prev_hash)?,
+                    commitment,
+                    deposits: Arc::from([]),
+                    paid: Arc::from([]),
+                },
+            ));
+        }
+        let Some(oldest) = count.checked_sub(1).and_then(|index| headers.get(index)) else {
+            break;
+        };
+        let Some(below) = oldest.height.checked_sub(1) else {
+            break;
+        };
+        if oldest.height <= from || (count as u64) <= span {
+            break;
+        }
+        cursor_hash = oldest.prev_hash.clone();
+        cursor_height = below;
+    }
+    blocks.reverse();
+    read_deposits(enforcer, sidechain_slot, &mut blocks).await?;
+    Ok(blocks)
+}
+
+/// Puts the deposits and the paid M6IDs of each block of `blocks`, from low
+/// to high, in place.
+/// A reply above the size limit splits its span in two, down to one block,
+/// so a large block cannot stop the reads of the other blocks.
+async fn read_deposits(
+    enforcer: &mut Enforcer,
+    sidechain_slot: u8,
+    blocks: &mut [(u64, Block)],
+) -> Result<(), EnforcerError> {
+    let mut parts = vec![(0, blocks.len())];
+    while let Some((first, end)) = parts.pop() {
+        let (Some((lowest, oldest)), Some((highest, newest))) = (
+            blocks.get(first),
+            end.checked_sub(1).and_then(|last| blocks.get(last)),
+        ) else {
+            continue;
+        };
+        let start = (*lowest > 0).then(|| reverse_hex(&oldest.prev_hash));
+        let read = match enforcer
+            .deposits(sidechain_slot, start.as_deref(), &reverse_hex(&newest.hash))
+            .await
+        {
+            Ok(read) => read,
+            Err(error) if error.is_reply_too_large() && end.saturating_sub(first) > 1 => {
+                let middle = first.midpoint(end);
+                log::warn!(
+                    "the enforcer reply for eCash heights {lowest} to {highest} is too large, and \
+                     the poller reads it in two parts: {error}"
+                );
+                parts.push((middle, end));
+                parts.push((first, middle));
+                continue;
+            }
+            Err(error) => return Err(error),
+        };
+        let mut events: HashMap<BlockHash, _> = read
+            .into_iter()
+            .map(|(hash, deposits, paid)| (hash, (deposits, paid)))
+            .collect();
+        for (_, block) in &mut blocks[first..end] {
+            if let Some((deposits, paid)) = events.remove(&block.hash) {
+                block.deposits = Arc::from(deposits);
+                block.paid = Arc::from(paid);
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use {
+        super::*,
+        crate::{
+            Deposit,
+            enforcer::{MAX_REPLY_BYTES, fake},
+        },
+    };
+
+    fn block(byte: u8, prev: u8) -> Block {
+        Block {
+            hash: [byte; 32],
+            prev_hash: [prev; 32],
+            commitment: None,
+            deposits: Arc::from([]),
+            paid: Arc::from([]),
+        }
+    }
+
+    #[tokio::test]
+    async fn a_span_with_too_much_peg_data_splits_until_each_part_fits() {
+        let deposit = |sequence_number, len| Deposit {
+            sequence_number,
+            value_sats: 5000,
+            address: vec![b'a'; len],
+        };
+        let heavy = MAX_REPLY_BYTES * 3 / 10;
+        let mut chain: Vec<(u64, Block)> = (1..=8)
+            .map(|height| (height, block(height as u8, height as u8 - 1)))
+            .collect();
+        chain[2].1.deposits = Arc::from([deposit(1, heavy)]);
+        chain[3].1.deposits = Arc::from([deposit(2, heavy)]);
+        chain[5].1.deposits = Arc::from([deposit(3, 10)]);
+        chain[4].1.paid = Arc::from([[0x55; 32]]);
+        chain[5].1.paid = Arc::from([[0x66; 32], [0x67; 32]]);
+        let url = fake::serve(chain.clone());
+        let mut enforcer = Enforcer::connect(&url).await.unwrap();
+        let mut blocks: Vec<(u64, Block)> = chain
+            .iter()
+            .map(|(height, found)| {
+                (
+                    *height,
+                    Block {
+                        deposits: Arc::from([]),
+                        paid: Arc::from([]),
+                        ..found.clone()
+                    },
+                )
+            })
+            .collect();
+        read_deposits(&mut enforcer, 8, &mut blocks).await.unwrap();
+        assert_eq!(blocks, chain);
+    }
+
+    #[test]
+    fn the_alarm_waits_for_a_minute_and_then_repeats() {
+        assert!(!alarm_now(1));
+        assert!(!alarm_now(FAILURES_BEFORE_ALARM - 1));
+        assert!(alarm_now(FAILURES_BEFORE_ALARM));
+        assert!(!alarm_now(FAILURES_BEFORE_ALARM + 1));
+        assert!(alarm_now(FAILURES_BEFORE_ALARM + FAILURES_BETWEEN_ALARMS));
+        assert!(alarm_now(
+            FAILURES_BEFORE_ALARM + 2 * FAILURES_BETWEEN_ALARMS
+        ));
+    }
+
+    #[test]
+    fn a_backfill_step_reads_at_most_one_batch() {
+        assert_eq!(backfill_span(99, 100), None);
+        assert_eq!(backfill_span(99, 90), Some((99, 90)));
+        assert_eq!(backfill_span(5000, 0), Some((5000, 5000 - MAX_BATCH + 1)));
+    }
+
+    #[test]
+    fn the_genesis_block_always_connects() {
+        assert!(connects(0, &[0; 32], None));
+    }
+
+    #[test]
+    fn a_run_connects_when_the_view_holds_its_parent() {
+        assert!(connects(10, &[9; 32], Some(block(9, 8))));
+    }
+
+    #[test]
+    fn a_run_with_no_parent_in_the_view_does_not_connect() {
+        assert!(!connects(10, &[9; 32], None));
+    }
+
+    #[test]
+    fn a_run_after_a_reorg_of_its_parent_does_not_connect() {
+        assert!(!connects(10, &[9; 32], Some(block(99, 98))));
+    }
+}
diff --git a/sol-drivechain-bmm/src/push.rs b/sol-drivechain-bmm/src/push.rs
new file mode 100644
index 0000000..6e87faa
--- /dev/null
+++ b/sol-drivechain-bmm/src/push.rs
@@ -0,0 +1,587 @@
+//! Shares the pairs with the staked validators. The push sends the pairs of
+//! this node to the RPC of each staked peer. The pull reads the pairs of each
+//! staked peer, so a node that no peer can reach still gets them, and it asks
+//! the peers which wanted banks they hold.
+
+use {
+    crate::{
+        pairs::{Pair, pairs},
+        peers::{MAX_REPLY_AGE, NodeId, known_banks_message, peers},
+        view,
+    },
+    serde_json::Value,
+    solana_pubkey::Pubkey,
+    std::{
+        io::{self, Read, Write},
+        net::{SocketAddr, TcpStream},
+        sync::{
+            Arc, Mutex,
+            atomic::{AtomicBool, AtomicU64, Ordering},
+        },
+        thread::JoinHandle,
+        time::{Duration, Instant},
+    },
+};
+
+/// The push and the pull name the pairs of this many eCash blocks below the
+/// tip.
+const PUSH_WINDOW: u64 = 144;
+
+/// A peer that was away gets the pairs again after this time.
+const REPEAT_INTERVAL: Duration = Duration::from_secs(15);
+
+/// The node reads the pairs of its peers this often.
+const PULL_INTERVAL: Duration = Duration::from_secs(5);
+
+const TICK: Duration = Duration::from_millis(500);
+
+/// One call to one peer takes at most this long in all.
+const CALL_DEADLINE: Duration = Duration::from_secs(3);
+
+/// The calls that run at the same time.
+const PARALLEL: usize = 16;
+
+const MAX_PUSH_REPLY: usize = 64 * 1024;
+const MAX_PULL_REPLY: usize = 4 * 1024 * 1024;
+
+/// The most pairs that the node takes from one pull.
+const MAX_PULLED_PAIRS: usize = 16 * 1024;
+
+/// A staked peer: its node identity and its RPC address.
+pub type Peer = (Pubkey, SocketAddr);
+
+/// Starts the thread that shares the pairs with the peers that
+/// `staked_peers` gives.
+pub fn start_pair_push(
+    staked_peers: impl Fn() -> Vec<Peer> + Send + 'static,
+    exit: Arc<AtomicBool>,
+) -> io::Result<JoinHandle<()>> {
+    std::thread::Builder::new()
+        .name("solBmmPairPush".to_owned())
+        .spawn(move || {
+            let mut sent = None;
+            let mut sent_at = Instant::now();
+            let mut pulled_at: Option<Instant> = None;
+            while !exit.load(Ordering::Relaxed) {
+                std::thread::sleep(TICK);
+                if let Err(error) = pairs().maintain(view()) {
+                    log::error!("cannot write the BMM pairs file: {error}");
+                }
+                let floor = view()
+                    .tip()
+                    .map(|(height, _)| height.saturating_sub(PUSH_WINDOW))
+                    .unwrap_or_default();
+                let generations = (pairs().generation(), view().generation());
+                let push = sent != Some(generations) || sent_at.elapsed() >= REPEAT_INTERVAL;
+                let pull = pulled_at.is_none_or(|at| at.elapsed() >= PULL_INTERVAL);
+                if !push && !pull {
+                    continue;
+                }
+                let targets = staked_peers();
+                peers().retain_nodes(&targets.iter().map(|(node, _)| node.to_bytes()).collect());
+                if push {
+                    let recent = pairs().from_height(floor);
+                    if !recent.is_empty() {
+                        let body = request_body(&recent);
+                        for_each_peer(&targets, |(_, address)| {
+                            if let Err(error) = call(*address, &body, MAX_PUSH_REPLY) {
+                                log::debug!("cannot send the BMM pairs to {address}: {error}");
+                            }
+                        });
+                    }
+                    sent = Some(generations);
+                    sent_at = Instant::now();
+                }
+                if pull {
+                    let wanted = peers().wanted();
+                    for_each_peer(&targets, |peer| pull_from(peer, floor, &wanted));
+                    pulled_at = Some(Instant::now());
+                }
+            }
+        })
+}
+
+/// Runs `job` for each peer, `PARALLEL` at a time.
+fn for_each_peer(targets: &[Peer], job: impl Fn(&Peer) + Sync) {
+    let queue = Mutex::new(targets.iter());
+    std::thread::scope(|scope| {
+        for _ in 0..PARALLEL.min(targets.len()) {
+            scope.spawn(|| {
+                loop {
+                    let Some(peer) = queue.lock().unwrap().next() else {
+                        return;
+                    };
+                    job(peer);
+                }
+            });
+        }
+    });
+}
+
+fn pull_from((node, address): &Peer, floor: u64, wanted: &[[u8; 32]]) {
+    match call(*address, &get_pairs_body(floor), MAX_PULL_REPLY)
+        .and_then(|reply| parse_pairs(&reply))
+    {
+        Ok(pulled) => {
+            for (height, pair) in pulled {
+                if let Err(error) = pairs().publish(height, pair, view()) {
+                    log::warn!("cannot store a BMM pair from {node}: {error}");
+                }
+            }
+        }
+        Err(error) => log::debug!("cannot read the BMM pairs of {node} at {address}: {error}"),
+    }
+    if wanted.is_empty() {
+        return;
+    }
+    let nonce = fresh_nonce();
+    match call(*address, &known_banks_body(wanted, &nonce), MAX_PUSH_REPLY)
+        .and_then(|reply| parse_known_banks(&reply, &node.to_bytes(), wanted, &nonce, unix_now()?))
+    {
+        Ok(known) => {
+            let mut held = 0usize;
+            for (bank_hash, slot) in wanted.iter().zip(known) {
+                if let Some(slot) = slot {
+                    peers().attest(bank_hash, node.to_bytes(), slot);
+                    held = held.saturating_add(1);
+                } else {
+                    peers().withdraw(bank_hash, &node.to_bytes());
+                }
+            }
+            if held > 0 {
+                log::info!("{node} holds {held} of {} wanted BMM banks", wanted.len());
+            }
+        }
+        Err(error) => log::info!("cannot ask {node} at {address} for BMM banks: {error}"),
+    }
+}
+
+/// The JSON-RPC request `bmmPublishPairs` with each pair as
+/// `[height, block, payee]` in base58.
+pub fn request_body(recent: &[(u64, Pair)]) -> String {
+    let list: Vec<String> = recent
+        .iter()
+        .map(|(height, pair)| {
+            format!(
+                "[{height},\"{}\",\"{}\"]",
+                Pubkey::new_from_array(pair.block),
+                Pubkey::new_from_array(pair.payee)
+            )
+        })
+        .collect();
+    format!(
+        "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"bmmPublishPairs\",\"params\":[[{}]]}}",
+        list.join(",")
+    )
+}
+
+fn get_pairs_body(floor: u64) -> String {
+    format!("{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"bmmGetPairs\",\"params\":[{floor}]}}")
+}
+
+fn known_banks_body(wanted: &[[u8; 32]], nonce: &[u8; 32]) -> String {
+    let list: Vec<String> = wanted
+        .iter()
+        .map(|bank_hash| format!("\"{}\"", Pubkey::new_from_array(*bank_hash)))
+        .collect();
+    format!(
+        "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"bmmKnownBanks\",\"params\":[[{}],\"{}\"]}}",
+        list.join(","),
+        Pubkey::new_from_array(*nonce)
+    )
+}
+
+/// A nonce that no earlier question of this process used.
+fn fresh_nonce() -> [u8; 32] {
+    static COUNTER: AtomicU64 = AtomicU64::new(0);
+    let count = COUNTER.fetch_add(1, Ordering::Relaxed);
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|since| since.as_nanos())
+        .unwrap_or_default();
+    solana_sha256_hasher::hashv(&[
+        &nanos.to_le_bytes(),
+        &count.to_le_bytes(),
+        &std::process::id().to_le_bytes(),
+    ])
+    .to_bytes()
+}
+
+fn unix_now() -> io::Result<u64> {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|since| since.as_secs())
+        .map_err(|_| invalid("the clock is before 1970"))
+}
+
+fn invalid(what: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, what.to_owned())
+}
+
+fn result_of(reply: &[u8]) -> io::Result<Value> {
+    let mut value: Value = serde_json::from_slice(reply).map_err(|_| invalid("bad JSON"))?;
+    value
+        .get_mut("result")
+        .map(Value::take)
+        .ok_or_else(|| invalid("no result"))
+}
+
+fn base58_32(value: &Value) -> Option<[u8; 32]> {
+    crate::decode_base58(value.as_str()?)
+}
+
+/// The pairs of a `bmmGetPairs` reply.
+fn parse_pairs(reply: &[u8]) -> io::Result<Vec<(u64, Pair)>> {
+    let result = result_of(reply)?;
+    let list = result.as_array().ok_or_else(|| invalid("no list"))?;
+    list.iter()
+        .take(MAX_PULLED_PAIRS)
+        .map(|entry| {
+            let [height, block, payee] = entry.as_array().map(Vec::as_slice).unwrap_or(&[]) else {
+                return Err(invalid("bad pair"));
+            };
+            Ok((
+                height.as_u64().ok_or_else(|| invalid("bad height"))?,
+                Pair {
+                    block: base58_32(block).ok_or_else(|| invalid("bad block"))?,
+                    payee: base58_32(payee).ok_or_else(|| invalid("bad payee"))?,
+                },
+            ))
+        })
+        .collect()
+}
+
+/// The slots of a `bmmKnownBanks` reply, one per asked bank. The reply must
+/// carry a signature of `node` over the asked banks, the slots, `nonce`, and
+/// a time within `MAX_REPLY_AGE` seconds of `now`.
+fn parse_known_banks(
+    reply: &[u8],
+    node: &NodeId,
+    asked: &[[u8; 32]],
+    nonce: &[u8; 32],
+    now: u64,
+) -> io::Result<Vec<Option<u64>>> {
+    let result = result_of(reply)?;
+    let [slots, timestamp, signature] = result.as_array().map(Vec::as_slice).unwrap_or(&[]) else {
+        return Err(invalid("no signed reply"));
+    };
+    let list = slots.as_array().ok_or_else(|| invalid("no list"))?;
+    if list.len() != asked.len() {
+        return Err(invalid("wrong length"));
+    }
+    let slots = list
+        .iter()
+        .map(|slot| match slot {
+            Value::Null => Ok(None),
+            slot => slot.as_u64().map(Some).ok_or_else(|| invalid("bad slot")),
+        })
+        .collect::<io::Result<Vec<_>>>()?;
+    let timestamp = timestamp.as_u64().ok_or_else(|| invalid("bad time"))?;
+    if timestamp.abs_diff(now) > MAX_REPLY_AGE {
+        return Err(invalid("the reply is too old"));
+    }
+    let signature: [u8; 64] = signature
+        .as_str()
+        .and_then(crate::decode_base58::<64>)
+        .ok_or_else(|| invalid("bad signature"))?;
+    let message = known_banks_message(node, asked, &slots, nonce, timestamp);
+    if !solana_signature::Signature::from(signature).verify(node, &message) {
+        return Err(invalid("the signature does not match the node"));
+    }
+    Ok(slots)
+}
+
+fn remaining(deadline: Instant) -> io::Result<Duration> {
+    deadline
+        .checked_duration_since(Instant::now())
+        .filter(|left| !left.is_zero())
+        .ok_or_else(|| io::Error::new(io::ErrorKind::TimedOut, "the call took too long"))
+}
+
+/// Posts `body` and gives the body of the reply. The whole call ends at
+/// `CALL_DEADLINE`, and a reply above `max_reply` bytes stops it.
+fn call(peer: SocketAddr, body: &str, max_reply: usize) -> io::Result<Vec<u8>> {
+    let deadline = Instant::now()
+        .checked_add(CALL_DEADLINE)
+        .ok_or_else(|| invalid("no deadline"))?;
+    let mut stream = TcpStream::connect_timeout(&peer, CALL_DEADLINE)?;
+    stream.set_write_timeout(Some(remaining(deadline)?))?;
+    let request = format!(
+        "POST / HTTP/1.1\r\nHost: {peer}\r\nContent-Type: application/json\r\nContent-Length: \
+         {}\r\nConnection: close\r\n\r\n{body}",
+        body.len()
+    );
+    stream.write_all(request.as_bytes())?;
+    let mut reply = Vec::new();
+    let mut chunk = [0u8; 8192];
+    loop {
+        stream.set_read_timeout(Some(remaining(deadline)?))?;
+        let read = stream.read(&mut chunk)?;
+        if read == 0 {
+            break;
+        }
+        reply.extend_from_slice(&chunk[..read]);
+        if reply.len() > max_reply {
+            return Err(invalid("the reply is too large"));
+        }
+    }
+    http_body(&reply)
+}
+
+/// The body of an HTTP 200 reply, with a chunked body decoded.
+fn http_body(reply: &[u8]) -> io::Result<Vec<u8>> {
+    let split = reply
+        .windows(4)
+        .position(|window| window == b"\r\n\r\n")
+        .ok_or_else(|| invalid("no header end"))?;
+    let head = std::str::from_utf8(&reply[..split]).map_err(|_| invalid("bad header"))?;
+    let body = &reply[split.saturating_add(4)..];
+    let mut lines = head.split("\r\n");
+    let status = lines.next().unwrap_or_default();
+    if status.split_whitespace().nth(1) != Some("200") {
+        return Err(invalid("not 200"));
+    }
+    let chunked = lines.any(|line| {
+        let line = line.to_ascii_lowercase();
+        line.starts_with("transfer-encoding:") && line.contains("chunked")
+    });
+    if !chunked {
+        return Ok(body.to_vec());
+    }
+    let mut decoded = Vec::new();
+    let mut rest = body;
+    loop {
+        let end = rest
+            .windows(2)
+            .position(|window| window == b"\r\n")
+            .ok_or_else(|| invalid("bad chunk"))?;
+        let size_text = std::str::from_utf8(&rest[..end]).map_err(|_| invalid("bad chunk"))?;
+        let size = usize::from_str_radix(size_text.split(';').next().unwrap_or("").trim(), 16)
+            .map_err(|_| invalid("bad chunk size"))?;
+        rest = &rest[end.saturating_add(2)..];
+        if size == 0 {
+            return Ok(decoded);
+        }
+        let data = rest.get(..size).ok_or_else(|| invalid("short chunk"))?;
+        decoded.extend_from_slice(data);
+        rest = rest
+            .get(size.saturating_add(2)..)
+            .ok_or_else(|| invalid("short chunk"))?;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use {
+        super::*,
+        std::net::{Shutdown, TcpListener},
+    };
+
+    #[test]
+    fn the_request_lists_each_pair_in_base58() {
+        let pair = Pair {
+            block: [1; 32],
+            payee: [2; 32],
+        };
+        let body = request_body(&[(105, pair)]);
+        assert_eq!(
+            body,
+            format!(
+                r#"{{"jsonrpc":"2.0","id":1,"method":"bmmPublishPairs","params":[[[105,"{}","{}"]]]}}"#,
+                Pubkey::new_from_array([1; 32]),
+                Pubkey::new_from_array([2; 32])
+            )
+        );
+    }
+
+    /// A server that answers each connection with `reply`, after `delay`
+    /// between each byte when `trickle` is set.
+    fn serve(reply: Vec<u8>, trickle: Option<Duration>) -> SocketAddr {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(mut stream) = stream else { return };
+                let reply = reply.clone();
+                std::thread::spawn(move || {
+                    let mut request = Vec::new();
+                    let mut chunk = [0u8; 4096];
+                    while !request.ends_with(b"\r\n\r\n{}") {
+                        match stream.read(&mut chunk) {
+                            Ok(0) | Err(_) => break,
+                            Ok(read) => request.extend_from_slice(&chunk[..read]),
+                        }
+                    }
+                    match trickle {
+                        Some(delay) => {
+                            for byte in reply {
+                                if stream.write_all(&[byte]).is_err() {
+                                    return;
+                                }
+                                std::thread::sleep(delay);
+                            }
+                        }
+                        None => {
+                            let _ = stream.write_all(&reply);
+                        }
+                    }
+                    let _ = stream.shutdown(Shutdown::Both);
+                });
+            }
+        });
+        address
+    }
+
+    fn ok(body: &str) -> Vec<u8> {
+        format!(
+            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n{body}",
+            body.len()
+        )
+        .into_bytes()
+    }
+
+    #[test]
+    fn a_reply_gives_its_body() {
+        let address = serve(ok(r#"{"result":[]}"#), None);
+        assert_eq!(call(address, "{}", 1024).unwrap(), br#"{"result":[]}"#);
+    }
+
+    #[test]
+    fn a_large_reply_stops_the_call() {
+        let mut reply = ok("").to_vec();
+        reply.extend(std::iter::repeat_n(b'x', 1024 * 1024));
+        let address = serve(reply, None);
+        assert!(call(address, "{}", 1024).is_err());
+    }
+
+    #[test]
+    fn a_slow_reply_stops_the_call_at_the_deadline() {
+        let reply = ok(&"x".repeat(10_000));
+        let address = serve(reply, Some(Duration::from_millis(100)));
+        let start = Instant::now();
+        assert!(call(address, "{}", 1024 * 1024).is_err());
+        assert!(start.elapsed() < CALL_DEADLINE + Duration::from_secs(1));
+    }
+
+    #[test]
+    fn one_slow_peer_does_not_stop_the_others() {
+        let slow = serve(ok(&"x".repeat(10_000)), Some(Duration::from_millis(100)));
+        let fast = serve(ok(r#"{"result":[]}"#), None);
+        let mut targets = vec![(Pubkey::new_from_array([7; 32]), slow); PARALLEL];
+        targets.push((Pubkey::new_from_array([7; 32]), fast));
+        let fast_done = Mutex::new(None);
+        let start = Instant::now();
+        for_each_peer(&targets, |(_, address)| {
+            if *address == fast && call(*address, "{}", 1024).is_ok() {
+                *fast_done.lock().unwrap() = Some(start.elapsed());
+            } else {
+                let _ = call(*address, "{}", 1024 * 1024);
+            }
+        });
+        assert!(start.elapsed() < CALL_DEADLINE * 2 + Duration::from_secs(1));
+        assert!(fast_done.lock().unwrap().is_some());
+    }
+
+    #[test]
+    fn a_chunked_body_is_decoded() {
+        let reply = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n";
+        assert_eq!(http_body(reply).unwrap(), b"abcde");
+        assert!(http_body(b"HTTP/1.1 500 Oops\r\n\r\n").is_err());
+    }
+
+    #[test]
+    fn a_pull_reply_gives_the_pairs() {
+        let block = Pubkey::new_from_array([1; 32]);
+        let payee = Pubkey::new_from_array([2; 32]);
+        let reply = format!(r#"{{"jsonrpc":"2.0","result":[[105,"{block}","{payee}"]],"id":1}}"#);
+        assert_eq!(
+            parse_pairs(reply.as_bytes()).unwrap(),
+            vec![(
+                105,
+                Pair {
+                    block: [1; 32],
+                    payee: [2; 32]
+                }
+            )]
+        );
+        assert!(parse_pairs(br#"{"result":[[105,"x","y"]]}"#).is_err());
+    }
+
+    fn signed_reply(
+        keypair: &solana_keypair::Keypair,
+        asked: &[[u8; 32]],
+        slots: &[Option<u64>],
+        nonce: &[u8; 32],
+        timestamp: u64,
+    ) -> Vec<u8> {
+        use solana_signer::Signer;
+        let node = keypair.pubkey().to_bytes();
+        let signature =
+            keypair.sign_message(&known_banks_message(&node, asked, slots, nonce, timestamp));
+        let slots: Vec<String> = slots
+            .iter()
+            .map(|slot| slot.map_or("null".to_owned(), |slot| slot.to_string()))
+            .collect();
+        format!(
+            r#"{{"result":[[{}],{timestamp},"{signature}"]}}"#,
+            slots.join(",")
+        )
+        .into_bytes()
+    }
+
+    #[test]
+    fn a_signed_known_banks_reply_gives_one_slot_per_bank() {
+        use solana_signer::Signer;
+        let keypair = solana_keypair::Keypair::new();
+        let node = keypair.pubkey().to_bytes();
+        let asked = [[1; 32], [2; 32]];
+        let reply = signed_reply(&keypair, &asked, &[Some(7), None], &[5; 32], 1_000);
+        assert_eq!(
+            parse_known_banks(&reply, &node, &asked, &[5; 32], 1_010).unwrap(),
+            vec![Some(7), None]
+        );
+    }
+
+    #[test]
+    fn a_forged_known_banks_reply_is_refused() {
+        use solana_signer::Signer;
+        let node = solana_keypair::Keypair::new().pubkey().to_bytes();
+        let forger = solana_keypair::Keypair::new();
+        let asked = [[1; 32]];
+        let reply = signed_reply(&forger, &asked, &[Some(7)], &[5; 32], 1_000);
+        assert!(parse_known_banks(&reply, &node, &asked, &[5; 32], 1_000).is_err());
+        assert!(parse_known_banks(br#"{"result":[7]}"#, &node, &asked, &[5; 32], 1_000).is_err());
+    }
+
+    #[test]
+    fn a_reply_with_a_huge_field_fails_fast() {
+        let huge = "z".repeat(3_000_000);
+        let reply = format!(r#"{{"result":[[105,"{huge}","{huge}"]]}}"#);
+        let start = Instant::now();
+        assert!(parse_pairs(reply.as_bytes()).is_err());
+        let signed = format!(r#"{{"result":[[7],1000,"{huge}"]}}"#);
+        assert!(
+            parse_known_banks(signed.as_bytes(), &[1; 32], &[[1; 32]], &[5; 32], 1_000).is_err()
+        );
+        assert!(start.elapsed() < Duration::from_secs(2));
+    }
+
+    #[test]
+    fn an_old_known_banks_reply_is_refused() {
+        use solana_signer::Signer;
+        let keypair = solana_keypair::Keypair::new();
+        let node = keypair.pubkey().to_bytes();
+        let asked = [[1; 32]];
+        let reply = signed_reply(&keypair, &asked, &[Some(7)], &[5; 32], 1_000);
+        assert!(parse_known_banks(&reply, &node, &asked, &[6; 32], 1_000).is_err());
+        assert!(
+            parse_known_banks(&reply, &node, &asked, &[5; 32], 1_000 + MAX_REPLY_AGE + 1).is_err()
+        );
+        assert!(parse_known_banks(&reply, &node, &[[2; 32]], &[5; 32], 1_000).is_err());
+    }
+
+    #[test]
+    fn each_question_takes_a_new_nonce() {
+        assert_ne!(fresh_nonce(), fresh_nonce());
+    }
+}
