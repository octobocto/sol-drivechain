+//! A small gRPC client for the enforcer `ValidatorService`. It holds only the
+//! messages that the BMM view reads, so Agave needs no proto build step.
+
+use {
+    crate::{BlockHash, Commitment},
+    tonic::{codegen::http::uri::PathAndQuery, transport::Channel},
+    tonic_prost::ProstCodec,
+};
+
+#[derive(Debug, thiserror::Error)]
+pub enum EnforcerError {
+    #[error("cannot connect to the enforcer at {url}: {source}")]
+    Connect {
+        url: String,
+        source: tonic::transport::Error,
+    },
+    #[error("the enforcer URL {0} is not valid")]
+    BadUrl(String),
+    #[error("the enforcer call {call} failed: {source}")]
+    Call {
+        call: &'static str,
+        source: tonic::Status,
+    },
+    #[error("the enforcer reply to {call} has no {field}")]
+    MissingField {
+        call: &'static str,
+        field: &'static str,
+    },
+    #[error("the enforcer does not know block {0}")]
+    BlockNotFound(String),
+    #[error("the enforcer gave an h* that is not 32 bytes of hex: {0}")]
+    BadCommitment(String),
+    #[error("the enforcer gave a block hash that is not 32 bytes of hex: {0}")]
+    BadBlockHash(String),
+}
+
+/// google.protobuf.StringValue
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct StringValue {
+    #[prost(string, tag = "1")]
+    pub value: String,
+}
+
+/// google.protobuf.UInt32Value
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct UInt32Value {
+    #[prost(uint32, tag = "1")]
+    pub value: u32,
+}
+
+/// cusf.common.v1.ReverseHex and cusf.common.v1.ConsensusHex share this shape.
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct HexValue {
+    #[prost(message, optional, tag = "1")]
+    pub hex: Option<StringValue>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetChainTipRequest {}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct BlockHeaderInfo {
+    #[prost(message, optional, tag = "1")]
+    pub block_hash: Option<HexValue>,
+    #[prost(message, optional, tag = "2")]
+    pub prev_block_hash: Option<HexValue>,
+    #[prost(uint32, tag = "3")]
+    pub height: u32,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetChainTipResponse {
+    #[prost(message, optional, tag = "1")]
+    pub block_header_info: Option<BlockHeaderInfo>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetBlockHeaderInfoRequest {
+    #[prost(message, optional, tag = "1")]
+    pub block_hash: Option<HexValue>,
+    #[prost(uint32, optional, tag = "2")]
+    pub max_ancestors: Option<u32>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetBlockHeaderInfoResponse {
+    #[prost(message, repeated, tag = "1")]
+    pub header_infos: Vec<BlockHeaderInfo>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetBmmHStarCommitmentRequest {
+    #[prost(message, optional, tag = "1")]
+    pub block_hash: Option<HexValue>,
+    #[prost(message, optional, tag = "2")]
+    pub sidechain_id: Option<UInt32Value>,
+    #[prost(uint32, optional, tag = "3")]
+    pub max_ancestors: Option<u32>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct OptionalCommitment {
+    #[prost(message, optional, tag = "1")]
+    pub commitment: Option<HexValue>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct CommitmentReply {
+    #[prost(message, optional, tag = "1")]
+    pub commitment: Option<HexValue>,
+    /// Newest first.
+    #[prost(message, repeated, tag = "2")]
+    pub ancestor_commitments: Vec<OptionalCommitment>,
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct BlockNotFoundError {
+    #[prost(message, optional, tag = "1")]
+    pub block_hash: Option<HexValue>,
+}
+
+#[derive(Clone, PartialEq, prost::Oneof)]
+pub enum CommitmentResult {
+    #[prost(message, tag = "1")]
+    BlockNotFound(BlockNotFoundError),
+    #[prost(message, tag = "2")]
+    Commitment(CommitmentReply),
+}
+
+#[derive(Clone, PartialEq, prost::Message)]
+pub struct GetBmmHStarCommitmentResponse {
+    #[prost(oneof = "CommitmentResult", tags = "1, 2")]
+    pub result: Option<CommitmentResult>,
+}
+
+/// An eCash block, named by its hash in the reversed hex of the enforcer.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Header {
+    pub hash: String,
+    pub prev_hash: String,
+    pub height: u64,
+}
+
+/// Reads the reversed hex of the enforcer into the internal byte order.
+pub fn decode_block_hash(text: &str) -> Result<BlockHash, EnforcerError> {
+    let mut bytes = hex::decode(text).map_err(|_| EnforcerError::BadBlockHash(text.to_owned()))?;
+    bytes.reverse();
+    bytes
+        .try_into()
+        .map_err(|_| EnforcerError::BadBlockHash(text.to_owned()))
+}
+
+pub struct Enforcer {
+    grpc: tonic::client::Grpc<Channel>,
+}
+
+impl Enforcer {
+    pub async fn connect(url: &str) -> Result<Self, EnforcerError> {
+        let endpoint = Channel::from_shared(url.to_owned())
+            .map_err(|_| EnforcerError::BadUrl(url.to_owned()))?;
+        let channel = endpoint
+            .connect()
+            .await
+            .map_err(|source| EnforcerError::Connect {
+                url: url.to_owned(),
+                source,
+            })?;
+        Ok(Self {
+            grpc: tonic::client::Grpc::new(channel),
+        })
+    }
+
+    async fn unary<Request, Response>(
+        &mut self,
+        call: &'static str,
+        path: &'static str,
+        request: Request,
+    ) -> Result<Response, EnforcerError>
+    where
+        Request: prost::Message + Send + Sync + 'static,
+        Response: prost::Message + Default + Send + Sync + 'static,
+    {
+        self.grpc
+            .ready()
+            .await
+            .map_err(|source| EnforcerError::Call {
+                call,
+                source: tonic::Status::unavailable(source.to_string()),
+            })?;
+        self.grpc
+            .unary(
+                tonic::Request::new(request),
+                PathAndQuery::from_static(path),
+                ProstCodec::<Request, Response>::default(),
+            )
+            .await
+            .map(tonic::Response::into_inner)
+            .map_err(|source| EnforcerError::Call { call, source })
+    }
+
+    pub async fn chain_tip(&mut self) -> Result<Header, EnforcerError> {
+        let response: GetChainTipResponse = self
+            .unary(
+                "GetChainTip",
+                "/cusf.mainchain.v1.ValidatorService/GetChainTip",
+                GetChainTipRequest {},
+            )
+            .await?;
+        let info = response
+            .block_header_info
+            .ok_or(EnforcerError::MissingField {
+                call: "GetChainTip",
+                field: "block_header_info",
+            })?;
+        header(info, "GetChainTip")
+    }
+
+    /// The header of `block_hash` and up to `max_ancestors` of its ancestors.
+    pub async fn headers(
+        &mut self,
+        block_hash: &str,
+        max_ancestors: u32,
+    ) -> Result<Vec<Header>, EnforcerError> {
+        let response: GetBlockHeaderInfoResponse = self
+            .unary(
+                "GetBlockHeaderInfo",
+                "/cusf.mainchain.v1.ValidatorService/GetBlockHeaderInfo",
+                GetBlockHeaderInfoRequest {
+                    block_hash: Some(hex_value(block_hash)),
+                    max_ancestors: Some(max_ancestors),
+                },
+            )
+            .await?;
+        response
+            .header_infos
+            .into_iter()
+            .map(|info| header(info, "GetBlockHeaderInfo"))
+            .collect()
+    }
+
+    /// The h* of `block_hash` for the sidechain, then the h* of up to
+    /// `max_ancestors` ancestors, newest first.
+    pub async fn commitments(
+        &mut self,
+        block_hash: &str,
+        sidechain_slot: u8,
+        max_ancestors: u32,
+    ) -> Result<Vec<Option<Commitment>>, EnforcerError> {
+        let response: GetBmmHStarCommitmentResponse = self
+            .unary(
+                "GetBmmHStarCommitment",
+                "/cusf.mainchain.v1.ValidatorService/GetBmmHStarCommitment",
+                GetBmmHStarCommitmentRequest {
+                    block_hash: Some(hex_value(block_hash)),
+                    sidechain_id: Some(UInt32Value {
+                        value: u32::from(sidechain_slot),
+                    }),
+                    max_ancestors: Some(max_ancestors),
+                },
+            )
+            .await?;
+        match response.result {
+            Some(CommitmentResult::Commitment(found)) => {
+                let mut commitments =
+                    Vec::with_capacity(found.ancestor_commitments.len().saturating_add(1));
+                commitments.push(decode_commitment(found.commitment)?);
+                for ancestor in found.ancestor_commitments {
+                    commitments.push(decode_commitment(ancestor.commitment)?);
+                }
+                Ok(commitments)
+            }
+            Some(CommitmentResult::BlockNotFound(_)) => {
+                Err(EnforcerError::BlockNotFound(block_hash.to_owned()))
+            }
+            None => Err(EnforcerError::MissingField {
+                call: "GetBmmHStarCommitment",
+                field: "result",
+            }),
+        }
+    }
+}
+
+fn hex_value(text: &str) -> HexValue {
+    HexValue {
+        hex: Some(StringValue {
+            value: text.to_owned(),
+        }),
+    }
+}
+
+fn hex_text(value: Option<HexValue>) -> Option<String> {
+    value.and_then(|value| value.hex).map(|hex| hex.value)
+}
+
+fn header(info: BlockHeaderInfo, call: &'static str) -> Result<Header, EnforcerError> {
+    Ok(Header {
+        hash: hex_text(info.block_hash).ok_or(EnforcerError::MissingField {
+            call,
+            field: "block_hash",
+        })?,
+        prev_hash: hex_text(info.prev_block_hash).ok_or(EnforcerError::MissingField {
+            call,
+            field: "prev_block_hash",
+        })?,
+        height: u64::from(info.height),
+    })
+}
+
+/// Reads a ConsensusHex h*, which holds the bytes in the order of the coinbase.
+pub fn decode_commitment(value: Option<HexValue>) -> Result<Option<Commitment>, EnforcerError> {
+    let Some(text) = hex_text(value) else {
+        return Ok(None);
+    };
+    let bytes = hex::decode(&text).map_err(|_| EnforcerError::BadCommitment(text.clone()))?;
+    let commitment: Commitment = bytes
+        .try_into()
+        .map_err(|_| EnforcerError::BadCommitment(text))?;
+    Ok(Some(commitment))
+}
+
+#[cfg(test)]
+mod tests {
+    use {super::*, prost::Message as _};
+
+    #[test]
+    fn a_missing_commitment_reads_as_none() {
+        assert_eq!(decode_commitment(None).unwrap(), None);
+        assert_eq!(
+            decode_commitment(Some(HexValue { hex: None })).unwrap(),
+            None
+        );
+    }
+
+    #[test]
+    fn a_hex_commitment_keeps_its_byte_order() {
+        let mut expected = [0u8; 32];
+        expected[0] = 0xab;
+        expected[31] = 0x01;
+        let text = hex::encode(expected);
+        assert_eq!(
+            decode_commitment(Some(hex_value(&text))).unwrap(),
+            Some(expected)
+        );
+    }
+
+    #[test]
+    fn a_block_hash_reads_in_the_internal_byte_order() {
+        let mut text = "00".repeat(31);
+        text.push_str("ab");
+        let hash = decode_block_hash(&text).unwrap();
+        assert_eq!(hash[0], 0xab);
+        assert_eq!(hash[31], 0x00);
+        assert!(decode_block_hash("abcd").is_err());
+    }
+
+    #[test]
+    fn a_short_commitment_fails() {
+        assert!(decode_commitment(Some(hex_value("abcd"))).is_err());
+    }
+
+    #[test]
+    fn the_commitment_reply_decodes_from_the_wire() {
+        // Field numbers from cusf/mainchain/v1/validator.proto.
+        let reply = GetBmmHStarCommitmentResponse {
+            result: Some(CommitmentResult::Commitment(CommitmentReply {
+                commitment: Some(hex_value(&"11".repeat(32))),
+                ancestor_commitments: vec![
+                    OptionalCommitment { commitment: None },
+                    OptionalCommitment {
+                        commitment: Some(hex_value(&"22".repeat(32))),
+                    },
+                ],
+            })),
+        };
+        let bytes = reply.encode_to_vec();
+        let decoded = GetBmmHStarCommitmentResponse::decode(bytes.as_slice()).unwrap();
+        assert_eq!(decoded, reply);
+    }
+}
