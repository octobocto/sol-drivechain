	# The SOL drivechain JSON-RPC. The validator binds 127.0.0.1 only, so
	# this proxy is the one way to the RPC. The gossip ports stay open, so
	# any user can join the chain with a validator of its own.
	handle_path /sol/* {
		@sol_rpc method POST OPTIONS
		handle @sol_rpc {
			reverse_proxy 127.0.0.1:8899
		}
		respond "method not allowed" 405
	}
	# The websocket that a wallet subscribes on. Pass it as `wsEndpoint`,
	# because a path proxy breaks the address a wallet would guess.
	handle_path /sol-ws/* {
		reverse_proxy 127.0.0.1:8900
	}
	# The standing regtest chain of scripts/regtest-chain.sh. It carries no
	# value, and builders use it while betanet waits for the slot.
	handle_path /sol-regtest/* {
		@sol_regtest_rpc method POST OPTIONS
		handle @sol_regtest_rpc {
			reverse_proxy 127.0.0.1:8799
		}
		respond "method not allowed" 405
	}
	handle_path /sol-regtest-ws/* {
		reverse_proxy 127.0.0.1:8800
	}
