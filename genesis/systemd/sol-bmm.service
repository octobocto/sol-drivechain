[Unit]
Description=sol-drivechain BMM template server and settler
After=network-online.target sol-validator.service
Wants=network-online.target

[Service]
Type=simple
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
TemporaryFileSystem=/root/src/sol-drivechain/keys:ro
BindReadOnlyPaths=/root/src/sol-drivechain/keys/validator-identity.json /root/src/sol-drivechain/keys/bridge-program.pubkey
Environment=HOME=/root
Environment=PEG_NETWORK=ecash
Environment=PEG_SLOT=8
# No template offers more sats than this.
Environment=MAX_BID_SATS=100000
Environment=ENFORCER_URL=http://127.0.0.1:50051
Environment=SOLANA_RPC_URL=http://127.0.0.1:8899
WorkingDirectory=/root/src/sol-drivechain
ExecStart=/usr/bin/bash -c '/root/src/sol-drivechain/daemon/target/release/sol-drivechain-daemon bmm \
  --network "$PEG_NETWORK" \
  --enforcer-url "$ENFORCER_URL" \
  --solana-rpc-url "$SOLANA_RPC_URL" \
  --slot "$PEG_SLOT" \
  --program-id "$(cat /root/src/sol-drivechain/keys/bridge-program.pubkey)" \
  --identity /root/src/sol-drivechain/keys/validator-identity.json \
  --max-bid-sats "$MAX_BID_SATS" \
  --rpc-listen 127.0.0.1:6008 \
  --no-bid'
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
