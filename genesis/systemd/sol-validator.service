[Unit]
Description=sol-drivechain Solana validator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
ProtectSystem=strict
TemporaryFileSystem=/root:ro /home:ro /run/user:ro
ProtectKernelTunables=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# The RPC answers the world, so the validator sees only its own keys, and it
# writes only its ledger.
BindReadOnlyPaths=/root/src/sol-drivechain -/root/src/agave/target/release -/root/.local/share/solana/install
BindPaths=/root/src/sol-drivechain/genesis/ledger
TemporaryFileSystem=/root/src/sol-drivechain/keys:ro
BindReadOnlyPaths=/root/src/sol-drivechain/keys/validator-identity.json -/root/src/sol-drivechain/keys/validator-vote.json /root/src/sol-drivechain/keys/bridge-program.pubkey
Environment=HOME=/root
Environment=AGAVE_VALIDATOR=/root/src/agave/target/release/agave-validator
Environment=ENFORCER_URL=http://127.0.0.1:50051
Environment=SIDECHAIN_SLOT=8
# XDP needs network capabilities, and one validator gains nothing from it.
Environment=XDP=0
# NETWORK sets N, K, and L. eCash takes N = 6, K = 3, and L = 12.
Environment=NETWORK=ecash
# The address that a joiner reaches. A first validator cannot learn it, so it
# binds it.
Environment=BIND_ADDRESS=204.168.254.113
# A joiner reads the genesis and a snapshot from this RPC, and the peers
# send the BMM pairs to it.
Environment=RPC_BIND_ADDRESS=0.0.0.0
Environment=PATH=/root/.local/share/solana/install/active_release/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/src/sol-drivechain
ExecStart=/usr/bin/bash /root/src/sol-drivechain/genesis/run-validator.sh
# The validator opens many files at once.
LimitNOFILE=1000000
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
