[Unit]
Description=sol-drivechain BIP300 peg daemon
After=network-online.target sol-validator.service
Wants=network-online.target

[Service]
Type=simple
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
ProtectSystem=strict
TemporaryFileSystem=/root:ro /home:ro /run/user:ro
BindReadOnlyPaths=/root/src/sol-drivechain
ProtectKernelTunables=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Each peer is on this host, so no key leaves it.
IPAddressDeny=any
IPAddressAllow=localhost
# The bundle file lands beside the oracle key by a rename, so the directory
# stays writable, and the other keys disappear.
BindPaths=/root/src/sol-drivechain/keys
InaccessiblePaths=-/root/src/sol-drivechain/keys/validator-identity.json -/root/src/sol-drivechain/keys/validator-vote.json -/root/src/sol-drivechain/keys/validator-stake.json -/root/src/sol-drivechain/keys/faucet.json -/root/src/sol-drivechain/keys/user.json -/root/src/sol-drivechain/keys/mnemonic.txt
Environment=HOME=/root
Environment=PEG_NETWORK=ecash
Environment=PEG_SLOT=8
Environment=ENFORCER_URL=http://127.0.0.1:50051
Environment=SOLANA_RPC_URL=http://127.0.0.1:8899
WorkingDirectory=/root/src/sol-drivechain
ExecStart=/usr/bin/bash -c '/root/src/sol-drivechain/daemon/target/release/sol-drivechain-daemon run \
  --network "$PEG_NETWORK" \
  --enforcer-url "$ENFORCER_URL" \
  --solana-rpc-url "$SOLANA_RPC_URL" \
  --slot "$PEG_SLOT" \
  --program-id "$(cat /root/src/sol-drivechain/keys/bridge-program.pubkey)" \
  --oracle /root/src/sol-drivechain/keys/oracle.json'
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
